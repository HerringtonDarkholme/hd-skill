use std.cli.{Args, Cli, ScriptedArgs}
use std.console.{Console, ConsoleInput, MemoryConsole, ScriptedInput, eprintln, read_all}
use std.process.ExitCode
use pkg.sum.{summarize}

## Sum one CSV column from standard input, grouped by another column
@derive(Cli)
struct Options:
    ## the 1-based column to group by
    key: usize = 1
    ## the 1-based column to sum
    value: usize = 2
    ## ignore the first line
    skip_header: bool

pub fn main!() -> ExitCode $ Args + Console + ConsoleInput:
    options := match Options::parse_args():
        .Ok(options) => options
        .Err(error) => return error.exit() # usage error: status 2; --help: status 0
    text := match read_all!():
        .Ok(text) => text
        .Err(error) =>
            eprintln("colsum: cannot read input: $error")
            return ExitCode(1)
    rows := match summarize(text, options.key, options.value, options.skip_header):
        .Ok(rows) => rows
        .Err(error) =>
            eprintln("colsum: $error")
            return ExitCode(1)
    for (key, total) in rows:
        println("$key,$total")
    ExitCode(0)

tests:
    it("prints the totals grouped by the first column"):
        input := ScriptedInput::new(["name,amount", "ada,3", "grace,4", "ada,2"])
        arguments := box(ScriptedArgs::new("colsum", ["--skip-header"]))
        console := MemoryConsole::new()
        $.with(Args=arguments, ConsoleInput=input, Console=console):
            assert_equal(main!(), ExitCode(0))
        assert_equal(console.output().join(""), "ada,5\ngrace,4\n")
        assert_equal(console.error_output().join(""), "")

    it("chooses the columns with --key and --value"):
        input := ScriptedInput::new(["7,x,-2", "8,x,5"])
        arguments := box(ScriptedArgs::new("colsum", ["--key", "2", "--value", "3"]))
        console := MemoryConsole::new()
        $.with(Args=arguments, ConsoleInput=input, Console=console):
            assert_equal(main!(), ExitCode(0))
        assert_equal(console.output().join(""), "x,3\n")

    it("reports a bad line on standard error and prints nothing else"):
        input := ScriptedInput::new(["a,1", "b"])
        arguments := box(ScriptedArgs::new("colsum", []))
        console := MemoryConsole::new()
        $.with(Args=arguments, ConsoleInput=input, Console=console):
            assert_equal(main!(), ExitCode(1))
        assert_equal(console.output().join(""), "")
        assert_equal(console.error_output().join(""), "colsum: line 2: missing column\n")
