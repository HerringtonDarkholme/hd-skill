use std.testing.{Choices, commands}

## A least-recently-used cache from string keys to i64 values.
##
## `values` holds the entries; `order` holds the same keys, least recently
## used first. Every operation scans `order`, so it costs O(capacity).
pub struct Lru:
    capacity: usize
    values: Map[string, i64]
    order: List[string]

## An empty cache that holds at most `capacity` entries.
pub fn new_lru(capacity: usize) -> Lru:
    Lru { capacity, values: {}, order: [] }

impl Lru:
    ## The value for `key`, or `.None`. A hit makes `key` most recently used;
    ## a miss changes nothing.
    pub fn get(&mut self, key: string) -> i64?:
        value := self.values.get(key)?
        self.promote(key)
        .Some(value)

    ## Inserts or updates `key`, makes it most recently used, then evicts the
    ## least recently used entries while the cache is over capacity.
    pub fn put(&mut self, key: string, value: i64) -> void:
        _ := self.values.insert(key, value)
        self.promote(key)
        while self.order.len() > self.capacity:
            oldest := self.order.remove(0)
            _ := self.values.remove(oldest)

    ## The number of entries.
    pub fn len(self) -> usize:
        self.order.len()

    # Moves `key` to the most recently used end of `order`.
    fn promote(&mut self, key: string) -> void:
        self.order.retain(fn(k): k != key)
        self.order.push(key)

# The model: entries as a plain list, least recently used first.
@derive(Debug)
struct Model:
    capacity: usize
    entries: List[(string, i64)]

@derive(Debug)
enum Cmd:
    Get(key: string)
    Put(key: string, value: i64)

fn lookup(model: &Model, key: string) -> i64?:
    for (k, v) in model.entries:
        if k == key:
            return .Some(v)
    .None

# `entries` without `key`, with `key` appended as the most recent entry.
fn moved_to_end(entries: List[(string, i64)], key: string, value: i64) -> List[(string, i64)]:
    let mut next: List[(string, i64)] = []
    for (k, v) in entries:
        if k != key:
            next.push((k, v))
    next.push((key, value))
    next

# Drops the least recent entries until at most `capacity` remain.
fn evict(entries: List[(string, i64)], capacity: usize) -> List[(string, i64)]:
    let mut kept = entries
    while kept.len() > capacity:
        _ := kept.remove(0)
    kept

fn advance_cmd(model: &Model, cmd: &Cmd) -> Model:
    match cmd:
        .Get(key) =>
            match lookup(model, key):
                .Some(value) =>
                    Model {
                        capacity: model.capacity,
                        entries: moved_to_end(model.entries, key, value),
                    }
                .None => Model { capacity: model.capacity, entries: model.entries }
        .Put(key, value) =>
            kept := moved_to_end(model.entries, key, value)
            Model { capacity: model.capacity, entries: evict(kept, model.capacity) }

fn next_cmd(c: &mut Choices, _model: &Model) -> Cmd?:
    let i: usize = c.int(0..=3)
    key := ["a", "b", "c", "d"][i]
    let value: i64 = c.int(-5..=20)
    if c.bool(): .Some(.Get(key)) else: .Some(.Put(key, value))

fn history(c: &mut Choices) -> (usize, List[Cmd]):
    let capacity: usize = c.int(0..=4)
    start := Model { capacity, entries: [] }
    (capacity, commands(c, max=30, initial=start, next=next_cmd, advance=advance_cmd))

tests:
    use std.testing.{it_each, it_prop_with}

    fn puts_then_len(capacity: usize, puts: usize) -> usize:
        let mut cache = new_lru(capacity)
        for i in 0..puts:
            cache.put("k${i}", i64(i))
        cache.len()

    it("a miss on an empty cache is .None"):
        let mut cache = new_lru(2)
        assert_equal(cache.get("a"), .None)
        assert_equal(cache.len(), 0)

    it("returns the value put for a key"):
        let mut cache = new_lru(2)
        cache.put("a", 1)
        assert_equal(cache.get("a"), .Some(1))
        assert_equal(cache.len(), 1)

    it("a put of an existing key replaces its value"):
        let mut cache = new_lru(2)
        cache.put("a", 1)
        cache.put("a", 7)
        assert_equal(cache.get("a"), .Some(7))
        assert_equal(cache.len(), 1)

    it("evicts the least recently used key when over capacity"):
        let mut cache = new_lru(2)
        cache.put("a", 1)
        cache.put("b", 2)
        cache.put("c", 3)
        assert_equal(cache.get("a"), .None)
        assert_equal(cache.get("b"), .Some(2))
        assert_equal(cache.get("c"), .Some(3))
        assert_equal(cache.len(), 2)

    it("a hit makes its key most recently used"):
        let mut cache = new_lru(2)
        cache.put("a", 1)
        cache.put("b", 2)
        assert_equal(cache.get("a"), .Some(1))
        cache.put("c", 3)
        assert_equal(cache.get("b"), .None)
        assert_equal(cache.get("a"), .Some(1))

    it("a miss changes nothing"):
        let mut cache = new_lru(2)
        cache.put("a", 1)
        cache.put("b", 2)
        assert_equal(cache.get("zzz"), .None)
        cache.put("c", 3)
        assert_equal(cache.get("a"), .None, reason="a stayed least recent")
        assert_equal(cache.len(), 2)

    it("a put of an existing key makes it most recently used"):
        let mut cache = new_lru(2)
        cache.put("a", 1)
        cache.put("b", 2)
        cache.put("a", 10)
        cache.put("c", 3)
        assert_equal(cache.get("b"), .None)
        assert_equal(cache.get("a"), .Some(10))

    it("capacity zero keeps nothing"):
        let mut cache = new_lru(0)
        cache.put("a", 1)
        assert_equal(cache.get("a"), .None)
        assert_equal(cache.len(), 0)

    it_each(
        "len is the number of puts, capped at capacity",
        [(1, 3, 1), (2, 2, 2), (5, 3, 3), (0, 4, 0)],
        body=fn!(row: (usize, usize, usize)): assert_equal(puts_then_len(row._0, row._1), row._2)
    )

    it_prop_with("lru follows its model", gen=history, prop=fn!(input: (usize, List[Cmd])):
        let (capacity, cmds) = input
        let mut cache = new_lru(capacity)
        let mut model = Model { capacity, entries: [] }
        for cmd in cmds:
            match cmd:
                .Get(key) => assert_equal(cache.get(key), lookup(&model, key), reason="get $key")
                .Put(key, value) => cache.put(key, value)
            model = advance_cmd(&model, &cmd)
            assert_equal(cache.len(), model.entries.len(), reason="after ${debug(cmd)}")
    )
