use std.cli.{Args, args}
use std.console.{MemoryConsole, eprintln}
use std.fs.{FsError, FsRead, FsWrite, MemoryFs, create_dir_all, read_bytes, write_text}
use std.path.Path
use std.process.ExitCode

# Lines in `bytes`: each newline ends one line, and a last line with no
# newline still counts.
fn count_lines(bytes: List[u8]) -> usize:
    let newlines: usize = 0
    for byte in bytes:
        if byte == 10:
            newlines += 1
    open_last := match bytes.last():
        .Some(byte) => byte != 10
        .None => false
    if open_last: newlines + 1 else: newlines

fn count_file!(file: string) -> Result[usize, FsError] $ FsRead:
    bytes := read_bytes!(Path(file))?
    .Ok(count_lines(bytes))

# Prints `<lines> <file>` per file, then `<total> total`. Unreadable files
# are reported on standard error and skipped; the status is 1 if any failed.
pub fn main!() -> ExitCode $ Args + Console + FsRead:
    let total: usize = 0
    let failed = false
    for file in args():
        match count_file!(file):
            .Ok(lines) =>
                total += lines
                println("$lines $file")
            .Err(error) =>
                eprintln("linecount: $file: $error")
                failed = true
    println("$total total")
    if failed: ExitCode(1) else: ExitCode(0)

tests:
    use std.cli.ScriptedArgs
    use std.testing.it_each

    it_each(
        "counts lines, a last line without a newline included",
        [
            ("", 0),
            ("a", 1),
            ("a\n", 1),
            ("a\nb", 2),
            ("\n", 1),
            ("\n\n", 2),
            ("a\n\n", 2),
            ("a\nb\n", 2),
        ],
        body=fn!(row: (string, usize)): assert_equal(count_lines(row._0.to_utf8()), row._1)
    )

    it("prints each count and the total"):
        fs := MemoryFs::new()
        console := MemoryConsole::new()
        $.with(FsWrite=fs):
            _ := create_dir_all!(Path("data"))
            _ := write_text!(Path("data/a.txt"), "one\ntwo\n")
            _ := write_text!(Path("data/b.txt"), "x")
        arguments := box(ScriptedArgs::new("linecount", ["data/a.txt", "data/b.txt"]))
        $.with(Args=arguments, FsRead=fs, Console=console):
            assert_equal(main!(), ExitCode(0))
        assert_equal(console.output().join(""), "2 data/a.txt\n1 data/b.txt\n3 total\n")
        assert_equal(console.error_output().join(""), "")

    it("reports an unreadable file and goes on"):
        fs := MemoryFs::new()
        console := MemoryConsole::new()
        $.with(FsWrite=fs):
            _ := create_dir_all!(Path("data"))
            _ := write_text!(Path("data/a.txt"), "one\n")
        arguments := box(ScriptedArgs::new("linecount", ["data/missing.txt", "data/a.txt"]))
        $.with(Args=arguments, FsRead=fs, Console=console):
            assert_equal(main!(), ExitCode(1))
        assert_equal(console.output().join(""), "1 data/a.txt\n1 total\n")
        assert_equal(
            console.error_output().join(""),
            "linecount: data/missing.txt: not found: data/missing.txt\n",
        )

    it("with no files prints a zero total"):
        console := MemoryConsole::new()
        arguments := box(ScriptedArgs::new("linecount", []))
        $.with(Args=arguments, FsRead=MemoryFs::new(), Console=console):
            assert_equal(main!(), ExitCode(0))
        assert_equal(console.output().join(""), "0 total\n")
