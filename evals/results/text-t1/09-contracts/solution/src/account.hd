use std.contract.require
use std.num.Integer
use std.testing.Choices

## A bank account: a balance in cents that is never negative.
pub struct Account:
    cents: i64

## Opens an account with `cents`. The opening balance must not be negative.
pub fn open(cents: i64) -> Account:
    require("an opening balance is not negative"):
        cents >= 0
    account := Account { cents: cents }
    account.invariant()
    account

## Moves `cents` from `from` to `to`. The two balances together keep their total.
pub fn transfer(from: &mut Account, to: &mut Account, cents: i64) -> void:
    require("a transfer is positive"):
        cents > 0
    require("a transfer is not larger than the source balance"):
        cents <= from.cents
    require("the two balances together fit in an i64"):
        from.cents <= i64::max_value() - to.cents
    total := from.cents + to.cents
    from.withdraw(cents)
    to.deposit(cents)
    # Checked in debug and test builds only: a transfer keeps the total.
    require("a transfer keeps the total"):
        from.cents + to.cents == total

impl Account:
    ## The balance, in cents.
    pub fn balance(self) -> i64:
        self.cents

    ## Adds `cents` to the balance. A deposit must be positive.
    pub fn deposit(&mut self, cents: i64) -> void:
        require("a deposit is positive"):
            cents > 0
        require("a deposit does not overflow the balance"):
            cents <= i64::max_value() - self.cents
        self.cents += cents
        self.invariant()

    ## Takes `cents` from the balance. A withdrawal must be positive and no larger than the balance.
    pub fn withdraw(&mut self, cents: i64) -> void:
        require("a withdrawal is positive"):
            cents > 0
        require("a withdrawal is not larger than the balance"):
            cents <= self.cents
        self.cents -= cents
        self.invariant()

    # Holds after every call: the balance is never negative.
    fn invariant(&self) -> void:
        require("the balance is never negative"):
            self.cents >= 0

# Generates a start balance, another balance, and an amount that the start balance covers.
fn transfer_case(c: &mut Choices) -> (i64, i64, i64):
    let start: i64 = c.int(1..=1_000_000)
    let other: i64 = c.int(0..=1_000_000)
    let amount: i64 = c.int(1..=start)
    (start, other, amount)

tests:
    use std.testing.{it_prop_with}

    it("opens with the given balance"):
        assert_equal(open(250).balance(), 250)

    it("opens at zero"):
        assert_equal(open(0).balance(), 0)

    it("refuses a negative opening balance", expect_panic="explicit-panic"):
        _ := open(-1)

    it("a deposit adds to the balance"):
        let mut account = open(100)
        account.deposit(50)
        assert_equal(account.balance(), 150)

    it("refuses a zero deposit", expect_panic="explicit-panic"):
        let mut account = open(100)
        account.deposit(0)

    it("refuses a negative deposit", expect_panic="explicit-panic"):
        let mut account = open(100)
        account.deposit(-5)

    it("a withdrawal takes from the balance"):
        let mut account = open(100)
        account.withdraw(30)
        assert_equal(account.balance(), 70)

    it("a withdrawal may take the whole balance"):
        let mut account = open(100)
        account.withdraw(100)
        assert_equal(account.balance(), 0)

    it("refuses a withdrawal larger than the balance", expect_panic="explicit-panic"):
        let mut account = open(100)
        account.withdraw(101)

    it("refuses a zero withdrawal", expect_panic="explicit-panic"):
        let mut account = open(100)
        account.withdraw(0)

    it("a transfer moves money and keeps the total"):
        let mut source = open(100)
        let mut target = open(20)
        transfer(&mut source, &mut target, 70)
        assert_equal(source.balance(), 30)
        assert_equal(target.balance(), 90)

    it("refuses a transfer larger than the source balance", expect_panic="explicit-panic"):
        let mut source = open(100)
        let mut target = open(20)
        transfer(&mut source, &mut target, 101)

    it("refuses a zero transfer", expect_panic="explicit-panic"):
        let mut source = open(100)
        let mut target = open(20)
        transfer(&mut source, &mut target, 0)

    it_prop_with("a transfer keeps the total and no balance goes negative", gen=transfer_case, prop=fn!(
        input: (i64, i64, i64),
    ):
        let mut source = open(input._0)
        let mut target = open(input._1)
        transfer(&mut source, &mut target, input._2)
        assert_equal(source.balance() + target.balance(), input._0 + input._1)
        assert(source.balance() >= 0 && target.balance() >= 0)
    )
