use std.encoding.Deserialize
use std.encoding.json.{JsonError, decode}
use std.fs.{FsError, FsRead, read_text}
use std.host.{Env, HostError, env_decode}
use std.path.Path
use std.validate.{Validate, ValidationError, length, range}

# A service's configuration. `workers` may be left out of the JSON file.
@derive(Deserialize, Validate, Eq, Debug)
pub struct Config:
    @length(1, 253)
    pub host: string
    @range(1024, 65535)
    pub port: i32
    @range(1, 64)
    pub workers: i32 = 4

# The one setting the environment may override: an unset APP_PORT is `.None`.
@derive(Deserialize)
struct Overrides:
    port: i32?

@error
pub enum ConfigError:
    @error("cannot read the config file: $error")
    Read(
        @from
        error: FsError,
    )
    @error("the config file is not valid JSON for a config: $error")
    Parse(
        @from
        error: JsonError,
    )
    @error("$error")
    Environment(
        @from
        error: HostError,
    )
    @error("$error")
    Invalid(
        @from
        error: ValidationError,
    )

# Reads the JSON file at `path`, lets APP_PORT replace the port, then checks
# the rules on the fields.
pub fn load_config!(path: string) -> Result[Config, ConfigError] $ FsRead + Env:
    text := read_text!(Path(path))?
    config := decode::[Config](text)?
    overrides := env_decode::[Overrides](prefix="APP_")?
    merged := Config { ...config, port: overrides.port.unwrap_or(config.port) }
    checked := merged.validated()?
    .Ok(checked)

tests:
    use std.fs.{FsWrite, MemoryFs, write_text}
    use std.host.ScriptedEnv

    fn load_with!(text: string, vars: Map[string, string]) -> Result[Config, ConfigError]:
        fs := MemoryFs::new()
        $.with(FsWrite=fs):
            _ := write_text!(Path("config.json"), text)
        $.with(FsRead=fs, Env=box(ScriptedEnv::new(vars))):
            load_config!("config.json")

    it("reads every field and defaults workers to 4"):
        config := load_with!("{\"host\": \"example.com\", \"port\": 8080}", {})
            .ok()
            .expect("a valid config")
        assert_equal(config, Config { host: "example.com", port: 8080, workers: 4 })

    it("reads an explicit workers value"):
        config := load_with!("{\"host\": \"example.com\", \"port\": 8080, \"workers\": 12}", {})
            .ok()
            .expect("a valid config")
        assert_equal(config.workers, 12)

    it("lets APP_PORT replace the port"):
        config := load_with!("{\"host\": \"example.com\", \"port\": 8080}", { "APP_PORT": "9000" })
            .ok()
            .expect("a valid config")
        assert_equal(config.port, 9000)
        assert_equal(config.host, "example.com")

    it("reports a missing file as Read"):
        fs := MemoryFs::new()
        $.with(FsRead=fs, Env=box(ScriptedEnv::new({}))):
            match load_config!("missing.json"):
                .Err(.Read(_)) => pass
                _ => panic("expected Read")

    it("reports text that is not JSON as Parse"):
        match load_with!("{not json", {}):
            .Err(.Parse(_)) => pass
            _ => panic("expected Parse")

    it("reports a missing required field as Parse"):
        match load_with!("{\"port\": 8080}", {}):
            .Err(.Parse(_)) => pass
            _ => panic("expected Parse")

    it("reports a non-integer APP_PORT as Environment"):
        match load_with!("{\"host\": \"example.com\", \"port\": 8080}", { "APP_PORT": "http" }):
            .Err(.Environment(_)) => pass
            _ => panic("expected Environment")

    it("rejects an empty host"):
        match load_with!("{\"host\": \"\", \"port\": 8080}", {}):
            .Err(.Invalid(_)) => pass
            _ => panic("expected Invalid")

    it("accepts a 253-character host and rejects 254"):
        ok := load_with!("{\"host\": \"${"a".repeat(253)}\", \"port\": 8080}", {})
        assert(ok.is_ok())
        bad := load_with!("{\"host\": \"${"a".repeat(254)}\", \"port\": 8080}", {})
        match bad:
            .Err(.Invalid(_)) => pass
            _ => panic("expected Invalid")

    it("accepts the port bounds and rejects outside them"):
        assert(load_with!("{\"host\": \"h\", \"port\": 1024}", {}).is_ok())
        assert(load_with!("{\"host\": \"h\", \"port\": 65535}", {}).is_ok())
        match load_with!("{\"host\": \"h\", \"port\": 1023}", {}):
            .Err(.Invalid(_)) => pass
            _ => panic("expected Invalid for 1023")
        match load_with!("{\"host\": \"h\", \"port\": 65536}", {}):
            .Err(.Invalid(_)) => pass
            _ => panic("expected Invalid for 65536")

    it("rejects an overridden port that breaks the rule"):
        match load_with!("{\"host\": \"h\", \"port\": 8080}", { "APP_PORT": "80" }):
            .Err(.Invalid(_)) => pass
            _ => panic("expected Invalid")

    it("accepts the workers bounds and rejects outside them"):
        assert(load_with!("{\"host\": \"h\", \"port\": 8080, \"workers\": 1}", {}).is_ok())
        assert(load_with!("{\"host\": \"h\", \"port\": 8080, \"workers\": 64}", {}).is_ok())
        match load_with!("{\"host\": \"h\", \"port\": 8080, \"workers\": 0}", {}):
            .Err(.Invalid(_)) => pass
            _ => panic("expected Invalid for 0 workers")
        match load_with!("{\"host\": \"h\", \"port\": 8080, \"workers\": 65}", {}):
            .Err(.Invalid(_)) => pass
            _ => panic("expected Invalid for 65 workers")

    it("compares configs by value and prints them"):
        a := Config { host: "h", port: 2000 }
        b := Config { host: "h", port: 2000, workers: 4 }
        assert_equal(a, b)
        assert(a != Config { host: "h", port: 2001 })
        assert_equal(debug(a), "Config { host: \"h\", port: 2000, workers: 4 }")
