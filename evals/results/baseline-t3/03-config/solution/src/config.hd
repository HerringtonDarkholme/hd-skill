use std.encoding.Deserialize
use std.encoding.json.{JsonError, decode}
use std.fs.{FsError, FsRead, FsWrite, MemoryFs, read_text, write_text}
use std.host.{Env, HostError, ScriptedEnv, env_as}
use std.path.Path
use std.validate.{Validate, ValidationError, length, range}

# A service's settings. `host` and `port` must come from the file or the
# environment; `workers` defaults to 4.
@derive(Deserialize, Validate, Eq, Debug)
pub struct Config:
    @length(1, 253)
    host: string
    @range(1024, 65535)
    port: i32
    @range(1, 64)
    workers: i32 = 4

@error
pub enum ConfigError:
    @error("cannot read the config file: $error")
    Read(
        @from
        error: FsError,
    )
    @error("the config file is not a valid config: $error")
    Parse(
        @from
        error: JsonError,
    )
    @error("$error")
    Environment(
        @from
        error: HostError,
    )
    @error("invalid config: $error")
    Invalid(
        @from
        error: ValidationError,
    )

# Reads the JSON file at `path`, applies `APP_PORT` if it is set, then checks
# the rules on the fields.
pub fn load_config!(path: string) -> Result[Config, ConfigError] $ FsRead + Env:
    text := read_text!(Path(path))?
    config := decode::[Config](text)?
    overridden := match env_as::[i32]("APP_PORT")?:
        .Some(port) => Config { ...config, port: port }
        .None => config
    .Ok(overridden.validated()?)

tests:
    fn kind(error: ConfigError) -> string:
        match error:
            .Read(_) => "Read"
            .Parse(_) => "Parse"
            .Environment(_) => "Environment"
            .Invalid(_) => "Invalid"

    it("loads a file and defaults workers to 4"):
        fs := MemoryFs::new()
        $.with(FsWrite=fs):
            _ := write_text!(Path("config.json"), "{\"host\": \"localhost\", \"port\": 8080}")
        $.with(FsRead=fs, Env=box(ScriptedEnv::new({}))):
            assert_equal(
                load_config!("config.json").ok(),
                .Some(Config { host: "localhost", port: 8080, workers: 4 }),
            )

    it("reads workers from the file"):
        fs := MemoryFs::new()
        $.with(FsWrite=fs):
            _ := write_text!(
                Path("config.json"),
                "{\"host\": \"localhost\", \"port\": 8080, \"workers\": 16}",
            )
        $.with(FsRead=fs, Env=box(ScriptedEnv::new({}))):
            assert_equal(
                load_config!("config.json").ok(),
                .Some(Config { host: "localhost", port: 8080, workers: 16 }),
            )

    it("lets APP_PORT replace the port"):
        fs := MemoryFs::new()
        $.with(FsWrite=fs):
            _ := write_text!(Path("config.json"), "{\"host\": \"localhost\", \"port\": 8080}")
        $.with(FsRead=fs, Env=box(ScriptedEnv::new({ "APP_PORT": "9000" }))):
            assert_equal(
                load_config!("config.json").ok(),
                .Some(Config { host: "localhost", port: 9000, workers: 4 }),
            )

    it("reports a missing file as Read"):
        $.with(FsRead=MemoryFs::new(), Env=box(ScriptedEnv::new({}))):
            error := load_config!("missing.json").err().expect("an error")
            assert_equal(kind(error), "Read")

    it("reports text that is not JSON as Parse"):
        fs := MemoryFs::new()
        $.with(FsWrite=fs):
            _ := write_text!(Path("config.json"), "{not json")
        $.with(FsRead=fs, Env=box(ScriptedEnv::new({}))):
            error := load_config!("config.json").err().expect("an error")
            assert_equal(kind(error), "Parse")

    it("reports a missing required field as Parse"):
        fs := MemoryFs::new()
        $.with(FsWrite=fs):
            _ := write_text!(Path("config.json"), "{\"port\": 8080}")
        $.with(FsRead=fs, Env=box(ScriptedEnv::new({}))):
            error := load_config!("config.json").err().expect("an error")
            assert_equal(kind(error), "Parse")

    it("reports a non-integer APP_PORT as Environment"):
        fs := MemoryFs::new()
        $.with(FsWrite=fs):
            _ := write_text!(Path("config.json"), "{\"host\": \"localhost\", \"port\": 8080}")
        $.with(FsRead=fs, Env=box(ScriptedEnv::new({ "APP_PORT": "http" }))):
            error := load_config!("config.json").err().expect("an error")
            assert_equal(kind(error), "Environment")

    it("reports a file port below 1024 as Invalid"):
        fs := MemoryFs::new()
        $.with(FsWrite=fs):
            _ := write_text!(Path("config.json"), "{\"host\": \"localhost\", \"port\": 1023}")
        $.with(FsRead=fs, Env=box(ScriptedEnv::new({}))):
            error := load_config!("config.json").err().expect("an error")
            assert_equal(kind(error), "Invalid")

    it("reports an overridden port that breaks the rule as Invalid"):
        fs := MemoryFs::new()
        $.with(FsWrite=fs):
            _ := write_text!(Path("config.json"), "{\"host\": \"localhost\", \"port\": 8080}")
        $.with(FsRead=fs, Env=box(ScriptedEnv::new({ "APP_PORT": "80" }))):
            error := load_config!("config.json").err().expect("an error")
            assert_equal(kind(error), "Invalid")

    it("accepts the port bounds 1024 and 65535"):
        fs := MemoryFs::new()
        $.with(FsWrite=fs):
            _ := write_text!(Path("low.json"), "{\"host\": \"h\", \"port\": 1024}")
            _ := write_text!(Path("high.json"), "{\"host\": \"h\", \"port\": 65535}")
        $.with(FsRead=fs, Env=box(ScriptedEnv::new({}))):
            assert(load_config!("low.json").is_ok())
            assert(load_config!("high.json").is_ok())

    it("rejects a port above 65535"):
        fs := MemoryFs::new()
        $.with(FsWrite=fs):
            _ := write_text!(Path("config.json"), "{\"host\": \"h\", \"port\": 65536}")
        $.with(FsRead=fs, Env=box(ScriptedEnv::new({}))):
            assert(load_config!("config.json").is_err())

    it("accepts workers 1 and 64, rejects 0 and 65"):
        fs := MemoryFs::new()
        $.with(FsWrite=fs):
            _ := write_text!(Path("one.json"), "{\"host\": \"h\", \"port\": 8080, \"workers\": 1}")
            _ := write_text!(Path("max.json"), "{\"host\": \"h\", \"port\": 8080, \"workers\": 64}")
            _ := write_text!(Path("zero.json"), "{\"host\": \"h\", \"port\": 8080, \"workers\": 0}")
            _ := write_text!(
                Path("many.json"),
                "{\"host\": \"h\", \"port\": 8080, \"workers\": 65}",
            )
        $.with(FsRead=fs, Env=box(ScriptedEnv::new({}))):
            assert(load_config!("one.json").is_ok())
            assert(load_config!("max.json").is_ok())
            assert(load_config!("zero.json").is_err())
            assert(load_config!("many.json").is_err())

    it("accepts a 253-character host and rejects an empty or 254-character one"):
        long := "a".repeat(253)
        too_long := "a".repeat(254)
        fs := MemoryFs::new()
        $.with(FsWrite=fs):
            _ := write_text!(Path("ok.json"), "{\"host\": \"$long\", \"port\": 8080}")
            _ := write_text!(Path("empty.json"), "{\"host\": \"\", \"port\": 8080}")
            _ := write_text!(Path("long.json"), "{\"host\": \"$too_long\", \"port\": 8080}")
        $.with(FsRead=fs, Env=box(ScriptedEnv::new({}))):
            assert(load_config!("ok.json").is_ok())
            assert(load_config!("empty.json").is_err())
            assert(load_config!("long.json").is_err())

    it("compares configs by value"):
        a := Config { host: "h", port: 8080 }
        b := Config { host: "h", port: 8080, workers: 4 }
        assert_equal(a, b)
        assert(a != Config { host: "h", port: 8081 })

    it("prints a config for debugging"):
        text := debug(Config { host: "example.test", port: 8080 })
        assert(text.contains("example.test"))
        assert(text.contains("8080"))
