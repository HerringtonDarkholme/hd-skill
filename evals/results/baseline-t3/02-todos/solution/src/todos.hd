use std.encoding.json.{decode, encode}
use std.encoding.{Deserialize, Serialize}
use std.testing.assert_equal

# One todo item as it appears in the JSON array.
@derive(Serialize, Deserialize, Eq, Debug)
pub struct Todo:
    pub id: i32
    pub title: string
    pub done: bool = false

@derive(Eq, Debug)
pub enum TodoError:
    BadJson(message: string)
    UnknownId(id: i32)

# Reads a JSON array of {"id", "title", "done"} objects. `done` may be absent.
pub fn load(json: string) -> Result[List[Todo], TodoError]:
    match decode::[List[Todo]](json):
        .Ok(todos) => .Ok(todos)
        .Err(error) => .Err(.BadJson("$error"))

# Writes the todos as a JSON array that `load` reads back unchanged.
pub fn dump(todos: List[Todo]) -> string:
    encode(todos)

# Marks the todo with `id` as done. Fails with `UnknownId` if no todo has it.
pub fn complete(todos: List[Todo], id: i32) -> Result[List[Todo], TodoError]:
    let found = false
    let mut result: List[Todo] = []
    for item in todos:
        if item.id == id:
            found = true
            result.push(Todo { ...item, done: true })
        else:
            result.push(item)
    if !found:
        return .Err(.UnknownId(id))
    .Ok(result)

# The titles of the todos that are not done, in order.
pub fn pending(todos: List[Todo]) -> List[string]:
    let mut titles: List[string] = []
    for item in todos:
        if !item.done:
            titles.push(item.title)
    titles

tests:
    it("loads a todo array"):
        result := load(
            "[{\"id\": 1, \"title\": \"milk\", \"done\": true}, {\"id\": 2, \"title\": \"eggs\"}]",
        )
        assert_equal(
            result,
            .Ok(
                [
                    Todo { id: 1, title: "milk", done: true },
                    Todo { id: 2, title: "eggs", done: false },
                ],
            ),
        )

    it("treats a missing done field as false"):
        result := load("[{\"id\": 7, \"title\": \"bread\"}]")
        assert_equal(result, .Ok([Todo { id: 7, title: "bread", done: false }]))

    it("accepts an empty array"):
        assert_equal(load("[]"), .Ok([]))

    it("rejects input that is not a todo array"):
        assert_equal(load("{}").is_err(), true, reason="an object is not an array")
        assert_equal(load("[1, 2]").is_err(), true, reason="elements must be objects")
        assert_equal(
            load("[{\"id\": \"x\", \"title\": \"a\"}]").is_err(),
            true,
            reason="id must be a number",
        )
        assert_equal(load("[{\"id\": 1}]").is_err(), true, reason="title is required")
        assert_equal(load("[{\"id\": 1, \"title\": \"a\"}").is_err(), true, reason="truncated JSON")

    it("reports a bad parse as BadJson with a message"):
        match load("nope"):
            .Err(.BadJson(message)) =>
                assert_equal(message.is_empty(), false, reason="a parse error has a message")
            .Err(.UnknownId(_)) => assert_equal("UnknownId", "BadJson")
            .Ok(_) => assert_equal("Ok", "Err")

    it("dump output reads back unchanged"):
        todos := [
            Todo { id: 3, title: "say \"hi\"", done: true },
            Todo { id: -4, title: "", done: false },
        ]
        assert_equal(load(dump(todos)), .Ok(todos))

    it("dump of an empty list reads back as empty"):
        assert_equal(load(dump([])), .Ok([]))

    it("complete marks only the given todo done"):
        todos := [Todo { id: 1, title: "a", done: false }, Todo { id: 2, title: "b", done: false }]
        assert_equal(
            complete(todos, 2),
            .Ok([Todo { id: 1, title: "a", done: false }, Todo { id: 2, title: "b", done: true }]),
        )

    it("complete on an unknown id is an error"):
        todos := [Todo { id: 1, title: "a", done: false }]
        assert_equal(complete(todos, 9), .Err(.UnknownId(9)))

    it("pending lists undone titles in order"):
        todos := [
            Todo { id: 1, title: "a", done: true },
            Todo { id: 2, title: "b", done: false },
            Todo { id: 3, title: "c", done: false },
        ]
        assert_equal(pending(todos), ["b", "c"])

    it("pending of an empty list is empty"):
        assert_equal(pending([]), [])
