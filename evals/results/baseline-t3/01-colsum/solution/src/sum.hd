## A line that cannot be summed. Line numbers count from 1, header and blank lines included.
@derive(Eq, Debug)
pub enum SumError:
    MissingColumn(line: usize)
    NotANumber(line: usize, text: string)

# Column `n` (1-based) of a line, or `.None` when the line is too short.
# Column 0 never exists.
fn column(fields: List[string], n: usize) -> string?:
    if n == 0:
        return .None
    fields.get(n - 1)

# Sums `value` grouped by `key`, one total per key, sorted by key.
pub fn summarize(
    text: string,
    key: usize,
    value: usize,
    skip_header: bool,
) -> Result[List[(string, i64)], SumError]:
    let mut totals: Map[string, i64] = {}
    for (index, line) in text.lines().iter().enumerate():
        number := index + 1
        if skip_header && number == 1:
            continue
        if line.trim() == "":
            continue
        fields := line.split(",")
        name := match column(fields, key):
            .Some(cell) => cell.trim()
            .None => return .Err(.MissingColumn(number))
        raw := match column(fields, value):
            .Some(cell) => cell.trim()
            .None => return .Err(.MissingColumn(number))
        amount := match raw.parse::[i64]():
            .Ok(n) => n
            .Err(_) => return .Err(.NotANumber(number, raw))
        totals[name] = totals.get(name).unwrap_or(0) + amount
    let mut result: List[(string, i64)] = []
    for name in totals.keys().collect::[List[string]]().sorted():
        result.push((name, totals[name]))
    .Ok(result)

tests:
    it("sums one column grouped by another, sorted by key"):
        assert_equal(summarize("b,1\na,2\nb,3\n", 1, 2, false), .Ok([("a", 2), ("b", 4)]))

    it("uses the given key and value columns"):
        assert_equal(summarize("x,10,a\ny,20,a\nx,5,b\n", 3, 2, false), .Ok([("a", 30), ("b", 5)]))
        assert_equal(summarize("10,x\n20,y\n", 2, 1, false), .Ok([("x", 10), ("y", 20)]))

    it("skips the first line when asked"):
        assert_equal(summarize("name,amount\na,1\na,2\n", 1, 2, true), .Ok([("a", 3)]))
        assert_equal(summarize("name,amount\na,1\n", 1, 2, false), .Err(.NotANumber(1, "amount")))

    it("ignores blank lines but still counts them"):
        assert_equal(summarize("a,1\n\n   \nb,2\n", 1, 2, false), .Ok([("a", 1), ("b", 2)]))
        assert_equal(summarize("a,1\n\nb\n", 1, 2, false), .Err(.MissingColumn(3)))

    it("trims keys and values"):
        assert_equal(summarize(" a , 4 \na,  -1\n", 1, 2, false), .Ok([("a", 3)]))

    it("accepts signed values"):
        assert_equal(summarize("a,-5\na,2\nb,-7\n", 1, 2, false), .Ok([("a", -3), ("b", -7)]))

    it("reports the trimmed text of a value that is not an integer"):
        assert_equal(summarize("a,1\nb,  2.5 \n", 1, 2, false), .Err(.NotANumber(2, "2.5")))
        assert_equal(summarize("a,\n", 1, 2, false), .Err(.NotANumber(1, "")))

    it("reports a line with too few columns"):
        assert_equal(summarize("a,1,x\nb\n", 1, 2, false), .Err(.MissingColumn(2)))
        assert_equal(summarize("a,1\n", 1, 3, false), .Err(.MissingColumn(1)))

    it("treats column 0 as missing"):
        assert_equal(summarize("a,1\n", 0, 2, false), .Err(.MissingColumn(1)))

    it("gives an empty list for empty input"):
        assert_equal(summarize("", 1, 2, false), .Ok([]))
        assert_equal(summarize("name,amount\n", 1, 2, true), .Ok([]))

    it("compares and prints errors"):
        assert_equal(SumError.MissingColumn(2) == SumError.MissingColumn(2), true)
        assert(SumError.MissingColumn(2) != SumError.NotANumber(2, "x"))
        assert_equal(debug(SumError.NotANumber(4, "x")), "SumError.NotANumber(line=4, text=\"x\")")
