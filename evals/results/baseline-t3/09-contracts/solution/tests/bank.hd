use std.process.{Command, Process, ProcessOutput}
use std.testing.hd_run

## Runs the built `bank-misuse` program with one case and returns its output.
fn misuse!(case: string) -> ProcessOutput $ Process:
    hd_run!(*Command::new("bank-misuse").arg(case))

it("a correct call runs normally"):
    let out = misuse!("ok")
    assert_equal(out.status, 0)
    assert_equal(out.stdout, "ok 7\n")

it("a negative opening balance stops the program"):
    let out = misuse!("open-negative")
    assert(out.status != 0, reason="misuse must not exit cleanly")
    assert(
        out.stderr.contains("the opening balance is not negative"),
        reason="names the broken rule",
    )

it("a zero deposit stops the program"):
    let out = misuse!("deposit-zero")
    assert(out.status != 0, reason="misuse must not exit cleanly")
    assert(out.stderr.contains("a deposit is positive"), reason="names the broken rule")

it("a negative withdrawal stops the program"):
    let out = misuse!("withdraw-negative")
    assert(out.status != 0, reason="misuse must not exit cleanly")
    assert(out.stderr.contains("a withdrawal is positive"), reason="names the broken rule")

it("a withdrawal above the balance stops the program"):
    let out = misuse!("withdraw-too-much")
    assert(out.status != 0, reason="misuse must not exit cleanly")
    assert(out.stderr.contains("not larger than the balance"), reason="names the broken rule")

it("a zero transfer stops the program"):
    let out = misuse!("transfer-zero")
    assert(out.status != 0, reason="misuse must not exit cleanly")
    assert(out.stderr.contains("a transfer is positive"), reason="names the broken rule")

it("a transfer above the source balance stops the program"):
    let out = misuse!("transfer-too-much")
    assert(out.status != 0, reason="misuse must not exit cleanly")
    assert(
        out.stderr.contains("not larger than the source balance"),
        reason="names the broken rule",
    )
