## A run of `count` copies of `value` in a row.
@derive(Eq, Debug)
pub struct Run:
    pub value: i32
    pub count: usize

## The maximal runs of `xs`, in order: no run is empty, and neighbouring
## runs have different values. An empty list gives no runs.
pub fn encode(xs: List[i32]) -> List[Run]:
    let mut runs: List[Run] = []
    let mut value: i32 = 0
    let mut count: usize = 0
    for x in xs:
        if count > 0 && x == value:
            count += 1
        else:
            if count > 0:
                runs.push(Run { value: value, count: count })
            value = x
            count = 1
    if count > 0:
        runs.push(Run { value: value, count: count })
    runs

## The list that `runs` stands for, one element per copy. Runs need not be
## maximal: decoding works for any runs.
pub fn decode(runs: List[Run]) -> List[i32]:
    let mut out: List[i32] = []
    for run in runs:
        for _ in 0..run.count:
            out.push(run.value)
    out

tests:
    use std.testing.it_prop

    fn is_maximal(runs: List[Run]) -> bool:
        for i in 0..runs.len():
            if runs[i].count == 0:
                return false
            if i > 0 && runs[i - 1].value == runs[i].value:
                return false
        true

    it("encodes the empty list as no runs"):
        assert_equal(encode([]), [])

    it("encodes one value as one run"):
        assert_equal(encode([7]), [Run { value: 7, count: 1 }])

    it("merges a block of equal values"):
        assert_equal(encode([5, 5, 5]), [Run { value: 5, count: 3 }])

    it("splits at each change of value"):
        assert_equal(
            encode([1, 1, 2, 3, 3, 3, 1]),
            [
                Run { value: 1, count: 2 },
                Run { value: 2, count: 1 },
                Run { value: 3, count: 3 },
                Run { value: 1, count: 1 },
            ],
        )

    it("keeps negative values and zero apart from each other"):
        assert_equal(
            encode([-1, -1, 0, 0, 0]),
            [Run { value: -1, count: 2 }, Run { value: 0, count: 3 }],
        )

    it("does not merge equal values separated by another"):
        assert_equal(encode([2, 1, 2]).len(), 3)

    it("decodes the empty list as no values"):
        assert_equal(decode([]), [])

    it("decodes a run to its copies"):
        assert_equal(decode([Run { value: 4, count: 3 }, Run { value: 9, count: 1 }]), [4, 4, 4, 9])

    it("decodes a zero-length run to nothing"):
        assert_equal(decode([Run { value: 4, count: 0 }, Run { value: 9, count: 2 }]), [9, 9])

    it("decodes runs that are not maximal"):
        assert_equal(decode([Run { value: 1, count: 2 }, Run { value: 1, count: 1 }]), [1, 1, 1])

    it("encodes only maximal runs"):
        assert(is_maximal(encode([1, 1, 2, 2, 1, 3, 3, 3])))
        assert(is_maximal(encode([])))

    it_prop(
        "decoding undoes encoding for any list",
        prop=fn!(xs: List[i32]): assert_equal(decode(encode(xs)), xs)
    )

    it_prop("decoding undoes encoding for lists with long runs", prop=fn!(xs: List[i32]):
        small := [for x in xs => x % 3]
        assert_equal(decode(encode(small)), small)
    )

    it_prop(
        "encoding is maximal for any list",
        prop=fn!(xs: List[i32]): assert(is_maximal(encode(xs)))
    )

    it_prop("encoded runs cover the list length exactly", prop=fn!(xs: List[i32]):
        let mut total: usize = 0
        for run in encode(xs):
            total += run.count
        assert_equal(total, xs.len())
    )

    it_prop("encoding a decoded list gives back the same runs", prop=fn!(xs: List[i32]):
        runs := encode(xs)
        assert_equal(encode(decode(runs)), runs)
    )

    it_prop(
        "encoding is no longer than the list",
        prop=fn!(xs: List[i32]): assert(encode(xs).len() <= xs.len())
    )
