use pkg.{Limiter, new_limiter}
use std.time.{Clock, ManualClock, Timestamp, s}

it("a limiter built through the package interface refuses the third event"):
    clock := ManualClock::new(Timestamp::from_unix_milliseconds(0))
    $.with(Clock=clock):
        let mut limiter = new_limiter(2, s(10))
        assert(limiter.allow("user-1"))
        assert(limiter.allow("user-1"))
        assert(!limiter.allow("user-1"), reason="the window holds two events")
