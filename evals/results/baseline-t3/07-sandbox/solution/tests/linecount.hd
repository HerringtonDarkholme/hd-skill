use std.process.Command
use std.testing.{assert_equal, hd_run}

it("counts the lines of a file under data/"):
    let out = hd_run!(*Command::new("linecount").arg("data/sample.txt"))
    assert_equal(out.stdout, "3 data/sample.txt\n3 total\n", reason="one file")
    assert_equal(out.stderr, "", reason="nothing skipped")
    assert_equal(out.status, 0, reason="a clean exit")

it("refuses files outside data/ and exits 1"):
    let out = hd_run!(*Command::new("linecount").args(["../hd.toml", "data/sample.txt"]))
    assert_equal(
        out.stdout,
        "3 data/sample.txt\n3 total\n",
        reason="the readable file is still counted",
    )
    assert(out.stderr.contains("linecount: ../hd.toml: "), reason="the refused file is reported")
    assert_equal(out.status, 1, reason="a skipped file fails the run")
