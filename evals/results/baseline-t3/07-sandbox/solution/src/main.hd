use std.cli.{Args, ScriptedArgs, args}
use std.console.{MemoryConsole, eprintln}
use std.fs.{FsRead, FsWrite, MemoryFs, create_dir_all, read_text, write_text}
use std.path.Path
use std.process.ExitCode

# The number of lines in one file under data/, or why it cannot be read.
fn count_lines!(file: string) -> Result[usize, string] $ FsRead:
    match read_text!(Path(file)):
        .Ok(text) => .Ok(text.lines().len())
        .Err(error) => .Err("$error")

# Print each file's line count, then the total. Unreadable files are reported
# on standard error and skipped; the status is 1 if any file was skipped.
pub fn run!(files: List[string]) -> ExitCode $ Console + FsRead:
    let mut total: usize = 0
    let mut skipped = false
    for file in files:
        match count_lines!(file):
            .Ok(lines) =>
                total = total + lines
                println("$lines $file")
            .Err(reason) =>
                eprintln("linecount: $file: $reason")
                skipped = true
    println("$total total")
    if skipped: ExitCode(1) else: ExitCode(0)

pub fn main!() -> ExitCode $ Args + Console + FsRead:
    run!(args())

tests:
    it("prints each count and the total"):
        fs := MemoryFs::new()
        console := MemoryConsole::new()
        $.with(FsWrite=fs):
            _ := create_dir_all!(Path("data"))
            _ := write_text!(Path("data/a.txt"), "one\ntwo\n")
            _ := write_text!(Path("data/b.txt"), "three")
        $.with(FsRead=fs, Console=console):
            assert_equal(run!(["data/a.txt", "data/b.txt"]), ExitCode(0))
        assert_equal(console.output().join(""), "2 data/a.txt\n1 data/b.txt\n3 total\n")

    it("counts an empty file as zero lines"):
        fs := MemoryFs::new()
        console := MemoryConsole::new()
        $.with(FsWrite=fs):
            _ := create_dir_all!(Path("data"))
            _ := write_text!(Path("data/empty.txt"), "")
        $.with(FsRead=fs, Console=console):
            assert_equal(run!(["data/empty.txt"]), ExitCode(0))
        assert_equal(console.output().join(""), "0 data/empty.txt\n0 total\n")

    it("prints no files as a zero total"):
        console := MemoryConsole::new()
        $.with(FsRead=MemoryFs::new(), Console=console):
            assert_equal(run!([]), ExitCode(0))
        assert_equal(console.output().join(""), "0 total\n")

    it("skips an unreadable file, reports it, and exits 1"):
        fs := MemoryFs::new()
        console := MemoryConsole::new()
        $.with(FsWrite=fs):
            _ := create_dir_all!(Path("data"))
            _ := write_text!(Path("data/a.txt"), "x\ny\n")
        $.with(FsRead=fs, Console=console):
            assert_equal(run!(["data/missing.txt", "data/a.txt"]), ExitCode(1))
        assert_equal(console.output().join(""), "2 data/a.txt\n2 total\n")
        assert_equal(
            console.error_output().join(""),
            "linecount: data/missing.txt: not found: data/missing.txt\n",
        )

    it("reads the arguments the program was started with"):
        fs := MemoryFs::new()
        console := MemoryConsole::new()
        arguments := box(ScriptedArgs::new("linecount", ["data/a.txt"]))
        $.with(FsWrite=fs):
            _ := create_dir_all!(Path("data"))
            _ := write_text!(Path("data/a.txt"), "only\n")
        $.with(Args=arguments, FsRead=fs, Console=console):
            assert_equal(main!(), ExitCode(0))
        assert_equal(console.output().join(""), "1 data/a.txt\n1 total\n")
