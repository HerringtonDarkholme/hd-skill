use std.task.{Backoff, Receiver, Sender, apply, channel, join, map_join, retry}
use std.time.{Clock, ManualClock, Timestamp, ms, now, sleep}

## Why a sku could not be quoted.
@derive(Eq, Debug)
pub enum QuoteError:
    Busy
    Unknown(sku: string)

## A quote service: the price of one sku, in cents.
pub trait Quotes:
    fn quote!(&mut self, sku: string) -> Result[i64, QuoteError]

## One attempt at one sku's price.
fn quote_once!(sku: string) -> Result[i64, QuoteError] $ Quotes:
    $.use(Quotes).quote!(sku)

## One sku's price: up to 3 attempts, about 10 ms apart.
fn quote_sku!(sku: string) -> Result[i64, QuoteError] $ Quotes + Clock:
    policy := retry(Backoff { attempts: 3, initial: 10ms, factor: 1 })
    apply!(policy):
        quote_once!(sku)

## The sum of the prices of `skus`. At most 4 quotes are in flight at once.
## The first failing sku, in list order, decides the error.
pub fn order_total!(skus: List[string]) -> Result[i64, QuoteError] $ Quotes + Clock:
    prices := map_join!(skus, 4, quote_sku)
    let total: i64 = 0
    for price in prices:
        total += price?
    .Ok(total)

tests:
    struct Scripted:
        failures: Map[string, usize]
        prices: Map[string, i64]
        calls: usize

    impl Quotes for Scripted:
        fn quote!(&mut self, sku: string) -> Result[i64, QuoteError]:
            self.calls += 1
            let left = self.failures.get(sku).unwrap_or(0)
            if left > 0:
                self.failures[sku] = left - 1
                return .Err(.Busy)
            match self.prices.get(sku):
                .Some(price) => .Ok(price)
                .None => .Err(.Unknown(sku))

    # Each quote waits for a token from `gate`, and counts how many wait at once.
    struct Gated:
        gate: Receiver[bool]
        waiting: usize
        peak: usize

    impl Quotes for Gated:
        fn quote!(&mut self, sku: string) -> Result[i64, QuoteError]:
            self.waiting += 1
            if self.waiting > self.peak:
                self.peak = self.waiting
            _ := self.gate.recv!()
            self.waiting -= 1
            .Ok(1)

    # Releases `count` quotes, one per millisecond of virtual time.
    fn feed!(tx: Sender[bool], count: usize) -> void $ Clock:
        for _ in 0..count:
            sleep!(1ms)
            tx.send!(true)

    fn scripted(prices: Map[string, i64], failures: Map[string, usize]) -> *mut Scripted:
        box(Scripted { failures: failures, prices: prices, calls: 0 })

    fn clock() -> *mut ManualClock:
        ManualClock::new(Timestamp::from_unix_milliseconds(0))

    it("an empty order totals zero"):
        $.with(Quotes=scripted({}, {}), Clock=clock()):
            assert_equal(order_total!([]), .Ok(0))

    it("sums the prices of every sku"):
        shop := scripted({ "tea": 300, "cake": 450, "jam": 125 }, {})
        $.with(Quotes=shop, Clock=clock()):
            assert_equal(order_total!(["tea", "cake", "jam"]), .Ok(875))
        assert_equal(shop.calls, 3)

    it("retries a busy sku until it answers"):
        shop := scripted({ "tea": 300 }, { "tea": 2 })
        $.with(Quotes=shop, Clock=clock()):
            assert_equal(order_total!(["tea"]), .Ok(300))
        assert_equal(shop.calls, 3)

    it("gives up after three attempts"):
        shop := scripted({ "tea": 300 }, { "tea": 3 })
        $.with(Quotes=shop, Clock=clock()):
            assert_equal(order_total!(["tea"]), .Err(.Busy))
        assert_equal(shop.calls, 3, reason="three attempts, no more")

    it("waits about 10 ms between attempts"):
        shop := scripted({ "tea": 300 }, { "tea": 3 })
        $.with(Quotes=shop, Clock=clock()):
            assert_equal(order_total!(["tea"]), .Err(.Busy))
            assert_equal(now().unix_milliseconds(), 20, reason="two waits of 10 ms")

    it("the first failing sku in list order is the error"):
        shop := scripted({ "tea": 300 }, {})
        $.with(Quotes=shop, Clock=clock()):
            assert_equal(order_total!(["tea", "gum", "cake", "pen"]), .Err(.Unknown("gum")))

    it("a sku that needs a retry still counts toward the total"):
        shop := scripted({ "tea": 300, "cake": 450 }, { "cake": 1 })
        $.with(Quotes=shop, Clock=clock()):
            assert_equal(order_total!(["tea", "cake"]), .Ok(750))

    it("at most four quotes are in flight"):
        let (tx, rx) = channel::[bool](6)
        shop := box(Gated { gate: rx, waiting: 0, peak: 0 })
        $.with(Quotes=shop, Clock=clock()):
            pair := join!(order_total(["a", "b", "c", "d", "e", "f"]), feed(tx, 6))
            assert_equal(pair._0, .Ok(6))
        assert_equal(shop.peak, 4, reason="four quotes wait at once, not six")
