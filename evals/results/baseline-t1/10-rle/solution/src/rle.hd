## One maximal run: `count` copies of `value` in a row.
@derive(Eq, Debug)
pub struct Run:
    pub value: i32
    pub count: usize

## Run-length encodes `xs` into maximal runs: no run is empty, and
## neighbouring runs have different values.
pub fn encode(xs: List[i32]) -> List[Run]:
    let mut runs: List[Run] = []
    for x in xs:
        let n = runs.len()
        if n > 0 && runs[n - 1].value == x:
            runs[n - 1].count += 1
        else:
            runs.push(Run { value: x, count: 1 })
    runs

## Expands `runs` back into the list they encode. A run with count 0
## contributes nothing.
pub fn decode(runs: List[Run]) -> List[i32]:
    let mut out: List[i32] = []
    for run in runs:
        for _ in 0..run.count:
            out.push(run.value)
    out

tests:
    use std.testing.it_prop

    it("encodes the empty list as no runs"):
        assert_equal(encode([]), [])

    it("encodes one value as one run"):
        assert_equal(encode([7]), [Run { value: 7, count: 1 }])

    it("merges a repeated value into one run"):
        assert_equal(encode([5, 5, 5]), [Run { value: 5, count: 3 }])

    it("keeps separate runs for alternating values"):
        expected := [
            Run { value: 1, count: 1 },
            Run { value: 2, count: 1 },
            Run { value: 1, count: 2 },
        ]
        assert_equal(encode([1, 2, 1, 1]), expected)

    it("splits runs at value changes only"):
        expected := [
            Run { value: 0, count: 2 },
            Run { value: -3, count: 1 },
            Run { value: 0, count: 1 },
        ]
        assert_equal(encode([0, 0, -3, 0]), expected)

    it("decodes the empty run list as the empty list"):
        assert_equal(decode([]), [])

    it("decodes a run with count 0 as nothing"):
        assert_equal(decode([Run { value: 9, count: 0 }, Run { value: 4, count: 2 }]), [4, 4])

    it("decodes runs in order"):
        assert_equal(decode([Run { value: 1, count: 2 }, Run { value: 3, count: 1 }]), [1, 1, 3])

    it("handles extreme values"):
        xs := [-2147483647, -2147483647, 2147483647]
        assert_equal(decode(encode(xs)), xs)

    it("produces no empty runs and no equal neighbours"):
        runs := encode([4, 4, 4, 2, 2, 4])
        for run in runs:
            assert(run.count > 0)
        for i in 1..runs.len():
            assert(runs[i - 1].value != runs[i].value)

    it("counts add up to the input length"):
        xs := [1, 1, 2, 3, 3, 3]
        let total = 0
        for run in encode(xs):
            total += run.count
        assert_equal(total, xs.len())

    it_prop(
        "decoding undoes encoding for any list",
        prop=fn!(xs: List[i32]): assert_equal(decode(encode(xs)), xs)
    )

    it_prop(
        "encoding undoes decoding for any list",
        prop=fn!(xs: List[i32]): assert_equal(encode(decode(encode(xs))), encode(xs))
    )

    it_prop("runs are maximal for any list", prop=fn!(xs: List[u8]):
        runs := encode(xs.map(fn(b): i32(b % 3)))
        for run in runs:
            assert(run.count > 0)
        for i in 1..runs.len():
            assert(runs[i - 1].value != runs[i].value)
        assert_equal(decode(runs).len(), xs.len())
    )

    it_prop("runs of a small alphabet round-trip", prop=fn!(xs: List[u8]):
        ys := xs.map(fn(b): i32(b % 3))
        assert_equal(decode(encode(ys)), ys)
    )
