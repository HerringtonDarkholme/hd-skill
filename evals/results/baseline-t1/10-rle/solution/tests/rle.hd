use pkg.{Run, encode, decode}
use std.testing.assert_equal

it("round-trips through the public API"):
    xs := [3, 3, 3, 8, 0, 0]
    assert_equal(decode(encode(xs)), xs)
    assert_equal(
        encode(xs),
        [Run { value: 3, count: 3 }, Run { value: 8, count: 1 }, Run { value: 0, count: 2 }],
    )
