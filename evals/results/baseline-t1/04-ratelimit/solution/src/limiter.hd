use std.collections.Deque
use std.time.{Clock, Duration, Timestamp, now}

## A sliding-window rate limiter. Each key may have at most `max` allowed
## events within any `window`; refused events are not recorded.
pub struct Limiter:
    max: usize
    window: Duration
    events: Map[string, Deque[Timestamp]]

## A limiter allowing `max` events per key in each `window`.
pub fn new_limiter(max: usize, window: Duration) -> Limiter:
    Limiter { max: max, window: window, events: {} }

impl Limiter:
    ## Records an event for `key` now, and returns true when it is within the limit.
    pub fn allow(&mut self, key: string) -> bool $ Clock:
        current := now()
        times := self.events.get_or_insert(key, Deque::new())
        # Forget events that are no longer inside the window (now - t >= window).
        while !times.is_empty() && current.since(times.front().unwrap()) >= self.window:
            _ := times.pop_front()
        if times.len() >= self.max:
            return false
        times.push_back(current)
        true

tests:
    use std.time.{ManualClock, Timestamp, s, sleep}

    it("allows up to max events and refuses the next"):
        clock := ManualClock::new(Timestamp::from_unix_milliseconds(0))
        let mut limiter = new_limiter(2, 10s)
        $.with(Clock=clock):
            assert_equal(limiter.allow("a"), true, reason="first event")
            assert_equal(limiter.allow("a"), true, reason="second event")
            assert_equal(limiter.allow("a"), false, reason="third is over the limit")

    it("does not record refused events"):
        clock := ManualClock::new(Timestamp::from_unix_milliseconds(0))
        let mut limiter = new_limiter(1, 10s)
        $.with(Clock=clock):
            assert_equal(limiter.allow("a"), true)
            sleep!(5s)
            assert_equal(limiter.allow("a"), false, reason="refused at 5s")
            sleep!(5s)
            # At 10s the event from 0s has aged out; the refused one at 5s never counted.
            assert_equal(limiter.allow("a"), true, reason="only the 0s event was recorded")

    it("an event counts while now - t is less than the window"):
        clock := ManualClock::new(Timestamp::from_unix_milliseconds(0))
        let mut limiter = new_limiter(1, 10s)
        $.with(Clock=clock):
            assert_equal(limiter.allow("a"), true)
            sleep!(9999ms)
            assert_equal(limiter.allow("a"), false, reason="9.999s old is still inside")
            sleep!(1ms)
            assert_equal(limiter.allow("a"), true, reason="exactly 10s old has expired")

    it("the window slides, event by event"):
        clock := ManualClock::new(Timestamp::from_unix_milliseconds(0))
        let mut limiter = new_limiter(2, 10s)
        $.with(Clock=clock):
            assert_equal(limiter.allow("a"), true) # t=0
            sleep!(4s)
            assert_equal(limiter.allow("a"), true) # t=4
            sleep!(1s)
            assert_equal(limiter.allow("a"), false) # t=5: 0 and 4 both count
            sleep!(5s)
            assert_equal(limiter.allow("a"), true, reason="t=10: the event at 0 expired")
            sleep!(2s)
            assert_equal(limiter.allow("a"), false, reason="t=12: events at 4 and 10 count")
            sleep!(2s)
            assert_equal(limiter.allow("a"), true, reason="t=14: the event at 4 expired")

    it("keys are independent"):
        clock := ManualClock::new(Timestamp::from_unix_milliseconds(0))
        let mut limiter = new_limiter(1, 10s)
        $.with(Clock=clock):
            assert_equal(limiter.allow("a"), true)
            assert_equal(limiter.allow("b"), true, reason="b has its own budget")
            assert_equal(limiter.allow("a"), false)
            assert_equal(limiter.allow("b"), false)

    it("a zero limit refuses everything"):
        clock := ManualClock::new(Timestamp::from_unix_milliseconds(0))
        let mut limiter = new_limiter(0, 10s)
        $.with(Clock=clock):
            assert_equal(limiter.allow("a"), false)
