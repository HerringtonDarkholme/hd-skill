use std.cmp.max

## A line that cannot be summed.
@derive(Eq, Debug)
pub enum SumError:
    MissingColumn(line: usize)
    NotANumber(line: usize, text: string)

## The message printed to standard error for `error`, without a newline.
pub fn describe(error: SumError) -> string:
    match error:
        .MissingColumn(line) => "colsum: line $line: missing column"
        .NotANumber(line, text) => "colsum: line $line: not a number: $text"

## Sum column `value` of each row of `text`, grouped by column `key`.
## Columns are 1-based; a column 0 does not exist, so it is always missing.
## Returns one `(key, total)` pair per key, sorted by key.
pub fn summarize(
    text: string,
    key: usize,
    value: usize,
    skip_header: bool,
) -> Result[List[(string, i64)], SumError]:
    let mut totals: Map[string, i64] = {}
    let mut number: usize = 0
    for raw in text.lines():
        number += 1
        line := raw.trim()
        if !(skip_header && number == 1) && !line.is_empty():
            let (name, amount_text) = split_row(line, key, value, number)?
            match amount_text.parse::[i64]():
                .Ok(amount) => totals[name] = totals.get(name).unwrap_or(0) + amount
                .Err(_) => return .Err(.NotANumber(number, amount_text))
    .Ok(totals.entries().sorted_by_key(fn(pair): pair._0))

## The trimmed key and value texts of one non-blank row.
fn split_row(
    line: string,
    key: usize,
    value: usize,
    number: usize,
) -> Result[(string, string), SumError]:
    fields := line.split(",")
    if key == 0 || value == 0 || fields.len() < max(key, value):
        return .Err(.MissingColumn(number))
    .Ok((fields[key - 1].trim(), fields[value - 1].trim()))

tests:
    it("sums a column grouped by another, sorted by key"):
        text := "tea,3\ncake,10\ntea,4\n"
        assert_equal(summarize(text, 1, 2, false), .Ok([("cake", 10), ("tea", 7)]))

    it("reads the columns it is given"):
        text := "5,tea,a\n6,cake,b\n"
        assert_equal(summarize(text, 2, 1, false), .Ok([("cake", 6), ("tea", 5)]))

    it("skips the first line when asked"):
        text := "item,cents\ntea,3\ncake,10\n"
        assert_equal(summarize(text, 1, 2, true), .Ok([("cake", 10), ("tea", 3)]))
        assert_equal(summarize(text, 1, 2, false), .Err(.NotANumber(1, "cents")))

    it("ignores blank lines but counts them in line numbers"):
        text := "tea,1\n\n   \ncake,2\nbad,x\n"
        assert_equal(summarize(text, 1, 2, false), .Err(.NotANumber(5, "x")))
        assert_equal(
            summarize("tea,1\n\n  \ncake,2\n", 1, 2, false),
            .Ok([("cake", 2), ("tea", 1)]),
        )

    it("trims spaces from keys and values"):
        assert_equal(summarize("  tea , 4 \n tea,  -1\n", 1, 2, false), .Ok([("tea", 3)]))

    it("accepts signed values"):
        assert_equal(summarize("a,-5\na,+2\nb,-7\n", 1, 2, false), .Ok([("a", -3), ("b", -7)]))

    it("reports a line with too few columns"):
        assert_equal(summarize("a,1\nb\n", 1, 2, false), .Err(.MissingColumn(2)))
        assert_equal(summarize("a,1,2\nb,3\n", 1, 3, false), .Err(.MissingColumn(2)))

    it("reports a value that is not an integer, trimmed"):
        assert_equal(summarize("a,  1.5 \n", 1, 2, false), .Err(.NotANumber(1, "1.5")))
        assert_equal(summarize("a,\n", 1, 2, false), .Err(.NotANumber(1, "")))

    it("treats a column 0 as missing rather than panicking"):
        assert_equal(summarize("a,1\n", 0, 2, false), .Err(.MissingColumn(1)))

    it("empty input gives no totals"):
        assert_equal(summarize("", 1, 2, false), .Ok([]))
        assert_equal(summarize("\n\n", 1, 2, true), .Ok([]))

    it("describes each error with its line"):
        assert_equal(describe(.MissingColumn(3)), "colsum: line 3: missing column")
        assert_equal(describe(.NotANumber(4, "x")), "colsum: line 4: not a number: x")
