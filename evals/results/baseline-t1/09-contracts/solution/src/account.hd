use std.contract.require

## A bank account holding a balance in cents.
##
## Invariants, true after every call:
## - the balance is never negative;
## - a transfer keeps the total of the two balances.
##
## Misuse (a negative opening balance, a deposit, withdrawal or transfer
## that is not positive, or one larger than the balance) is a programming
## error: `require` panics in debug and test builds.
pub struct Account:
    cents: i64

## Opens an account with `cents` (must not be negative).
pub fn open(cents: i64) -> Account:
    require("opening balance must not be negative", fn() -> bool: cents >= 0)
    account := Account { cents: cents }
    check_balance(account.cents)
    account

## Moves `cents` (must be positive, and at most `from`'s balance) between accounts.
pub fn transfer(from: &mut Account, to: &mut Account, cents: i64) -> void:
    require("transfer must be positive", fn() -> bool: cents > 0)
    require("transfer is larger than the balance", fn() -> bool: cents <= from.cents)
    total := from.cents + to.cents
    from.cents -= cents
    to.cents += cents
    check_balance(from.cents)
    check_balance(to.cents)
    require("transfer keeps the total", fn() -> bool: from.cents + to.cents == total)

impl Account:
    ## The current balance in cents.
    pub fn balance(self) -> i64:
        self.cents

    ## Adds `cents` (must be positive).
    pub fn deposit(&mut self, cents: i64) -> void:
        require("deposit must be positive", fn() -> bool: cents > 0)
        self.cents += cents
        check_balance(self.cents)

    ## Removes `cents` (must be positive, and at most the balance).
    pub fn withdraw(&mut self, cents: i64) -> void:
        require("withdrawal must be positive", fn() -> bool: cents > 0)
        require("withdrawal is larger than the balance", fn() -> bool: cents <= self.cents)
        self.cents -= cents
        check_balance(self.cents)

## The balance is never negative.
fn check_balance(cents: i64) -> void:
    require("balance is never negative", fn() -> bool: cents >= 0)

tests:
    it("opens with the given balance"):
        assert_equal(open(1500).balance(), 1500)

    it("opens empty"):
        assert_equal(open(0).balance(), 0)

    it("deposit adds to the balance"):
        let mut account = open(100)
        account.deposit(250)
        assert_equal(account.balance(), 350)

    it("withdraw removes from the balance"):
        let mut account = open(100)
        account.withdraw(100)
        assert_equal(account.balance(), 0)

    it("withdraw may take the whole balance"):
        let mut account = open(700)
        account.withdraw(700)
        assert_equal(account.balance(), 0)

    it("transfer moves money and keeps the total"):
        let mut from = open(1000)
        let mut to = open(200)
        transfer(&mut from, &mut to, 300)
        assert_equal(from.balance(), 700)
        assert_equal(to.balance(), 500)
        assert_equal(from.balance() + to.balance(), 1200)

    it("transfer may take the whole balance"):
        let mut from = open(400)
        let mut to = open(0)
        transfer(&mut from, &mut to, 400)
        assert_equal(from.balance(), 0)
        assert_equal(to.balance(), 400)
