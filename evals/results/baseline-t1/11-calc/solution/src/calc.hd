## Why an expression could not be evaluated.
@derive(Eq, Debug)
pub enum CalcError:
    DivideByZero
    ## The byte offset of the first token the grammar cannot accept there,
    ## or the input length when the input ends too early.
    Unexpected(at: usize)

## A lexical token. `Invalid` is a character or number no token can be made
## from; the parser never accepts it, so it fails there.
enum Token:
    Num(value: i64)
    Plus
    Minus
    Star
    Slash
    LParen
    RParen
    Invalid
    End

## A token and the byte offset where it starts.
struct Lexeme:
    token: Token
    at: usize

## An arithmetic operator.
enum Op:
    Add
    Sub
    Mul
    Div

## The syntax tree of an expression.
enum Expr:
    Num(value: i64)
    Neg(operand: *Expr)
    Binary(op: Op, left: *Expr, right: *Expr)

## Splits `src` into tokens. The list always ends with `End`, or with the
## first `Invalid` token, which stops the scan.
fn lex(src: string) -> List[Lexeme]:
    let items: List[(usize, char)] = src.char_indices().collect()
    let mut tokens: List[Lexeme] = []
    let i: usize = 0
    while i < items.len():
        at := items[i]._0
        c := items[i]._1
        if c == ' ':
            i += 1
        else if c.is_ascii_digit():
            let j = i + 1
            while j < items.len() && items[j]._1.is_ascii_digit():
                j += 1
            end := if j < items.len(): items[j]._0 else: src.len()
            match src.slice(at, end).parse::[i64]():
                .Ok(value) =>
                    tokens.push(Lexeme { token: .Num(value), at: at })
                    i = j
                .Err(_) =>
                    tokens.push(Lexeme { token: .Invalid, at: at })
                    break
        else:
            match symbol(c):
                .Some(token) =>
                    tokens.push(Lexeme { token: token, at: at })
                    i += 1
                .None =>
                    tokens.push(Lexeme { token: .Invalid, at: at })
                    break
    tokens.push(Lexeme { token: .End, at: src.len() })
    tokens

fn symbol(c: char) -> Token?:
    match c:
        '+' => .Some(.Plus)
        '-' => .Some(.Minus)
        '*' => .Some(.Star)
        '/' => .Some(.Slash)
        '(' => .Some(.LParen)
        ')' => .Some(.RParen)
        _ => .None

fn sum_op(token: Token) -> Op?:
    match token:
        .Plus => .Some(Op.Add)
        .Minus => .Some(Op.Sub)
        _ => .None

fn product_op(token: Token) -> Op?:
    match token:
        .Star => .Some(Op.Mul)
        .Slash => .Some(Op.Div)
        _ => .None

## A recursive-descent parser over the token list.
##
##     sum     = product { ("+" | "-") product }
##     product = unary { ("*" | "/") unary }
##     unary   = "-" unary | primary
##     primary = NUMBER | "(" sum ")"
struct Parser:
    tokens: List[Lexeme]
    at: usize

impl Parser:
    fn peek(&self) -> Token:
        self.tokens[self.at].token

    fn advance(&mut self) -> void:
        self.at += 1

    fn unexpected(&self) -> CalcError:
        .Unexpected(self.tokens[self.at].at)

    fn sum(&mut self) -> Result[Expr, CalcError]:
        let left = self.product()?
        while true:
            let .Some(op) = sum_op(self.peek()) else:
                break
            self.advance()
            let right = self.product()?
            left = Expr.Binary(op, box(left), box(right))
        .Ok(left)

    fn product(&mut self) -> Result[Expr, CalcError]:
        let left = self.unary()?
        while true:
            let .Some(op) = product_op(self.peek()) else:
                break
            self.advance()
            let right = self.unary()?
            left = Expr.Binary(op, box(left), box(right))
        .Ok(left)

    fn unary(&mut self) -> Result[Expr, CalcError]:
        match self.peek():
            .Minus =>
                self.advance()
                operand := self.unary()?
                .Ok(Expr.Neg(box(operand)))
            _ => self.primary()

    fn primary(&mut self) -> Result[Expr, CalcError]:
        match self.peek():
            .Num(value) =>
                self.advance()
                .Ok(Expr.Num(value))
            .LParen =>
                self.advance()
                inner := self.sum()?
                self.close()?
                .Ok(inner)
            _ => .Err(self.unexpected())

    fn close(&mut self) -> Result[void, CalcError]:
        match self.peek():
            .RParen =>
                self.advance()
                .Ok(())
            _ => .Err(self.unexpected())

## Parses all of `src` as one expression.
fn parse_expr(src: string) -> Result[Expr, CalcError]:
    let mut parser = Parser { tokens: lex(src), at: 0 }
    tree := parser.sum()?
    match parser.peek():
        .End => .Ok(tree)
        _ => .Err(parser.unexpected())

## Evaluates a tree. Arithmetic wraps on overflow instead of panicking.
fn evaluate(e: &Expr) -> Result[i64, CalcError]:
    match e:
        .Num(value) => .Ok(value)
        .Neg(operand) =>
            value := evaluate(operand)?
            .Ok(i64(0).wrapping_sub(value))
        .Binary(op, left, right) =>
            a := evaluate(left)?
            b := evaluate(right)?
            match op:
                .Add => .Ok(a.wrapping_add(b))
                .Sub => .Ok(a.wrapping_sub(b))
                .Mul => .Ok(a.wrapping_mul(b))
                .Div => divide(a, b)

## Integer division truncating toward zero.
fn divide(a: i64, b: i64) -> Result[i64, CalcError]:
    if b == 0: .Err(.DivideByZero) else if b == -1: .Ok(i64(0).wrapping_sub(a)) else: .Ok(a / b)

## Evaluates the integer expression `src`: decimal integers, `+ - * /`,
## parentheses and unary minus, with spaces between tokens. Division
## truncates toward zero.
pub fn eval(src: string) -> Result[i64, CalcError]:
    tree := parse_expr(src)?
    evaluate(&tree)

tests:
    it("adds and subtracts left to right"):
        assert_equal(eval("10 - 4 - 3"), .Ok(3))
        assert_equal(eval("1 + 2 - 3 + 4"), .Ok(4))

    it("multiplies and divides before adding"):
        assert_equal(eval("1 + 2 * 3"), .Ok(7))
        assert_equal(eval("2 * 3 + 4 * 5"), .Ok(26))
        assert_equal(eval("100 / 10 / 5"), .Ok(2))
        assert_equal(eval("20 / 2 * 3"), .Ok(30))

    it("divides with truncation toward zero"):
        assert_equal(eval("7 / 2"), .Ok(3))
        assert_equal(eval("-7 / 2"), .Ok(-3))
        assert_equal(eval("7 / -2"), .Ok(-3))

    it("honours parentheses"):
        assert_equal(eval("(1 + 2) * 3"), .Ok(9))
        assert_equal(eval("((7))"), .Ok(7))
        assert_equal(eval("2 * (3 + (4 - 1)) / 3"), .Ok(4))

    it("applies unary minus"):
        assert_equal(eval("-5"), .Ok(-5))
        assert_equal(eval("- -4"), .Ok(4))
        assert_equal(eval("2 * -3"), .Ok(-6))
        assert_equal(eval("-(2 + 3) * 2"), .Ok(-10))

    it("ignores spaces between tokens"):
        assert_equal(eval("  ( 1+2 )*3 "), .Ok(9))
        assert_equal(eval("1234"), .Ok(1234))

    it("reports division by zero"):
        assert_equal(eval("1 / 0"), .Err(.DivideByZero))
        assert_equal(eval("1 / (2 - 2)"), .Err(.DivideByZero))

    it("reports a parse error before evaluating"):
        assert_equal(eval("1 / 0 +"), .Err(.Unexpected(7)))

    it("reports where the input ends too early"):
        assert_equal(eval("1 +"), .Err(.Unexpected(3)))
        assert_equal(eval(""), .Err(.Unexpected(0)))
        assert_equal(eval("(1"), .Err(.Unexpected(2)))
        assert_equal(eval("-"), .Err(.Unexpected(1)))

    it("reports the first token that cannot follow"):
        assert_equal(eval("1 2"), .Err(.Unexpected(2)))
        assert_equal(eval("1)"), .Err(.Unexpected(1)))
        assert_equal(eval("*2"), .Err(.Unexpected(0)))
        assert_equal(eval("()"), .Err(.Unexpected(1)))

    it("reports an invalid character at its offset"):
        assert_equal(eval("1 $ 2"), .Err(.Unexpected(2)))
        assert_equal(eval("1 2 $"), .Err(.Unexpected(2)))
        assert_equal(eval("1 + é"), .Err(.Unexpected(4)))

    it("reports a number too large for i64"):
        assert_equal(eval("9223372036854775808"), .Err(.Unexpected(0)))
        assert_equal(eval("1 + 99999999999999999999"), .Err(.Unexpected(4)))
        assert_equal(eval("9223372036854775807"), .Ok(9223372036854775807))

    it("wraps on overflow"):
        assert_equal(eval("9223372036854775807 + 1"), .Ok(i64(-9223372036854775807) - 1))
        assert_equal(eval("-(0 - 9223372036854775807 - 1)"), .Ok(i64(-9223372036854775807) - 1))
