## The names of a struct's fields, in declaration order.
pub trait FieldNames:
    fn field_names(self) -> List[string]

tests:
    struct Pair:
        a: i32
        b: i32

    impl FieldNames for Pair:
        fn field_names(self) -> List[string]:
            ["a", "b"]

    it("a hand-written implementation returns the names in order"):
        assert_equal(Pair { a: 1, b: 2 }.field_names(), ["a", "b"])
