@derive(Eq, Debug)
pub struct User:
    pub id: i64
    pub name: string

@derive(Eq, Debug)
pub enum UserError:
    NotFound(id: i64)
    EmptyName

pub trait UserStore:
    fn get!(&mut self, id: i64) -> User?
    fn put!(&mut self, user: User) -> void

## Renames user `id` to `name` with surrounding spaces trimmed. Nothing is
## stored unless the name is non-empty and the user exists.
pub fn rename!(id: i64, name: string) -> Result[User, UserError] $ UserStore:
    trimmed := name.trim()
    if trimmed.is_empty():
        return .Err(.EmptyName)
    store := $.use(UserStore)
    match store.get!(id):
        .None => .Err(.NotFound(id))
        .Some(user) =>
            renamed := User { ...user, name: trimmed }
            store.put!(renamed)
            .Ok(renamed)

tests:
    struct FakeStore:
        users: Map[i64, User]
        saved: List[User]

    impl UserStore for FakeStore:
        fn get!(&mut self, id: i64) -> User?:
            self.users.get(id)
        fn put!(&mut self, user: User) -> void:
            self.saved.push(user)
            self.users[user.id] = user

    it("trims the name and stores the renamed user once"):
        store := box(FakeStore { users: { 1: User { id: 1, name: "ada" } }, saved: [] })
        $.with(UserStore=store):
            result := rename!(1, "  Ada Lovelace  ")
            assert_equal(result, .Ok(User { id: 1, name: "Ada Lovelace" }))
        assert_equal(store.saved, [User { id: 1, name: "Ada Lovelace" }], reason="one put")

    it("rejects a blank name and stores nothing"):
        store := box(FakeStore { users: { 1: User { id: 1, name: "ada" } }, saved: [] })
        $.with(UserStore=store):
            assert_equal(rename!(1, "   "), .Err(.EmptyName))
        assert_equal(store.saved.len(), 0, reason="no put on EmptyName")

    it("reports a missing user and stores nothing"):
        store := box(FakeStore { users: { 1: User { id: 1, name: "ada" } }, saved: [] })
        $.with(UserStore=store):
            assert_equal(rename!(2, "Grace"), .Err(.NotFound(2)))
        assert_equal(store.saved.len(), 0, reason="no put on NotFound")
