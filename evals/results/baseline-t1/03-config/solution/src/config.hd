use std.encoding.Deserialize
use std.encoding.json.{JsonError, decode}
use std.fs.{FsError, FsRead, FsWrite, MemoryFs, read_text, write_text}
use std.host.{Env, HostError, ScriptedEnv, env_as}
use std.path.Path
use std.validate.{Validate, ValidationError, length, range}

# A service's settings, read from a JSON file and overridable by APP_PORT.
@derive(Deserialize, Validate, Eq, Debug)
pub struct Config:
    @length(1, 253)
    pub host: string
    @range(1024, 65535)
    pub port: i32
    @range(1, 64)
    pub workers: i32 = 4

@error
pub enum ConfigError:
    @error("cannot read the config file: $error")
    Read(
        @from
        error: FsError,
    )
    @error("the config file is not valid JSON: $error")
    Parse(
        @from
        error: JsonError,
    )
    @error("$error")
    Environment(
        @from
        error: HostError,
    )
    @error("$error")
    Invalid(
        @from
        error: ValidationError,
    )

# Reads the JSON file at `path`, applies an `APP_PORT` override, then checks
# the rules on the fields. The override is checked too.
pub fn load_config!(path: string) -> Result[Config, ConfigError] $ FsRead + Env:
    text := read_text!(Path(path))?
    config := decode::[Config](text)?
    port := env_as::[i32]("APP_PORT")?
    overridden := Config { ...config, port: port.unwrap_or(config.port) }
    .Ok(overridden.validated()?)

fn kind(error: ConfigError) -> string:
    match error:
        .Read(_) => "Read"
        .Parse(_) => "Parse"
        .Environment(_) => "Environment"
        .Invalid(_) => "Invalid"

# Writes `text` to config.json in a fake file system, then loads it with the
# given environment variables.
fn load_from!(text: string, variables: Map[string, string]) -> Result[Config, ConfigError]:
    fs := MemoryFs::new()
    $.with(FsWrite=fs):
        _ := write_text!(Path("config.json"), text)
    $.with(FsRead=fs, Env=box(ScriptedEnv::new(variables))):
        return load_config!("config.json")

tests:
    it("reads every field and defaults workers to 4"):
        config := load_from!("{\"host\": \"example.com\", \"port\": 8080}", {})
            .ok()
            .expect("a valid config")
        assert_equal(config, Config { host: "example.com", port: 8080, workers: 4 })

    it("lets APP_PORT replace the port"):
        config := load_from!(
            "{\"host\": \"example.com\", \"port\": 8080, \"workers\": 2}",
            { "APP_PORT": "9000" },
        )
            .ok()
            .expect("a valid config")
        assert_equal(config, Config { host: "example.com", port: 9000, workers: 2 })

    it("reports a missing file as Read"):
        fs := MemoryFs::new()
        $.with(FsRead=fs, Env=box(ScriptedEnv::new({}))):
            error := load_config!("missing.json").err().expect("an error")
            assert_equal(kind(error), "Read")

    it("reports invalid JSON as Parse"):
        error := load_from!("{\"host\": ", {}).err().expect("an error")
        assert_equal(kind(error), "Parse")

    it("reports a missing required field as Parse"):
        error := load_from!("{\"port\": 8080}", {}).err().expect("an error")
        assert_equal(kind(error), "Parse")

    it("reports a non-integer APP_PORT as Environment"):
        error := load_from!("{\"host\": \"example.com\", \"port\": 8080}", { "APP_PORT": "http" })
            .err()
            .expect("an error")
        assert_equal(kind(error), "Environment")

    it("reports a port below 1024 as Invalid"):
        error := load_from!("{\"host\": \"example.com\", \"port\": 80}", {})
            .err()
            .expect("an error")
        assert_equal(kind(error), "Invalid")

    it("reports a port above 65535 as Invalid"):
        error := load_from!("{\"host\": \"example.com\", \"port\": 65536}", {})
            .err()
            .expect("an error")
        assert_equal(kind(error), "Invalid")

    it("checks an overridden port too"):
        error := load_from!("{\"host\": \"example.com\", \"port\": 8080}", { "APP_PORT": "80" })
            .err()
            .expect("an error")
        assert_equal(kind(error), "Invalid")

    it("accepts the port and worker bounds"):
        config := load_from!("{\"host\": \"h\", \"port\": 1024, \"workers\": 64}", {})
            .ok()
            .expect("a valid config")
        assert_equal(config, Config { host: "h", port: 1024, workers: 64 })

    it("rejects workers of 0"):
        error := load_from!("{\"host\": \"h\", \"port\": 8080, \"workers\": 0}", {})
            .err()
            .expect("an error")
        assert_equal(kind(error), "Invalid")

    it("rejects workers of 65"):
        error := load_from!("{\"host\": \"h\", \"port\": 8080, \"workers\": 65}", {})
            .err()
            .expect("an error")
        assert_equal(kind(error), "Invalid")

    it("rejects an empty host"):
        error := load_from!("{\"host\": \"\", \"port\": 8080}", {}).err().expect("an error")
        assert_equal(kind(error), "Invalid")

    it("accepts a host of 253 characters"):
        long := "a".repeat(253)
        config := load_from!("{\"host\": \"${long}\", \"port\": 8080}", {})
            .ok()
            .expect("a valid config")
        assert_equal(config.host.len(), 253)

    it("rejects a host of 254 characters"):
        long := "a".repeat(254)
        error := load_from!("{\"host\": \"${long}\", \"port\": 8080}", {}).err().expect("an error")
        assert_equal(kind(error), "Invalid")
