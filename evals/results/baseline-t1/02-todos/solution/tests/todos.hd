use pkg.{Todo, TodoError, complete, dump, load, pending}
use std.testing.assert_equal

it("the public interface loads, completes and lists"):
    match load("[{\"id\": 4, \"title\": \"walk dog\"}, {\"id\": 5, \"title\": \"read\"}]"):
        .Ok(todos) =>
            assert_equal(todos[0].done, false)
            assert_equal(todos[0].id, 4)
            match complete(todos, 4):
                .Ok(done) =>
                    assert_equal(pending(done), ["read"])
                    assert_equal(load(dump(done)), .Ok(done))
                .Err(_) => panic("id 4 exists")
        .Err(_) => panic("valid list")

it("the public error values compare and print"):
    assert_equal(complete([], 3), .Err(.UnknownId(3)))
    assert(debug(TodoError.BadJson("x")).len() > 0)
    assert(Todo { id: 1, title: "a" } != Todo { id: 1, title: "a", done: true })
