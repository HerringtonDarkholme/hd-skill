use std.meta.{Field, Structure, Variant, Walker}
use std.testing.assert_equal

## The names of a struct's fields, in declaration order.
## `@derive(FieldNames)` works on any struct, with no per-type `impl`.
pub trait FieldNames:
    fn field_names(self) -> List[string]

# The walker the template drives: it records one name per field.
struct CollectNames:
    names: List[string]

impl[S] Walker[S] for CollectNames:
    type Error = void

    fn data_variant(&mut self, v: Variant[S]) -> Result[void, void]:
        .Ok(())

    fn variant(&mut self, v: Variant[S]) -> Result[void, void]:
        .Ok(())

    fn data_member[F](&mut self, h: Field[S, F], value: &F) -> Result[void, void]:
        self.names.push(h.info.name)
        .Ok(())

    fn member[F](&mut self, h: Field[S, F], value: &F) -> Result[void, void]:
        self.data_member(h, value)

    fn rest[T](&mut self, h: Field[S, List[T]], items: &List[T]) -> Result[void, void]:
        self.names.push(h.info.name)
        .Ok(())

# The template: each `@derive(FieldNames)` instantiates it for that type.
impl[T] FieldNames for T by Structure:
    fn field_names(self) -> List[string]:
        let mut collect = CollectNames { names: [] }
        _ := Structure::walk(&self, &mut collect)
        collect.names

@derive(FieldNames)
struct Sample:
    first: string
    second: i32

tests:
    it("derives the field names of a struct in this module"):
        assert_equal(Sample { first: "a", second: 1 }.field_names(), ["first", "second"])
