## Run-length encoding of integer lists.
##
## `encode` turns a list into maximal runs: no run is empty, and neighbouring
## runs hold different values. `decode` expands runs back into the list.

## One run: `count` copies of `value` in a row.
@derive(Eq, Debug)
pub struct Run:
    pub value: i32
    pub count: usize

## The maximal runs of `xs`, in order. An empty list has no runs.
pub fn encode(xs: List[i32]) -> List[Run]:
    let mut runs: List[Run] = []
    let value: i32 = 0
    let count: usize = 0
    for x in xs:
        if count > 0 && x == value:
            count += 1
        else:
            if count > 0:
                runs.push(Run { value: value, count: count })
            value = x
            count = 1
    if count > 0:
        runs.push(Run { value: value, count: count })
    runs

## The list that `runs` stands for, each run written out in full.
pub fn decode(runs: List[Run]) -> List[i32]:
    let mut xs: List[i32] = []
    for run in runs:
        for _ in 0..run.count:
            xs.push(run.value)
    xs

## Maps each element to `x % 3`, so generated lists contain long runs.
fn small_alphabet(xs: List[i32]) -> List[i32]:
    let mut out: List[i32] = []
    for x in xs:
        out.push(x % 3)
    out

## True when no run is empty and neighbouring runs differ in value.
fn is_maximal(runs: List[Run]) -> bool:
    for run in runs:
        if run.count == 0:
            return false
    for i in 1..runs.len():
        if runs[i - 1].value == runs[i].value:
            return false
    true

## The total length of the runs.
fn total_count(runs: List[Run]) -> usize:
    let total: usize = 0
    for run in runs:
        total += run.count
    total

tests:
    use std.testing.it_prop

    it("encodes an empty list as no runs"):
        assert_equal(encode([]), [])

    it("encodes one element as one run of one"):
        assert_equal(encode([7]), [Run { value: 7, count: 1 }])

    it("groups equal neighbours into one run"):
        assert_equal(
            encode([1, 1, 1, 2, 2, 1]),
            [Run { value: 1, count: 3 }, Run { value: 2, count: 2 }, Run { value: 1, count: 1 }],
        )

    it("keeps values that differ from their neighbours apart"):
        assert_equal(
            encode([1, 2, 3]),
            [Run { value: 1, count: 1 }, Run { value: 2, count: 1 }, Run { value: 3, count: 1 }],
        )

    it("handles negative values and zero"):
        assert_equal(
            encode([-5, -5, 0, 0, 0]),
            [Run { value: -5, count: 2 }, Run { value: 0, count: 3 }],
        )

    it("does not merge a run that returns after a different value"):
        assert_equal(
            encode([4, 4, 9, 4]),
            [Run { value: 4, count: 2 }, Run { value: 9, count: 1 }, Run { value: 4, count: 1 }],
        )

    it("decodes no runs as the empty list"):
        let empty: List[Run] = []
        assert_equal(decode(empty), [])

    it("decodes runs in order"):
        assert_equal(
            decode([Run { value: 1, count: 3 }, Run { value: 2, count: 2 }]),
            [1, 1, 1, 2, 2],
        )

    it("decodes a long run in full"):
        assert_equal(decode([Run { value: 0, count: 1000 }]).len(), 1000)

    it("round-trips the example lists"):
        for xs in [[], [0], [5, 5, 5, 5], [1, 2, 1, 2], [-1, -1, 3, 3, 3, 0, 0]]:
            assert_equal(decode(encode(xs)), xs)

    it_prop(
        "decode undoes encode for any list",
        prop=fn!(xs: List[i32]): assert_equal(decode(encode(xs)), xs)
    )

    it_prop("decode undoes encode for lists with long runs", prop=fn!(xs: List[i32]):
        let ys = small_alphabet(xs)
        assert_equal(decode(encode(ys)), ys)
    )

    it_prop("encode gives maximal runs", prop=fn!(xs: List[i32]): assert(is_maximal(encode(xs))))

    it_prop(
        "encode gives maximal runs for lists with long runs",
        prop=fn!(xs: List[i32]): assert(is_maximal(encode(small_alphabet(xs))))
    )

    it_prop(
        "run counts add up to the list length",
        prop=fn!(xs: List[i32]): assert_equal(total_count(encode(xs)), xs.len())
    )

    it_prop(
        "encode never yields more runs than elements",
        prop=fn!(xs: List[i32]): assert(encode(xs).len() <= xs.len())
    )

    it_prop("encoding a decoded list gives back the same runs", prop=fn!(xs: List[i32]):
        let runs = encode(small_alphabet(xs))
        assert_equal(encode(decode(runs)), runs)
    )
