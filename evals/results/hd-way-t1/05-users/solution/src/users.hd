@derive(Eq, Debug)
pub struct User:
    pub id: i64
    pub name: string

@error
@derive(Eq, Debug)
pub enum UserError:
    @error("no user $id")
    NotFound(id: i64)
    @error("name is empty")
    EmptyName

pub trait UserStore:
    fn get!(&mut self, id: i64) -> User?
    fn put!(&mut self, user: User) -> void

## Renames user `id` to `name` (trimmed) and stores the renamed user once.
pub fn rename!(id: i64, name: string) -> Result[User, UserError] $ UserStore:
    trimmed := name.trim()
    if trimmed.is_empty():
        return .Err(.EmptyName)
    store := $.use(UserStore)
    match store.get!(id):
        .None => .Err(.NotFound(id))
        .Some(user) =>
            renamed := User { id: user.id, name: trimmed }
            store.put!(renamed)
            .Ok(renamed)

tests:
    struct FakeStore:
        users: Map[i64, User]
        puts: usize

    impl UserStore for FakeStore:
        fn get!(&mut self, id: i64) -> User?:
            self.users.get(id)

        fn put!(&mut self, user: User) -> void:
            self.puts += 1
            self.users[user.id] = user

    it("renames a user and stores it once"):
        fake := box(FakeStore { users: { 1: User { id: 1, name: "ada" } }, puts: 0 })
        $.with(UserStore=fake):
            result := rename!(1, "Ada Lovelace")
            assert_equal(result, .Ok(User { id: 1, name: "Ada Lovelace" }))
        assert_equal(fake.puts, 1, reason="one put")
        assert_equal(fake.users[1], User { id: 1, name: "Ada Lovelace" })

    it("trims surrounding whitespace before storing"):
        fake := box(FakeStore { users: { 1: User { id: 1, name: "ada" } }, puts: 0 })
        $.with(UserStore=fake):
            assert_equal(rename!(1, "  Grace \t"), .Ok(User { id: 1, name: "Grace" }))
        assert_equal(fake.users[1].name, "Grace", reason="the stored name is trimmed")

    it("refuses an empty name and stores nothing"):
        fake := box(FakeStore { users: { 1: User { id: 1, name: "ada" } }, puts: 0 })
        $.with(UserStore=fake):
            assert_equal(rename!(1, "   "), .Err(.EmptyName))
        assert_equal(fake.puts, 0, reason="no put")
        assert_equal(fake.users[1].name, "ada", reason="unchanged")

    it("reports a missing user and stores nothing"):
        fake := box(FakeStore { users: { 1: User { id: 1, name: "ada" } }, puts: 0 })
        $.with(UserStore=fake):
            assert_equal(rename!(2, "Grace"), .Err(.NotFound(2)))
        assert_equal(fake.puts, 0, reason="no put")
        assert_equal(fake.users.len(), 1, reason="no user added")

    it("prints the error messages"):
        let missing: UserError = .NotFound(2)
        let empty: UserError = .EmptyName
        assert_equal("$missing", "no user 2")
        assert_equal("$empty", "name is empty")
