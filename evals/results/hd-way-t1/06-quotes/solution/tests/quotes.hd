use pkg.{QuoteError, Quotes, order_total}
use std.time.{Clock, ManualClock, Timestamp}

struct Shop:
    calls: usize

impl Quotes for Shop:
    fn quote!(&mut self, sku: string) -> Result[i64, QuoteError]:
        self.calls += 1
        if sku == "sold-out":
            return .Err(.Unknown(sku))
        .Ok(250)

it("totals an order through the public API"):
    shop := box(Shop { calls: 0 })
    clock := ManualClock::new(Timestamp::from_unix_milliseconds(0))
    $.with(Quotes=shop, Clock=clock):
        assert_equal(order_total!(["a", "b"]), .Ok(500))
    assert_equal(shop.calls, 2)

it("reports the failing sku"):
    shop := box(Shop { calls: 0 })
    clock := ManualClock::new(Timestamp::from_unix_milliseconds(0))
    $.with(Quotes=shop, Clock=clock):
        assert_equal(order_total!(["a", "sold-out"]), .Err(.Unknown("sold-out")))
