use std.task.{Backoff, apply, map_join, retry}
use std.time.{Clock, ms}

## Why a quote failed.
@derive(Eq, Debug)
pub enum QuoteError:
    Busy
    Unknown(sku: string)

## A service that prices one sku.
pub trait Quotes:
    fn quote!(&mut self, sku: string) -> Result[i64, QuoteError]

## One sku's price: up to 3 attempts, about 10 ms apart.
fn quote_one!(sku: string) -> Result[i64, QuoteError] $ Quotes + Clock:
    policy := retry(Backoff { attempts: 3, initial: 10ms, factor: 1 })
    apply!(policy):
        $.use(Quotes).quote!(sku)

## Sums the prices of `skus`, quoting at most 4 at a time. The error, if any,
## is that of the first failing sku in list order.
pub fn order_total!(skus: List[string]) -> Result[i64, QuoteError] $ Quotes + Clock:
    results := map_join!(skus, 4, quote_one)
    let total: i64 = 0
    for result in results:
        total += result?
    .Ok(total)

tests:
    use std.time.{ManualClock, Timestamp}

    # Fails `busy_left` calls with Busy, then prices every sku except
    # those in `unknown` as its length times 100.
    struct Fake:
        busy_left: usize
        unknown: List[string]
        calls: usize

    impl Quotes for Fake:
        fn quote!(&mut self, sku: string) -> Result[i64, QuoteError]:
            self.calls += 1
            if self.busy_left > 0:
                self.busy_left -= 1
                return .Err(.Busy)
            if self.unknown.contains(&sku):
                return .Err(.Unknown(sku))
            .Ok(i64(sku.len()) * 100)

    fn clock() -> *mut ManualClock:
        ManualClock::new(Timestamp::from_unix_milliseconds(0))

    it("an empty order totals zero"):
        fake := box(Fake { busy_left: 0, unknown: [], calls: 0 })
        $.with(Quotes=fake, Clock=clock()):
            assert_equal(order_total!([]), .Ok(0))
        assert_equal(fake.calls, 0)

    it("sums every sku's price"):
        fake := box(Fake { busy_left: 0, unknown: [], calls: 0 })
        $.with(Quotes=fake, Clock=clock()):
            assert_equal(order_total!(["tea", "cake", "jam"]), .Ok(1000))
        assert_equal(fake.calls, 3)

    it("sums more skus than the 4 in flight at a time"):
        fake := box(Fake { busy_left: 0, unknown: [], calls: 0 })
        skus := ["a", "bb", "ccc", "dddd", "eeeee", "ffffff"]
        $.with(Quotes=fake, Clock=clock()):
            assert_equal(order_total!(skus), .Ok(2100))
        assert_equal(fake.calls, 6)

    it("retries a busy sku and then counts its price"):
        fake := box(Fake { busy_left: 2, unknown: [], calls: 0 })
        $.with(Quotes=fake, Clock=clock()):
            assert_equal(order_total!(["tea"]), .Ok(300))
        assert_equal(fake.calls, 3, reason="two busy answers, then a price")

    it("gives up after 3 attempts with the last error"):
        fake := box(Fake { busy_left: 3, unknown: [], calls: 0 })
        $.with(Quotes=fake, Clock=clock()):
            assert_equal(order_total!(["tea"]), .Err(.Busy))
        assert_equal(fake.calls, 3, reason="exactly 3 attempts")

    it("reports the first failing sku in list order"):
        fake := box(Fake { busy_left: 0, unknown: ["bad1", "bad2"], calls: 0 })
        $.with(Quotes=fake, Clock=clock()):
            assert_equal(order_total!(["tea", "bad1", "cake", "bad2"]), .Err(.Unknown("bad1")))
        assert_equal(fake.calls, 8, reason="priced skus once, failing skus 3 times each")

    it("a failing sku fails the whole order even after successes"):
        fake := box(Fake { busy_left: 0, unknown: ["bad"], calls: 0 })
        $.with(Quotes=fake, Clock=clock()):
            assert_equal(order_total!(["tea", "bad"]), .Err(.Unknown("bad")))
