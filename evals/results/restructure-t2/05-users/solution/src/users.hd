## A user account: an id and a display name.
@derive(Eq, Debug)
pub struct User:
    pub id: i64
    pub name: string

## Why a rename failed.
@error
@derive(Eq, Debug)
pub enum UserError:
    @error("no user $id")
    NotFound(id: i64)
    @error("name is empty")
    EmptyName

## Where users live. The caller provides one.
pub trait UserStore:
    fn get!(&mut self, id: i64) -> User?
    fn put!(&mut self, user: User) -> void

## Rename user `id` to `name`, with surrounding spaces trimmed.
## Stores the renamed user once, and returns it.
pub fn rename!(id: i64, name: string) -> Result[User, UserError] $ UserStore:
    trimmed := name.trim()
    if trimmed.is_empty():
        return .Err(.EmptyName)
    let .Some(user) = $.use(UserStore).get!(id) else:
        return .Err(.NotFound(id))
    renamed := User { id: user.id, name: trimmed }
    $.use(UserStore).put!(renamed)
    .Ok(renamed)

tests:
    use std.testing.it_each

    struct CountingStore:
        users: Map[i64, User]
        puts: i64

    impl UserStore for CountingStore:
        fn get!(&mut self, id: i64) -> User?:
            self.users.get(id)

        fn put!(&mut self, user: User) -> void:
            self.puts += 1
            self.users[user.id] = user

    fn store_with_ada() -> CountingStore:
        CountingStore { users: { 1: User { id: 1, name: "ada" } }, puts: 0 }

    it("renames a user and stores it once"):
        store := box(store_with_ada())
        $.with(UserStore=store):
            assert_equal(rename!(1, "Ada Lovelace"), .Ok(User { id: 1, name: "Ada Lovelace" }))
        assert_equal(store.puts, 1)
        assert_equal(store.users.get(1), .Some(User { id: 1, name: "Ada Lovelace" }))

    it("trims the new name before storing it"):
        store := box(store_with_ada())
        $.with(UserStore=store):
            assert_equal(rename!(1, "  Grace  "), .Ok(User { id: 1, name: "Grace" }))
        assert_equal(store.users.get(1), .Some(User { id: 1, name: "Grace" }))

    fn blank_name_case!(name: string) -> void:
        store := box(store_with_ada())
        $.with(UserStore=store):
            assert_equal(rename!(1, name), .Err(.EmptyName))
        assert_equal(store.puts, 0)
        assert_equal(store.users.get(1), .Some(User { id: 1, name: "ada" }))

    it_each("a blank name is EmptyName and stores nothing", ["", " ", "\t  "], body=blank_name_case)

    it("a missing user is NotFound and stores nothing"):
        store := box(store_with_ada())
        $.with(UserStore=store):
            assert_equal(rename!(2, "Grace"), .Err(.NotFound(2)))
        assert_equal(store.puts, 0)
        assert_equal(store.users.get(2), .None)

    it("the error messages name the problem"):
        assert_equal("${UserError.NotFound(2)}", "no user 2")
        assert_equal("${UserError.EmptyName}", "name is empty")
