use std.contract.{ensure, require}
use std.num.Integer

## An account holding a balance in cents. The balance is never negative.
pub struct Account:
    balance: i64

## Opens an account holding `cents`. The opening balance is not negative.
pub fn open(cents: i64) -> Account:
    require("an opening balance is not negative"):
        cents >= 0
    account := Account { balance: cents }
    ensure("the balance is never negative"):
        account.balance >= 0
    account

## Moves `cents` from `source` to `target`. The total held by the two accounts
## stays the same.
pub fn transfer(source: &mut Account, target: &mut Account, cents: i64) -> void:
    require("a transfer is positive"):
        cents > 0
    require("a transfer is not larger than the source balance"):
        cents <= source.balance
    require("a transfer does not overflow the target balance"):
        cents <= i64::max_value() - target.balance
    source_before := source.balance
    target_before := target.balance
    source.withdraw(cents)
    target.deposit(cents)
    ensure("the money leaving the source is the money arriving at the target"):
        source_before - source.balance == cents && target.balance - target_before == cents

impl Account:
    ## The current balance in cents.
    pub fn balance(self) -> i64:
        self.balance

    ## Adds `cents` to the balance.
    pub fn deposit(&mut self, cents: i64) -> void:
        require("a deposit is positive"):
            cents > 0
        require("a deposit does not overflow the balance"):
            cents <= i64::max_value() - self.balance
        before := self.balance
        self.balance += cents
        ensure("a deposit adds exactly what was deposited"):
            self.balance - before == cents
        ensure("the balance is never negative"):
            self.balance >= 0

    ## Takes `cents` out of the balance.
    pub fn withdraw(&mut self, cents: i64) -> void:
        require("a withdrawal is positive"):
            cents > 0
        require("a withdrawal is not larger than the balance"):
            cents <= self.balance
        before := self.balance
        self.balance -= cents
        ensure("a withdrawal takes out exactly what was withdrawn"):
            before - self.balance == cents
        ensure("the balance is never negative"):
            self.balance >= 0

tests:
    use std.testing.{Choices, it_prop_with}

    fn two_amounts(c: &mut Choices) -> (i64, i64):
        (c.int(0..=1_000_000), c.int(1..=1_000_000))

    fn transfer_case(c: &mut Choices) -> (i64, i64, i64):
        source := c.int(0..=1_000_000)
        target := c.int(0..=1_000_000)
        cents := c.int(1..=1_000_000)
        c.assume(cents <= source)
        (source, target, cents)

    it("opens with the given balance"):
        assert_equal(open(1250).balance(), 1250)

    it("opens with an empty balance"):
        assert_equal(open(0).balance(), 0)

    it("refuses a negative opening balance", expect_panic="explicit-panic"):
        _ := open(-1)

    it("a deposit adds to the balance"):
        let mut account = open(100)
        account.deposit(50)
        assert_equal(account.balance(), 150)

    it("refuses a zero deposit", expect_panic="explicit-panic"):
        let mut account = open(100)
        account.deposit(0)

    it("refuses a negative deposit", expect_panic="explicit-panic"):
        let mut account = open(100)
        account.deposit(-5)

    it("refuses a deposit that would overflow", expect_panic="explicit-panic"):
        let mut account = open(i64::max_value())
        account.deposit(1)

    it("a withdrawal takes from the balance"):
        let mut account = open(100)
        account.withdraw(30)
        assert_equal(account.balance(), 70)

    it("withdrawing the whole balance leaves zero"):
        let mut account = open(100)
        account.withdraw(100)
        assert_equal(account.balance(), 0)

    it("refuses an overdraft", expect_panic="explicit-panic"):
        let mut account = open(100)
        account.withdraw(101)

    it("refuses a zero withdrawal", expect_panic="explicit-panic"):
        let mut account = open(100)
        account.withdraw(0)

    it("refuses a negative withdrawal", expect_panic="explicit-panic"):
        let mut account = open(100)
        account.withdraw(-5)

    it("a transfer moves money and keeps the total"):
        let mut source = open(500)
        let mut target = open(20)
        transfer(&mut source, &mut target, 120)
        assert_equal(source.balance(), 380)
        assert_equal(target.balance(), 140)
        assert_equal(source.balance() + target.balance(), 520)

    it("a transfer may empty the source"):
        let mut source = open(75)
        let mut target = open(0)
        transfer(&mut source, &mut target, 75)
        assert_equal(source.balance(), 0)
        assert_equal(target.balance(), 75)

    it("refuses a transfer larger than the source balance", expect_panic="explicit-panic"):
        let mut source = open(10)
        let mut target = open(0)
        transfer(&mut source, &mut target, 11)

    it("refuses a zero transfer", expect_panic="explicit-panic"):
        let mut source = open(10)
        let mut target = open(0)
        transfer(&mut source, &mut target, 0)

    it_prop_with("a deposit then a withdrawal of the same amount restores the balance", gen=two_amounts, prop=fn!(
        input: (i64, i64),
    ):
        let mut account = open(input._0)
        account.deposit(input._1)
        account.withdraw(input._1)
        assert_equal(account.balance(), input._0)
    )

    it_prop_with("a transfer keeps the total", gen=transfer_case, prop=fn!(input: (i64, i64, i64)):
        let mut source = open(input._0)
        let mut target = open(input._1)
        transfer(&mut source, &mut target, input._2)
        assert_equal(source.balance() + target.balance(), input._0 + input._1)
    )
