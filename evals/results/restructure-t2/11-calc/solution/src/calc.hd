use std.testing.it_each

## Why an expression could not be evaluated.
@error
@derive(Eq, Debug)
pub enum CalcError:
    @error("division by zero")
    DivideByZero
    @error("unexpected input at byte $at")
    Unexpected(at: usize)

## A binary operator in the syntax tree.
@derive(Eq, Debug)
enum Op:
    Add
    Sub
    Mul
    Div

## A syntax tree. Children that hold a whole `Expr` are boxed, since a type
## cannot contain itself by value.
@derive(Eq, Debug)
enum Expr:
    Lit(i64)
    Neg(*Expr)
    Bin(op: Op, left: *Expr, right: *Expr)

## A token. Every token records the byte offset where it starts.
## `Bad` is a byte or number the grammar never accepts.
enum Token:
    Num(value: i64, at: usize)
    Plus(at: usize)
    Minus(at: usize)
    Star(at: usize)
    Slash(at: usize)
    Open(at: usize)
    Close(at: usize)
    Bad(at: usize)

fn is_digit(b: u8) -> bool:
    b >= 48 && b <= 57

fn is_space(b: u8) -> bool:
    b == 32 || b == 9 || b == 10 || b == 13

fn punct(b: u8, at: usize) -> Token:
    match b:
        43 => Token.Plus(at)
        45 => Token.Minus(at)
        42 => Token.Star(at)
        47 => Token.Slash(at)
        40 => Token.Open(at)
        41 => Token.Close(at)
        _ => Token.Bad(at)

fn start_of(t: Token) -> usize:
    match t:
        .Num(_, at) => at
        .Plus(at) => at
        .Minus(at) => at
        .Star(at) => at
        .Slash(at) => at
        .Open(at) => at
        .Close(at) => at
        .Bad(at) => at

## Splits the source into tokens. Invalid input becomes a `Bad` token, so the
## parser reports it at its own position.
fn lex(src: string) -> List[Token]:
    bytes := src.to_utf8()
    let mut out: List[Token] = []
    let at: usize = 0
    while at < bytes.len():
        b := bytes[at]
        if is_space(b):
            at += 1
        else if is_digit(b):
            start := at
            while at < bytes.len() && is_digit(bytes[at]):
                at += 1
            text := string::from_utf8(bytes.slice(start, at)).expect("ASCII digits")
            match text.parse::[i64]():
                .Ok(n) => out.push(Token.Num(n, start))
                .Err(_) => out.push(Token.Bad(start))
        else:
            out.push(punct(b, at))
            at += 1
    out

# The parser walks the tokens with an index. Grammar:
#   expr    := term (('+' | '-') term)*
#   term    := unary (('*' | '/') unary)*
#   unary   := '-' unary | primary
#   primary := NUMBER | '(' expr ')'
struct Parser:
    tokens: List[Token]
    end: usize
    at: usize

impl Parser:
    fn peek(&self) -> Token?:
        self.tokens.get(self.at)

    ## The error at the current position: the next token, or the end of input.
    fn fail(&self) -> CalcError:
        match self.peek():
            .Some(t) => CalcError.Unexpected(start_of(t))
            .None => CalcError.Unexpected(self.end)

    fn primary(&mut self) -> Result[Expr, CalcError]:
        match self.peek():
            .Some(.Num(value, _)) =>
                self.at += 1
                .Ok(Expr.Lit(value))
            .Some(.Open(_)) =>
                self.at += 1
                inner := self.expr()?
                match self.peek():
                    .Some(.Close(_)) =>
                        self.at += 1
                        .Ok(inner)
                    _ => .Err(self.fail())
            _ => .Err(self.fail())

    fn unary(&mut self) -> Result[Expr, CalcError]:
        match self.peek():
            .Some(.Minus(_)) =>
                self.at += 1
                operand := self.unary()?
                .Ok(Expr.Neg(box(operand)))
            _ => self.primary()

    fn term(&mut self) -> Result[Expr, CalcError]:
        let mut left = self.unary()?
        while true:
            op := match self.peek():
                .Some(.Star(_)) => Op.Mul
                .Some(.Slash(_)) => Op.Div
                _ => break
            self.at += 1
            right := self.unary()?
            left = Expr.Bin(op, box(left), box(right))
        .Ok(left)

    fn expr(&mut self) -> Result[Expr, CalcError]:
        let mut left = self.term()?
        while true:
            op := match self.peek():
                .Some(.Plus(_)) => Op.Add
                .Some(.Minus(_)) => Op.Sub
                _ => break
            self.at += 1
            right := self.term()?
            left = Expr.Bin(op, box(left), box(right))
        .Ok(left)

fn eval_tree(e: &Expr) -> Result[i64, CalcError]:
    match e:
        .Lit(n) => .Ok(n)
        .Neg(inner) =>
            n := eval_tree(inner)?
            .Ok(-n)
        .Bin(op, left, right) =>
            a := eval_tree(left)?
            b := eval_tree(right)?
            match op:
                .Add => .Ok(a + b)
                .Sub => .Ok(a - b)
                .Mul => .Ok(a * b)
                .Div =>
                    match b == 0:
                        true => .Err(CalcError.DivideByZero)
                        false => .Ok(a / b)

## Evaluates an integer expression: decimal integers, `+ - * /`, parentheses
## and unary minus. The whole input is parsed before anything is evaluated.
pub fn eval(src: string) -> Result[i64, CalcError]:
    let mut parser = Parser { tokens: lex(src), end: src.len(), at: 0 }
    tree := parser.expr()?
    match parser.peek():
        .Some(_) => .Err(parser.fail())
        .None => eval_tree(&tree)

tests:
    it_each(
        "evaluates",
        [
            ("1", 1i64),
            ("  42  ", 42i64),
            ("1 + 2 * 3", 7i64),
            ("(1 + 2) * 3", 9i64),
            ("1+2-3*4/2", -3i64),
            ("10 - 4 - 3", 3i64),
            ("100 / 7 / 2", 7i64),
            ("7 / -2", -3i64),
            ("-7 / 2", -3i64),
            ("- - 4", 4i64),
            ("-(2 + 3) * 2", -10i64),
            ("2 * -3", -6i64),
            ("(((8)))", 8i64),
            ("9223372036854775807", 9223372036854775807i64),
        ],
        body=fn!(row: (string, i64)): assert_equal(eval(row._0), .Ok(row._1), reason=row._0)
    )

    it_each(
        "reports where it failed",
        [
            ("", CalcError.Unexpected(0)),
            ("1 +", CalcError.Unexpected(3)),
            ("2 * ", CalcError.Unexpected(4)),
            ("1 2", CalcError.Unexpected(2)),
            ("1 $ 2", CalcError.Unexpected(2)),
            ("$", CalcError.Unexpected(0)),
            ("(1", CalcError.Unexpected(2)),
            ("()", CalcError.Unexpected(1)),
            ("1 + 2)", CalcError.Unexpected(5)),
            ("1 +) ", CalcError.Unexpected(3)),
            ("-", CalcError.Unexpected(1)),
            ("1 / 0 2", CalcError.Unexpected(6)),
            ("9223372036854775808", CalcError.Unexpected(0)),
        ],
        body=fn!(row: (string, CalcError)): assert_equal(eval(row._0), .Err(row._1), reason=row._0)
    )

    it_each(
        "divides by zero only after the input parses",
        [
            ("1 / 0", CalcError.DivideByZero),
            ("(4 - 4) * 9 / (2 - 2)", CalcError.DivideByZero),
            ("1 / 0 + 2", CalcError.DivideByZero),
        ],
        body=fn!(row: (string, CalcError)): assert_equal(eval(row._0), .Err(row._1), reason=row._0)
    )
