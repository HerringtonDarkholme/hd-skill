use std.testing.Choices

## One maximal run: `count` copies of `value` in a row.
@derive(Eq, Debug)
pub struct Run:
    pub value: i32
    pub count: usize

## Encodes `xs` as maximal runs: no run is empty, and neighbouring runs
## have different values. The empty list encodes to the empty list.
pub fn encode(xs: List[i32]) -> List[Run]:
    let mut runs: List[Run] = []
    for x in xs:
        let .Some(last) = runs.pop() else:
            runs.push(Run { value: x, count: 1 })
            continue
        if last.value == x:
            runs.push(Run { value: x, count: last.count + 1 })
        else:
            runs.push(last)
            runs.push(Run { value: x, count: 1 })
    runs

## Expands `runs` back into the list they encode. Inverse of `encode`.
pub fn decode(runs: List[Run]) -> List[i32]:
    let mut out: List[i32] = []
    for run in runs:
        for _ in 0..run.count:
            out.push(run.value)
    out

## True when `runs` is canonical: every count is positive and no two
## neighbouring runs share a value. `encode` always returns such a list.
fn is_canonical(runs: List[Run]) -> bool:
    for i in 0..runs.len():
        if runs[i].count == 0:
            return false
        if i > 0:
            if runs[i - 1].value == runs[i].value:
                return false
    true

## The runs written as (value, count) pairs, for test tables.
fn runs_from(pairs: List[(i32, usize)]) -> List[Run]:
    pairs.map(fn(p): Run { value: p._0, count: p._1 })

## A list over a small alphabet, so that runs of equal values are common.
fn small_values(c: &mut Choices) -> List[i32]:
    c.list(60, small_value)

fn small_value(c: &mut Choices) -> i32:
    c.int(-2..=2)

## A canonical run list, built from runs of small values.
fn canonical_runs(c: &mut Choices) -> List[Run]:
    encode(small_values(c))

tests:
    use std.testing.it_each
    use std.testing.it_prop
    use std.testing.it_prop_with

    it("encodes the empty list to no runs"):
        assert_equal(encode([]), [])

    it("decodes no runs to the empty list"):
        assert_equal(decode([]), [])

    it("encodes one element as one run of one"):
        assert_equal(encode([7]), [Run { value: 7, count: 1 }])

    it("merges a repeated value into one run"):
        assert_equal(encode([5, 5, 5]), [Run { value: 5, count: 3 }])

    it("starts a new run when the value changes"):
        assert_equal(
            encode([1, 1, 2, 2, 2, 1]),
            [Run { value: 1, count: 2 }, Run { value: 2, count: 3 }, Run { value: 1, count: 1 }],
        )

    it("keeps equal values apart when they are not neighbours"):
        assert_equal(encode([3, 4, 3]).len(), 3)

    it("handles negative and extreme values"):
        xs := [-2147483648, -2147483648, 2147483647, 0, 0]
        assert_equal(
            encode(xs),
            [
                Run { value: -2147483648, count: 2 },
                Run { value: 2147483647, count: 1 },
                Run { value: 0, count: 2 },
            ],
        )
        assert_equal(decode(encode(xs)), xs)

    it("decodes a run of count zero to nothing"):
        assert_equal(decode([Run { value: 9, count: 0 }, Run { value: 4, count: 2 }]), [4, 4])

    it("decodes runs with a repeated value without merging them"):
        assert_equal(decode([Run { value: 1, count: 1 }, Run { value: 1, count: 2 }]), [1, 1, 1])

    it("compares runs by value and count"):
        assert(Run { value: 1, count: 2 } == Run { value: 1, count: 2 }, reason="equal runs")
        assert(Run { value: 1, count: 2 } != Run { value: 1, count: 3 }, reason="different counts")
        assert(Run { value: 1, count: 2 } != Run { value: 2, count: 2 }, reason="different values")

    it("prints a run for debugging"):
        assert_equal(debug(Run { value: 3, count: 2 }), "Run { value: 3, count: 2 }")

    it_each(
        "encodes an example to its runs",
        [
            ([], []),
            ([0], [(0, 1)]),
            ([1, 2, 3], [(1, 1), (2, 1), (3, 1)]),
            ([8, 8, 8, 8], [(8, 4)]),
            ([1, 1, 2, 1, 1, 1], [(1, 2), (2, 1), (1, 3)]),
        ],
        body=fn!(row: (List[i32], List[(i32, usize)])):
            assert_equal(encode(row._0), runs_from(row._1))
    )

    it_prop(
        "decode undoes encode for any list",
        prop=fn!(xs: List[i32]): assert_equal(decode(encode(xs)), xs)
    )

    it_prop_with(
        "decode undoes encode for lists with long runs",
        gen=small_values,
        prop=fn!(xs: List[i32]): assert_equal(decode(encode(xs)), xs)
    )

    it_prop(
        "encode output is canonical",
        prop=fn!(xs: List[i32]):
            assert(is_canonical(encode(xs)), reason="no empty run and no equal neighbours")
    )

    it_prop("run counts add up to the list length", prop=fn!(xs: List[i32]):
        total := encode(xs).map(fn(r): r.count).sum()
        assert_equal(total, xs.len())
    )

    it_prop(
        "encode never produces more runs than elements",
        prop=fn!(xs: List[i32]):
            assert(encode(xs).len() <= xs.len(), reason="a run holds at least one element")
    )

    it_prop_with(
        "encode then decode is the identity on canonical runs",
        gen=canonical_runs,
        prop=fn!(runs: List[Run]): assert_equal(encode(decode(runs)), runs)
    )

    it_prop(
        "decode of encode keeps the element count",
        prop=fn!(xs: List[i32]): assert_equal(decode(encode(xs)).len(), xs.len())
    )
