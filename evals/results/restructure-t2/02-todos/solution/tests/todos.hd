use pkg.{Todo, TodoError, load, dump, complete, pending}
use std.testing.assert_equal

it("works through the public API"):
    todos := load(
        "[{\"id\": 1, \"title\": \"milk\"}, {\"id\": 2, \"title\": \"eggs\", \"done\": true}]",
    )
        .expect("valid")
    assert_equal(pending(todos), ["milk"])
    done := complete(todos, 1).expect("id 1 exists")
    assert_equal(pending(done), [])
    assert_equal(load(dump(done)), .Ok(done))
    assert_equal(complete(done, 5), .Err(TodoError.UnknownId(5)))
