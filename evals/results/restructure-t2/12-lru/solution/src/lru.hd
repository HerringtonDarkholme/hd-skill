## A least-recently-used cache from string keys to i64 values.
##
## Each entry occupies a slot. The slots form a list from the most recent
## (`head`) to the least recent (`tail`), linked by `newer` and `older`; -1
## marks the end of a link. `slot` maps each key to its slot.

pub struct Lru:
    capacity: usize
    keys: List[string] = []
    vals: List[i64] = []
    newer: List[i64] = []
    older: List[i64] = []
    slot: Map[string, i64] = {}
    head: i64 = -1
    tail: i64 = -1

## An empty cache that holds at most `capacity` entries.
pub fn new_lru(capacity: usize) -> Lru:
    Lru { capacity }

impl Lru:
    ## The value for `key`, or `.None`. A hit makes the key the most recent.
    pub fn get(&mut self, key: string) -> i64?:
        i := self.slot.get(key)?
        self.unlink(i)
        self.push_front(i)
        .Some(self.vals[usize(i)])

    ## Inserts or updates `key` and makes it the most recent, then evicts the
    ## least recent entry when the cache is over capacity.
    pub fn put(&mut self, key: string, value: i64) -> void:
        if self.capacity == 0:
            return
        let .Some(i) = self.slot.get(key) else:
            self.insert_new(key, value)
            return
        self.vals[usize(i)] = value
        self.unlink(i)
        self.push_front(i)

    ## The number of entries held.
    pub fn len(self) -> usize:
        self.slot.len()

    fn insert_new(&mut self, key: string, value: i64) -> void:
        if self.slot.len() < self.capacity:
            i := i64(self.keys.len())
            self.keys.push(key)
            self.vals.push(value)
            self.newer.push(-1)
            self.older.push(-1)
            self.link_front(key, i)
        else:
            # Reuse the least recent slot for the new entry.
            i := self.tail
            self.unlink(i)
            _ := self.slot.remove(self.keys[usize(i)])
            self.keys[usize(i)] = key
            self.vals[usize(i)] = value
            self.link_front(key, i)

    fn link_front(&mut self, key: string, i: i64) -> void:
        self.slot[key] = i
        self.push_front(i)

    # Removes slot `i` from the recency list.
    fn unlink(&mut self, i: i64) -> void:
        newer := self.newer[usize(i)]
        older := self.older[usize(i)]
        if newer >= 0:
            self.older[usize(newer)] = older
        else:
            self.head = older
        if older >= 0:
            self.newer[usize(older)] = newer
        else:
            self.tail = newer

    # Puts slot `i`, which is not in the list, at the front.
    fn push_front(&mut self, i: i64) -> void:
        self.newer[usize(i)] = -1
        self.older[usize(i)] = self.head
        if self.head >= 0:
            self.newer[usize(self.head)] = i
        else:
            self.tail = i
        self.head = i

tests:
    use std.testing.{Choices, commands, it_each, it_prop_with}

    # A plain model: entries from most to least recent, and the capacity.
    struct Model:
        cap: usize
        entries: List[(string, i64)]

    fn model_get(entries: List[(string, i64)], key: string) -> i64?:
        for (k, v) in entries:
            if k == key:
                return .Some(v)
        .None

    # Moves `key` to the front with `value`, dropping any older entry for it,
    # then keeps only the `cap` most recent.
    fn model_put(
        entries: List[(string, i64)],
        cap: usize,
        key: string,
        value: i64,
    ) -> List[(string, i64)]:
        let mut next: List[(string, i64)] = [(key, value)]
        for (k, v) in entries:
            if k != key:
                next.push((k, v))
        next.truncate(cap)
        next

    fn model_touch(entries: List[(string, i64)], key: string) -> List[(string, i64)]:
        match model_get(entries, key):
            .Some(v) => model_put(entries, entries.len(), key, v)
            .None => entries

    @derive(Debug)
    enum Cmd:
        Get(string)
        Put(string, i64)

    fn next_cmd(c: &mut Choices, model: &Model) -> Cmd?:
        key := c.choose(["a", "b", "c", "d", "e"])
        if c.bool(): .Some(.Get(key)) else: .Some(.Put(key, c.int(-9..=9)))

    fn advance_cmd(model: &Model, cmd: &Cmd) -> Model:
        match cmd:
            .Get(key) => Model { cap: model.cap, entries: model_touch(model.entries, key) }
            .Put(key, value) =>
                Model { cap: model.cap, entries: model_put(model.entries, model.cap, key, value) }

    fn history(c: &mut Choices) -> (usize, List[Cmd]):
        let cap: usize = c.int(0..=4)
        start := Model { cap, entries: [] }
        (cap, commands(c, max=40, initial=start, next=next_cmd, advance=advance_cmd))

    it("a new cache is empty"):
        let mut cache = new_lru(3)
        assert_equal(cache.len(), 0)
        assert_equal(cache.get("a"), .None)

    it("a put value is read back"):
        let mut cache = new_lru(3)
        cache.put("a", 1)
        assert_equal(cache.get("a"), .Some(1))
        assert_equal(cache.len(), 1)

    it("a put to an existing key updates it in place"):
        let mut cache = new_lru(3)
        cache.put("a", 1)
        cache.put("a", 2)
        assert_equal(cache.get("a"), .Some(2))
        assert_equal(cache.len(), 1)

    it("evicts the least recent entry when over capacity"):
        let mut cache = new_lru(2)
        cache.put("a", 1)
        cache.put("b", 2)
        cache.put("c", 3)
        assert_equal(cache.get("a"), .None)
        assert_equal(cache.get("b"), .Some(2))
        assert_equal(cache.get("c"), .Some(3))
        assert_equal(cache.len(), 2)

    it("a get hit makes its key the most recent"):
        let mut cache = new_lru(2)
        cache.put("a", 1)
        cache.put("b", 2)
        assert_equal(cache.get("a"), .Some(1))
        cache.put("c", 3)
        assert_equal(cache.get("b"), .None)
        assert_equal(cache.get("a"), .Some(1))

    it("a put makes its key the most recent"):
        let mut cache = new_lru(2)
        cache.put("a", 1)
        cache.put("b", 2)
        cache.put("a", 9)
        cache.put("c", 3)
        assert_equal(cache.get("b"), .None)
        assert_equal(cache.get("a"), .Some(9))

    it("a get miss changes nothing"):
        let mut cache = new_lru(2)
        cache.put("a", 1)
        cache.put("b", 2)
        assert_equal(cache.get("z"), .None)
        cache.put("c", 3)
        assert_equal(cache.get("a"), .None)
        assert_equal(cache.get("b"), .Some(2))

    fn fill_three(cap: usize) -> usize:
        let mut cache = new_lru(cap)
        for key in ["a", "b", "c"]:
            cache.put(key, 1)
        cache.len()

    it_each(
        "capacity bounds the entries it keeps",
        [(0, 0), (1, 1), (2, 2), (3, 3), (4, 3)],
        body=fn!(row: (usize, usize)): assert_equal(fill_three(row._0), row._1)
    )

    it("a zero capacity cache stores nothing"):
        let mut cache = new_lru(0)
        cache.put("a", 1)
        assert_equal(cache.get("a"), .None)
        assert_equal(cache.len(), 0)

    it_prop_with("the cache follows a plain model", gen=history, prop=fn!(
        input: (usize, List[Cmd]),
    ):
        let (cap, cmds) = input
        let mut cache = new_lru(cap)
        let mut model = Model { cap, entries: [] }
        for cmd in cmds:
            match cmd:
                .Get(key) =>
                    assert_equal(cache.get(key), model_get(model.entries, key), reason="get $key")
                .Put(key, value) => cache.put(key, value)
            model = advance_cmd(&model, &cmd)
            assert_equal(cache.len(), model.entries.len(), reason="after ${debug(cmd)}")
    )
