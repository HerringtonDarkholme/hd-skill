use std.cli.{Args, Cli, ScriptedArgs}
use std.console.{ConsoleInput, MemoryConsole, ScriptedInput, eprintln, read_all}
use std.process.ExitCode
use pkg.sum.{summarize}

## Sum one CSV column, grouped by another column
@derive(Cli)
struct Options:
    ## the column to group by, 1-based
    key: usize = 1
    ## the column to sum, 1-based
    value: usize = 2
    ## ignore the first line
    skip_header: bool

pub fn main!() -> ExitCode $ Args + Console + ConsoleInput:
    options := match Options::parse_args():
        .Ok(options) => options
        .Err(error) => return error.exit()
    if options.key == 0 || options.value == 0:
        eprintln("colsum: columns are numbered from 1")
        return ExitCode(2)
    text := match read_all!():
        .Ok(text) => text
        .Err(error) =>
            eprintln("colsum: $error")
            return ExitCode(1)
    rows := match summarize(text, options.key, options.value, options.skip_header):
        .Ok(rows) => rows
        .Err(error) =>
            eprintln("colsum: $error")
            return ExitCode(1)
    for (key, total) in rows:
        println("$key,$total")
    ExitCode(0)

tests:
    it("prints one total per key"):
        input := ScriptedInput::new(["tea,3", "jam,2", "tea,4"])
        console := MemoryConsole::new()
        arguments := box(ScriptedArgs::new("colsum", []))
        $.with(Args=arguments, ConsoleInput=input, Console=console):
            assert_equal(main!(), ExitCode(0))
        assert_equal(console.output().join(""), "jam,2\ntea,7\n")
        assert_equal(console.error_output().join(""), "")

    it("honours the column and header options"):
        input := ScriptedInput::new(["name,city,score", "ann,oslo,5", "bob,rome,6"])
        console := MemoryConsole::new()
        arguments := box(
            ScriptedArgs::new("colsum", ["--key", "2", "--value", "3", "--skip-header"]),
        )
        $.with(Args=arguments, ConsoleInput=input, Console=console):
            assert_equal(main!(), ExitCode(0))
        assert_equal(console.output().join(""), "oslo,5\nrome,6\n")

    it("reports a bad value on standard error and prints nothing to standard output"):
        input := ScriptedInput::new(["tea,3", "jam,many"])
        console := MemoryConsole::new()
        arguments := box(ScriptedArgs::new("colsum", []))
        $.with(Args=arguments, ConsoleInput=input, Console=console):
            assert_equal(main!(), ExitCode(1))
        assert_equal(console.output().join(""), "")
        assert_equal(console.error_output().join(""), "colsum: line 2: not a number: many\n")

    it("rejects column 0 as a usage error"):
        input := ScriptedInput::new(["tea,3"])
        console := MemoryConsole::new()
        arguments := box(ScriptedArgs::new("colsum", ["--key", "0"]))
        $.with(Args=arguments, ConsoleInput=input, Console=console):
            assert_equal(main!(), ExitCode(2))
        assert_equal(console.output().join(""), "")
