## One maximal run of equal values: `count` copies of `value`.
@derive(Eq, Debug)
pub struct Run:
    pub value: i32
    pub count: usize

## Run-length encodes `xs` into maximal runs: no run is empty and
## neighbouring runs hold different values.
pub fn encode(xs: List[i32]) -> List[Run]:
    let mut runs: List[Run] = []
    for x in xs:
        top := runs.pop()
        match top:
            .Some(run) =>
                if run.value == x:
                    runs.push(Run { value: x, count: run.count + 1 })
                else:
                    runs.push(run)
                    runs.push(Run { value: x, count: 1 })
            .None => runs.push(Run { value: x, count: 1 })
    runs

## Expands runs back into the list they were encoded from.
pub fn decode(runs: List[Run]) -> List[i32]:
    let mut out: List[i32] = []
    for run in runs:
        for _ in 0..run.count:
            out.push(run.value)
    out

fn total_count(runs: List[Run]) -> usize:
    let total: usize = 0
    for run in runs:
        total += run.count
    total

fn is_maximal(runs: List[Run]) -> bool:
    for i in 0..runs.len():
        if runs[i].count == 0:
            return false
        if i + 1 < runs.len() && runs[i].value == runs[i + 1].value:
            return false
    true

tests:
    use std.testing.it_prop

    it("encodes the empty list as no runs"):
        assert_equal(encode([]), [])

    it("encodes one value as one run"):
        assert_equal(encode([5]), [Run { value: 5, count: 1 }])

    it("merges a repeated value into one run"):
        assert_equal(encode([1, 1, 1]), [Run { value: 1, count: 3 }])

    it("starts a new run when the value changes"):
        assert_equal(
            encode([1, 2, 2, 3, 3, 3, 1]),
            [
                Run { value: 1, count: 1 },
                Run { value: 2, count: 2 },
                Run { value: 3, count: 3 },
                Run { value: 1, count: 1 },
            ],
        )

    it("does not merge non-adjacent equal values"):
        assert_equal(encode([4, 5, 4]).len(), 3)

    it("handles negative and extreme values"):
        assert_equal(
            encode([-1, -1, 0, 2147483647, -2147483648, -2147483648]),
            [
                Run { value: -1, count: 2 },
                Run { value: 0, count: 1 },
                Run { value: 2147483647, count: 1 },
                Run { value: -2147483648, count: 2 },
            ],
        )

    it("decodes no runs to the empty list"):
        assert_equal(decode([]), [])

    it("decodes runs to their expansion"):
        assert_equal(decode([Run { value: 1, count: 2 }, Run { value: 9, count: 1 }]), [1, 1, 9])

    it("decodes a zero-count run to nothing"):
        assert_equal(decode([Run { value: 7, count: 0 }, Run { value: 3, count: 1 }]), [3])

    it("round-trips a long single run"):
        let mut xs: List[i32] = []
        for _ in 0..10000:
            xs.push(4)
        runs := encode(xs)
        assert_equal(runs, [Run { value: 4, count: 10000 }])
        assert_equal(decode(runs), xs)

    it("round-trips a list of distinct values"):
        xs := [3, 1, 4, 1, 5, 9, 2, 6]
        assert_equal(decode(encode(xs)), xs)

    it_prop(
        "decode undoes encode for any list",
        prop=fn!(xs: List[i32]): assert_equal(decode(encode(xs)), xs)
    )

    it_prop("decode undoes encode on lists with many repeats", prop=fn!(bs: List[u8]):
        xs := bs.map(fn(b): i32(b % 3))
        assert_equal(decode(encode(xs)), xs)
    )

    it_prop("encode gives maximal runs covering the whole input", prop=fn!(xs: List[i32]):
        runs := encode(xs)
        assert(is_maximal(runs))
        assert_equal(total_count(runs), xs.len())
    )

    it_prop(
        "encode never gives more runs than there are items",
        prop=fn!(xs: List[i32]): assert(encode(xs).len() <= xs.len())
    )
