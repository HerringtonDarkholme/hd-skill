use pkg.{Run, decode, encode}
use std.testing.{assert_equal, it_prop}

it("the public API round-trips a list"):
    xs := [1, 1, 2, 2, 2, 3]
    assert_equal(
        encode(xs),
        [Run { value: 1, count: 2 }, Run { value: 2, count: 3 }, Run { value: 3, count: 1 }],
    )
    assert_equal(decode(encode(xs)), xs)

it_prop(
    "the public API round-trips any list",
    prop=fn!(xs: List[i32]): assert_equal(decode(encode(xs)), xs)
)
