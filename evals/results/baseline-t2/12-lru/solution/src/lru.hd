## A least-recently-used cache from string keys to i64 values.
##
## `values` holds the entries; `order` holds the same keys, least recently
## used first. Every operation is O(capacity) because `order` is a list.

pub struct Lru:
    capacity: usize
    values: Map[string, i64]
    order: List[string]

## An empty cache that keeps at most `capacity` entries.
pub fn new_lru(capacity: usize) -> Lru:
    Lru { capacity: capacity, values: {}, order: [] }

impl Lru:
    ## The value stored under `key`, or `.None`. A hit makes `key` the most
    ## recently used; a miss changes nothing.
    pub fn get(&mut self, key: string) -> i64?:
        let .Some(value) = self.values.get(key) else:
            return .None
        self.touch(key)
        .Some(value)

    ## Stores `value` under `key`, making `key` the most recently used, then
    ## evicts the least recently used entry while the cache is over capacity.
    pub fn put(&mut self, key: string, value: i64) -> void:
        if self.values.contains_key(key):
            self.touch(key)
        else:
            self.order.push(key)
        self.values[key] = value
        while self.order.len() > self.capacity:
            oldest := self.order.remove(0)
            _ := self.values.remove(oldest)

    ## The number of entries stored.
    pub fn len(self) -> usize:
        self.values.len()

    ## Moves `key`, which must be stored, to the most recently used end.
    fn touch(&mut self, key: string) -> void:
        let .Some(index) = self.order.index_of(key) else:
            return
        self.order.remove(index)
        self.order.push(key)

tests:
    use std.testing.{it_prop_with, Choices, commands, assert_equal}

    ## A model of the cache: a list of entries, least recently used first.
    struct Model:
        capacity: usize
        entries: List[(string, i64)]

    ## One operation on the cache.
    @derive(Debug)
    enum Op:
        Get(key: string)
        Put(key: string, value: i64)

    ## A generated test case: a capacity and the operations to run.
    @derive(Debug)
    struct Case:
        capacity: usize
        ops: List[Op]

    ## The model's answer to `op` and its next state.
    fn model_apply(model: Model, op: Op) -> (Model, i64?):
        match op:
            .Get(key) =>
                match model.entries.find(fn(entry): entry._0 == key):
                    .Some(entry) =>
                        kept := model.entries.filter(fn(other): other._0 != key)
                        (
                            Model { capacity: model.capacity, entries: [kept..., entry] },
                            .Some(entry._1),
                        )
                    .None => (model, .None)
            .Put(key, value) =>
                kept := model.entries.filter(fn(entry): entry._0 != key)
                full := [kept..., (key, value)]
                let mut start: usize = 0
                if full.len() > model.capacity:
                    start = full.len() - model.capacity
                (Model { capacity: model.capacity, entries: full.slice(start, full.len()) }, .None)

    fn next_op(c: &mut Choices, model: &Model) -> Op?:
        key := c.choose(["a", "b", "c", "d"])
        if c.bool(): .Some(.Get(key)) else: .Some(.Put(key, c.int(-9..=9)))

    fn advance_model(model: &Model, op: &Op) -> Model:
        let (next, _) = model_apply(*model, *op)
        next

    fn generate_case(c: &mut Choices) -> Case:
        capacity := usize(c.int(0..=4))
        ops := commands(c, 40, Model { capacity: capacity, entries: [] }, next_op, advance_model)
        Case { capacity: capacity, ops: ops }

    fn check_case(case: Case) -> void:
        let mut cache = new_lru(case.capacity)
        let mut model = Model { capacity: case.capacity, entries: [] }
        for op in case.ops:
            let (next, expected) = model_apply(model, op)
            model = next
            match op:
                .Get(key) => assert_equal(cache.get(key), expected, reason="get $key")
                .Put(key, value) =>
                    cache.put(key, value)
                    assert_equal(cache.len(), model.entries.len(), reason="len after put $key")

    it("a missing key gives none"):
        let mut cache = new_lru(2)
        assert_equal(cache.get("a"), .None)
        assert_equal(cache.len(), 0)

    it("stores and reads a value"):
        let mut cache = new_lru(2)
        cache.put("a", 1)
        assert_equal(cache.get("a"), .Some(1))
        assert_equal(cache.len(), 1)

    it("an update replaces the value without growing"):
        let mut cache = new_lru(2)
        cache.put("a", 1)
        cache.put("a", 7)
        assert_equal(cache.get("a"), .Some(7))
        assert_equal(cache.len(), 1)

    it("evicts the least recently used key when over capacity"):
        let mut cache = new_lru(2)
        cache.put("a", 1)
        cache.put("b", 2)
        cache.put("c", 3)
        assert_equal(cache.get("a"), .None, reason="a was the oldest")
        assert_equal(cache.get("b"), .Some(2))
        assert_equal(cache.get("c"), .Some(3))
        assert_equal(cache.len(), 2)

    it("a hit makes the key most recently used"):
        let mut cache = new_lru(2)
        cache.put("a", 1)
        cache.put("b", 2)
        assert_equal(cache.get("a"), .Some(1))
        cache.put("c", 3)
        assert_equal(cache.get("b"), .None, reason="b became the oldest")
        assert_equal(cache.get("a"), .Some(1))

    it("a put of an existing key makes it most recently used"):
        let mut cache = new_lru(2)
        cache.put("a", 1)
        cache.put("b", 2)
        cache.put("a", 10)
        cache.put("c", 3)
        assert_equal(cache.get("b"), .None, reason="b became the oldest")
        assert_equal(cache.get("a"), .Some(10))

    it("a missed get changes nothing"):
        let mut cache = new_lru(2)
        cache.put("a", 1)
        cache.put("b", 2)
        assert_equal(cache.get("zzz"), .None)
        cache.put("c", 3)
        assert_equal(cache.get("a"), .None, reason="a is still the oldest")
        assert_equal(cache.len(), 2)

    it("capacity zero keeps nothing"):
        let mut cache = new_lru(0)
        cache.put("a", 1)
        assert_equal(cache.get("a"), .None)
        assert_equal(cache.len(), 0)

    it("capacity one keeps only the last put"):
        let mut cache = new_lru(1)
        cache.put("a", 1)
        cache.put("b", 2)
        assert_equal(cache.get("a"), .None)
        assert_equal(cache.get("b"), .Some(2))

    it("len counts distinct keys up to capacity"):
        let mut cache = new_lru(3)
        for key in ["a", "b", "a", "c", "d"]:
            cache.put(key, 0)
        assert_equal(cache.len(), 3)

    it_prop_with(
        "agrees with the model on generated sequences",
        gen=fn(c: &mut Choices): generate_case(c),
        prop=fn!(case: Case): check_case(case)
    )
