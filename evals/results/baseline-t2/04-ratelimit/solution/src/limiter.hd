use std.time.{Clock, Duration, Timestamp, now}

## A sliding-window rate limiter: each key may have at most `max` allowed
## events within the last `window`.
pub struct Limiter:
    max: usize
    window: Duration
    events: Map[string, List[Timestamp]]

## A limiter allowing `max` events per key in every `window`.
pub fn new_limiter(max: usize, window: Duration) -> Limiter:
    Limiter { max: max, window: window, events: {} }

impl Limiter:
    ## Records an event for `key` now and reports whether it is allowed.
    ## Refused events are not recorded.
    pub fn allow(&mut self, key: string) -> bool $ Clock:
        at := now()
        span := self.window.as_milliseconds()
        let stored: List[Timestamp] = self.events.get(key).unwrap_or([])
        let mut recent: List[Timestamp] = []
        for t in stored:
            if at.since(t).as_milliseconds() < span:
                recent.push(t)
        allowed := recent.len() < self.max
        if allowed:
            recent.push(at)
        self.events[key] = recent
        allowed

tests:
    use std.testing.assert_equal
    use std.time.{ManualClock, ms, s, sleep}

    it("allows up to max events and refuses the next"):
        clock := ManualClock::new(Timestamp::from_unix_milliseconds(0))
        let mut limiter = new_limiter(2, 10s)
        $.with(Clock=clock):
            assert_equal(limiter.allow("a"), true)
            assert_equal(limiter.allow("a"), true)
            assert_equal(limiter.allow("a"), false, reason="third event within the window")

    it("counts an event until its window has fully passed"):
        clock := ManualClock::new(Timestamp::from_unix_milliseconds(0))
        let mut limiter = new_limiter(1, 10s)
        $.with(Clock=clock):
            assert_equal(limiter.allow("a"), true)
            sleep!(9999ms)
            assert_equal(limiter.allow("a"), false, reason="9999ms is inside the window")
            sleep!(1ms)
            assert_equal(limiter.allow("a"), true, reason="exactly 10s later it has expired")

    it("does not record refused events"):
        clock := ManualClock::new(Timestamp::from_unix_milliseconds(0))
        let mut limiter = new_limiter(1, 10s)
        $.with(Clock=clock):
            assert_equal(limiter.allow("a"), true)
            sleep!(5s)
            assert_equal(limiter.allow("a"), false)
            sleep!(5s)
            assert_equal(limiter.allow("a"), true, reason="the refused event at 5s must not count")

    it("slides the window over the events"):
        clock := ManualClock::new(Timestamp::from_unix_milliseconds(0))
        let mut limiter = new_limiter(2, 10s)
        $.with(Clock=clock):
            assert_equal(limiter.allow("a"), true) # t=0
            sleep!(4s)
            assert_equal(limiter.allow("a"), true) # t=4
            sleep!(1s)
            assert_equal(limiter.allow("a"), false) # t=5, both still inside
            sleep!(5s)
            assert_equal(limiter.allow("a"), true) # t=10, the t=0 event has expired
            sleep!(1s)
            assert_equal(limiter.allow("a"), false) # t=11: t=4 and t=10 are inside

    it("keeps keys independent"):
        clock := ManualClock::new(Timestamp::from_unix_milliseconds(0))
        let mut limiter = new_limiter(1, 10s)
        $.with(Clock=clock):
            assert_equal(limiter.allow("a"), true)
            assert_equal(limiter.allow("b"), true, reason="another key has its own budget")
            assert_equal(limiter.allow("a"), false)
            assert_equal(limiter.allow("b"), false)
