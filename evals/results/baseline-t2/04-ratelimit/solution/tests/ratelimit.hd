use pkg.{Limiter, new_limiter}
use std.testing.assert_equal
use std.time.{Clock, ManualClock, Timestamp, s, sleep}

it("limits through the public API"):
    clock := ManualClock::new(Timestamp::from_unix_milliseconds(0))
    let mut limiter = new_limiter(1, 5s)
    $.with(Clock=clock):
        assert_equal(limiter.allow("user-1"), true)
        assert_equal(limiter.allow("user-1"), false, reason="one event per window")
        sleep!(5s)
        assert_equal(limiter.allow("user-1"), true, reason="the window has passed")
