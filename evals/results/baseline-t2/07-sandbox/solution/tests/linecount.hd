use std.process.Command
use std.testing.{assert_equal, hd_run}

# These run the real program, so the grant in hd.toml (`FsRead = ["data/"]`)
# is what is tested.

it("counts the files under data/"):
    let out = hd_run!(
        *Command::new("linecount")
            .args(["data/three.txt", "data/no-newline.txt", "data/empty.txt", "data/binary.bin"]),
    )
    assert_equal(
        out.stdout,
        "3 data/three.txt\n2 data/no-newline.txt\n0 data/empty.txt\n2 data/binary.bin\n7 total\n",
    )
    assert_equal(out.stderr, "")
    assert_equal(out.status, 0, reason="every file was read")

it("refuses a file outside data/ and exits 1"):
    let out = hd_run!(*Command::new("linecount").args(["data/three.txt", "hd.toml"]))
    assert_equal(out.stdout, "3 data/three.txt\n3 total\n")
    assert_equal(out.stderr, "linecount: hd.toml: access to hd.toml is not granted\n")
    assert_equal(out.status, 1)

it("refuses a path that climbs out of data/"):
    let out = hd_run!(*Command::new("linecount").args(["data/../hd.toml"]))
    assert_equal(out.stdout, "0 total\n")
    assert_equal(
        out.stderr,
        "linecount: data/../hd.toml: access to data/../hd.toml is not granted\n",
    )
    assert_equal(out.status, 1)

it("refuses an absolute path"):
    let out = hd_run!(*Command::new("linecount").args(["/etc/hosts"]))
    assert_equal(out.stdout, "0 total\n")
    assert_equal(out.status, 1)

it("reports a missing file and keeps going"):
    let out = hd_run!(*Command::new("linecount").args(["data/missing.txt", "data/three.txt"]))
    assert_equal(out.stdout, "3 data/three.txt\n3 total\n")
    assert_equal(out.stderr, "linecount: data/missing.txt: not found: data/missing.txt\n")
    assert_equal(out.status, 1)
