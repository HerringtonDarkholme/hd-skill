use std.cli.{Args, ScriptedArgs, args}
use std.console.{MemoryConsole, eprintln}
use std.fs.{FsError, FsRead, FsWrite, MemoryFs, create_dir_all, read_bytes, write_text}
use std.path.Path
use std.process.ExitCode
use std.testing.assert_equal

# Counts lines as `str.lines()` does: every newline ends a line, and a last
# line without a newline still counts. Works on raw bytes, so a file that is
# not valid UTF-8 is still counted.
fn count_lines(bytes: List[u8]) -> usize:
    let mut count: usize = 0
    for byte in bytes:
        if byte == 10:
            count += 1
    if bytes.len() > 0 && bytes[bytes.len() - 1] != 10:
        count += 1
    count

fn line_count!(file: string) -> Result[usize, FsError] $ FsRead:
    bytes := read_bytes!(Path(file))?
    .Ok(count_lines(bytes))

# Prints `<lines> <file>` per file and `<total> total`. Unreadable files are
# reported on standard error and skipped; the status is 1 if any was skipped.
pub fn main!() -> ExitCode $ Args + Console + FsRead:
    let mut total: usize = 0
    let mut failed = false
    for file in args():
        match line_count!(file):
            .Ok(lines) =>
                total += lines
                println("$lines $file")
            .Err(error) =>
                eprintln("linecount: $file: $error")
                failed = true
    println("$total total")
    if failed:
        return ExitCode(1)
    ExitCode(0)

fn bytes_of(text: string) -> List[u8]:
    text.bytes().collect()

tests:
    it("counts newline-terminated lines"):
        assert_equal(count_lines(bytes_of("a\nb\nc\n")), 3)

    it("counts a final line without a newline"):
        assert_equal(count_lines(bytes_of("a\nb")), 2)

    it("counts an empty file as zero lines"):
        assert_equal(count_lines(bytes_of("")), 0)

    it("counts blank lines"):
        assert_equal(count_lines(bytes_of("\n\n")), 2)

    it("counts bytes that are not UTF-8"):
        assert_equal(count_lines([255, 10, 254]), 2)

    it("prints a count per file and a total"):
        fs := MemoryFs::new()
        console := MemoryConsole::new()
        $.with(FsWrite=fs):
            _ := create_dir_all!(Path("data"))
            _ := write_text!(Path("data/a.txt"), "one\ntwo\n")
            _ := write_text!(Path("data/b.txt"), "three")
        arguments := box(ScriptedArgs::new("linecount", ["data/a.txt", "data/b.txt"]))
        $.with(Args=arguments, FsRead=fs, Console=console):
            assert_equal(main!(), ExitCode(0))
        assert_equal(console.output().join(""), "2 data/a.txt\n1 data/b.txt\n3 total\n")

    it("skips an unreadable file, reports it, and exits 1"):
        fs := MemoryFs::new()
        console := MemoryConsole::new()
        $.with(FsWrite=fs):
            _ := create_dir_all!(Path("data"))
            _ := write_text!(Path("data/a.txt"), "x\n")
        arguments := box(ScriptedArgs::new("linecount", ["data/missing.txt", "data/a.txt"]))
        $.with(Args=arguments, FsRead=fs, Console=console):
            assert_equal(main!(), ExitCode(1))
        assert_equal(console.output().join(""), "1 data/a.txt\n1 total\n")
        assert_equal(
            console.error_output().join(""),
            "linecount: data/missing.txt: not found: data/missing.txt\n",
        )

    it("prints a zero total with no files"):
        console := MemoryConsole::new()
        arguments := box(ScriptedArgs::new("linecount", []))
        $.with(Args=arguments, FsRead=MemoryFs::new(), Console=console):
            assert_equal(main!(), ExitCode(0))
        assert_equal(console.output().join(""), "0 total\n")
