use pkg.{QuoteError, Quotes, order_total}
use std.time.{Clock, ManualClock, Timestamp}
use std.testing.assert_equal

struct FlatQuotes:
    cents: i64

impl Quotes for FlatQuotes:
    fn quote!(&mut self, sku: string) -> Result[i64, QuoteError]:
        .Ok(self.cents)

it("prices a public order through the package root"):
    quotes := box(FlatQuotes { cents: 150 })
    clock := ManualClock::new(Timestamp::from_unix_milliseconds(0))
    $.with(Quotes=quotes, Clock=clock):
        assert_equal(order_total!(["a", "b", "c"]), .Ok(450), reason="three skus at 150")
