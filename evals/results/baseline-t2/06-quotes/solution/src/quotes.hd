use std.task.map_join
use std.time.{Clock, sleep, ms}

## Why a quote failed.
@derive(Eq, Debug)
pub enum QuoteError:
    Busy
    Unknown(sku: string)

## A price service: the caller supplies one.
pub trait Quotes:
    fn quote!(&mut self, sku: string) -> Result[i64, QuoteError]

## One sku: up to 3 attempts, about 10 ms between them.
fn quote_sku!(sku: string) -> Result[i64, QuoteError] $ Quotes + Clock:
    quotes := $.use(Quotes)
    let attempt = 1
    let mut result = quotes.quote!(sku)
    while result.is_err() && attempt < 3:
        sleep!(10ms)
        attempt += 1
        result = quotes.quote!(sku)
    result

## The total price of `skus`, in cents. Quotes at most 4 skus at a time; the
## error, if any, is that of the first failing sku in list order.
pub fn order_total!(skus: List[string]) -> Result[i64, QuoteError] $ Quotes + Clock:
    results := map_join!(skus, 4, quote_sku)
    let total: i64 = 0
    for result in results:
        cents := result?
        total += cents
    .Ok(total)

tests:
    use std.time.{ManualClock, Timestamp}

    struct FakeQuotes:
        prices: Map[string, i64]
        busy: Map[string, usize]
        calls: List[string]

    impl Quotes for FakeQuotes:
        fn quote!(&mut self, sku: string) -> Result[i64, QuoteError]:
            self.calls.push(sku)
            let left = self.busy.get(sku).unwrap_or(0)
            if left > 0:
                self.busy[sku] = left - 1
                return .Err(.Busy)
            match self.prices.get(sku):
                .Some(cents) => .Ok(cents)
                .None => .Err(.Unknown(sku))

    it("an empty order totals 0"):
        fake := box(FakeQuotes { prices: {}, busy: {}, calls: [] })
        clock := ManualClock::new(Timestamp::from_unix_milliseconds(0))
        $.with(Quotes=fake, Clock=clock):
            assert_equal(order_total!([]), .Ok(0))
        assert_equal(fake.calls.len(), 0, reason="nothing to quote")

    it("sums the prices of every sku"):
        fake := box(FakeQuotes { prices: { "tea": 300, "cake": 400 }, busy: {}, calls: [] })
        clock := ManualClock::new(Timestamp::from_unix_milliseconds(0))
        $.with(Quotes=fake, Clock=clock):
            assert_equal(order_total!(["tea", "cake", "tea"]), .Ok(1000))
        assert_equal(fake.calls.len(), 3, reason="one attempt each")

    it("retries a busy sku and then counts its price"):
        fake := box(FakeQuotes { prices: { "tea": 300 }, busy: { "tea": 2 }, calls: [] })
        clock := ManualClock::new(Timestamp::from_unix_milliseconds(0))
        $.with(Quotes=fake, Clock=clock):
            assert_equal(order_total!(["tea"]), .Ok(300))
        assert_equal(fake.calls.len(), 3, reason="two busy answers, then the price")

    it("gives a sku up after 3 attempts"):
        fake := box(FakeQuotes { prices: { "tea": 300 }, busy: { "tea": 9 }, calls: [] })
        clock := ManualClock::new(Timestamp::from_unix_milliseconds(0))
        $.with(Quotes=fake, Clock=clock):
            assert_equal(order_total!(["tea"]), .Err(.Busy))
        assert_equal(fake.calls.len(), 3, reason="at most 3 attempts")

    it("reports the first failing sku in list order"):
        fake := box(FakeQuotes { prices: { "tea": 300 }, busy: {}, calls: [] })
        clock := ManualClock::new(Timestamp::from_unix_milliseconds(0))
        $.with(Quotes=fake, Clock=clock):
            assert_equal(order_total!(["tea", "nope", "gone"]), .Err(.Unknown("nope")))
