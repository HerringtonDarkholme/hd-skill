use std.encoding.{Deserialize}
use std.encoding.json.{JsonError, decode}
use std.fs.{FsError, FsRead, FsWrite, MemoryFs, read_text, write_text}
use std.host.{Env, HostError, ScriptedEnv, env_as}
use std.path.Path
use std.validate.{Validate, ValidationError, length, range}

## A service's settings: loaded from JSON, checked by the rules on its fields.
@derive(Deserialize, Validate, Eq, Debug)
pub struct Config:
    @length(1, 253)
    pub host: string
    @range(1024, 65535)
    pub port: i32
    @range(1, 64)
    pub workers: i32 = 4

@error
pub enum ConfigError:
    @error("cannot read the config file: $error")
    Read(
        @from
        error: FsError,
    )
    @error("the config file is not valid JSON for a Config: $error")
    Parse(
        @from
        error: JsonError,
    )
    @error("$error")
    Environment(
        @from
        error: HostError,
    )
    @error("$error")
    Invalid(
        @from
        error: ValidationError,
    )

## `APP_PORT`, when set, replaces the port from the file.
fn with_port_override(config: Config) -> Result[Config, ConfigError] $ Env:
    port := env_as::[i32]("APP_PORT")?.unwrap_or(config.port)
    .Ok(Config { ...config, port: port })

## Reads the JSON config at `path`, applies `APP_PORT`, then checks the rules.
pub fn load_config!(path: string) -> Result[Config, ConfigError] $ FsRead + Env:
    config := decode::[Config](read_text!(Path(path))?)?
    overridden := with_port_override(config)?
    .Ok(overridden.validated()?)

tests:
    fn attempt!(text: string, vars: Map[string, string]) -> Result[Config, ConfigError]:
        fs := MemoryFs::new()
        $.with(FsWrite=fs):
            _ := write_text!(Path("config.json"), text)
        $.with(FsRead=fs, Env=box(ScriptedEnv::new(vars))):
            return load_config!("config.json")

    fn failure_kind(result: Result[Config, ConfigError]) -> string:
        match result:
            .Ok(_) => "ok"
            .Err(.Read(_)) => "read"
            .Err(.Parse(_)) => "parse"
            .Err(.Environment(_)) => "environment"
            .Err(.Invalid(_)) => "invalid"

    it("loads the file and defaults workers to 4"):
        result := attempt!("{\"host\": \"localhost\", \"port\": 8080}", {})
        assert_equal(result.ok(), .Some(Config { host: "localhost", port: 8080, workers: 4 }))

    it("reads every field the file sets"):
        result := attempt!("{\"host\": \"api.local\", \"port\": 3000, \"workers\": 8}", {})
        assert_equal(result.ok(), .Some(Config { host: "api.local", port: 3000, workers: 8 }))

    it("replaces the port with APP_PORT"):
        result := attempt!("{\"host\": \"localhost\", \"port\": 8080}", { "APP_PORT": "9000" })
        assert_equal(result.ok().map(fn(config): config.port), .Some(9000))

    it("reports a missing file as Read"):
        $.with(FsRead=MemoryFs::new(), Env=box(ScriptedEnv::new({}))):
            assert_equal(failure_kind(load_config!("missing.json")), "read")

    it("reports text that is not a Config as Parse"):
        assert_equal(failure_kind(attempt!("not json", {})), "parse")

    it("reports a JSON object missing host as Parse"):
        assert_equal(failure_kind(attempt!("{\"port\": 8080}", {})), "parse")

    it("reports a non-integer APP_PORT as Environment"):
        result := attempt!("{\"host\": \"localhost\", \"port\": 8080}", { "APP_PORT": "http" })
        assert_equal(failure_kind(result), "environment")

    it("reports an APP_PORT outside 1024 to 65535 as Invalid"):
        result := attempt!("{\"host\": \"localhost\", \"port\": 8080}", { "APP_PORT": "80" })
        assert_equal(failure_kind(result), "invalid")

    it("accepts host lengths 1 and 253"):
        one := attempt!("{\"host\": \"a\", \"port\": 8080}", {})
        assert_equal(failure_kind(one), "ok")
        longest := "a".repeat(253)
        full := attempt!("{\"host\": \"${longest}\", \"port\": 8080}", {})
        assert_equal(failure_kind(full), "ok")

    it("rejects an empty host and a 254-character host as Invalid"):
        assert_equal(failure_kind(attempt!("{\"host\": \"\", \"port\": 8080}", {})), "invalid")
        longest := "a".repeat(254)
        assert_equal(
            failure_kind(attempt!("{\"host\": \"${longest}\", \"port\": 8080}", {})),
            "invalid",
        )

    it("accepts ports 1024 and 65535 and rejects 1023 and 65536"):
        assert_equal(failure_kind(attempt!("{\"host\": \"h\", \"port\": 1024}", {})), "ok")
        assert_equal(failure_kind(attempt!("{\"host\": \"h\", \"port\": 65535}", {})), "ok")
        assert_equal(failure_kind(attempt!("{\"host\": \"h\", \"port\": 1023}", {})), "invalid")
        assert_equal(failure_kind(attempt!("{\"host\": \"h\", \"port\": 65536}", {})), "invalid")

    it("accepts workers 1 and 64 and rejects 0 and 65"):
        assert_equal(
            failure_kind(attempt!("{\"host\": \"h\", \"port\": 8080, \"workers\": 1}", {})),
            "ok",
        )
        assert_equal(
            failure_kind(attempt!("{\"host\": \"h\", \"port\": 8080, \"workers\": 64}", {})),
            "ok",
        )
        assert_equal(
            failure_kind(attempt!("{\"host\": \"h\", \"port\": 8080, \"workers\": 0}", {})),
            "invalid",
        )
        assert_equal(
            failure_kind(attempt!("{\"host\": \"h\", \"port\": 8080, \"workers\": 65}", {})),
            "invalid",
        )

    it("checks the overridden port, not only the file's"):
        result := attempt!("{\"host\": \"h\", \"port\": 8080}", { "APP_PORT": "1023" })
        assert_equal(failure_kind(result), "invalid")
