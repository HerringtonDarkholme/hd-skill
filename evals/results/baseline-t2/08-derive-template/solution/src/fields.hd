## A struct that can list its field names, in declaration order.
pub trait FieldNames:
    fn field_names(self) -> List[string]

tests:
    it("a hand-written implementation returns its names"):
        assert_equal(Point { x: 1, y: 2 }.field_names(), ["x", "y"], reason="declaration order")

struct Point:
    x: i32
    y: i32

impl FieldNames for Point:
    fn field_names(self) -> List[string]: ["x", "y"]
