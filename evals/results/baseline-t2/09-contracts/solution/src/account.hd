use std.contract.require

# An account holds a balance in cents.
#
# Invariants, true after every call that returns:
#   - the balance is never negative;
#   - `transfer` keeps the total of the two balances.
#
# Misuse (a bad amount, an overdraft) is a programming error, so it stops the
# program through `require`. The checks run in debug and test builds only and
# cost nothing in release builds.

pub struct Account:
    cents: i64

pub fn open(cents: i64) -> Account:
    require("opening balance must not be negative", fn(): cents >= 0)
    account := Account { cents: cents }
    check_invariant(&account)
    account

pub fn transfer(from: &mut Account, to: &mut Account, cents: i64) -> void:
    require("transfer amount must be positive", fn(): cents > 0)
    require("transfer amount must not exceed the balance", fn(): cents <= from.cents)
    total_before := from.cents + to.cents
    from.cents -= cents
    to.cents += cents
    require("transfer must keep the total", fn(): from.cents + to.cents == total_before)
    check_invariant(from)
    check_invariant(to)

fn check_invariant(account: &Account) -> void:
    require("balance must never be negative", fn(): account.cents >= 0)

impl Account:
    pub fn balance(self) -> i64:
        self.cents

    pub fn deposit(&mut self, cents: i64) -> void:
        require("deposit amount must be positive", fn(): cents > 0)
        self.cents += cents
        check_invariant(self)

    pub fn withdraw(&mut self, cents: i64) -> void:
        require("withdrawal amount must be positive", fn(): cents > 0)
        require("withdrawal amount must not exceed the balance", fn(): cents <= self.cents)
        self.cents -= cents
        check_invariant(self)

tests:
    it("opens with the given balance"):
        account := open(500)
        assert_equal(account.balance(), 500)

    it("opens an empty account"):
        assert_equal(open(0).balance(), 0)

    it("deposits add to the balance"):
        let mut account = open(100)
        account.deposit(250)
        assert_equal(account.balance(), 350)

    it("withdrawals subtract from the balance"):
        let mut account = open(100)
        account.withdraw(100)
        assert_equal(account.balance(), 0)

    it("a transfer moves money and keeps the total"):
        let mut from = open(1000)
        let mut to = open(200)
        transfer(&mut from, &mut to, 300)
        assert_equal(from.balance(), 700)
        assert_equal(to.balance(), 500)
        assert_equal(from.balance() + to.balance(), 1200)

    it("a transfer may empty the source account"):
        let mut from = open(40)
        let mut to = open(0)
        transfer(&mut from, &mut to, 40)
        assert_equal(from.balance(), 0)
        assert_equal(to.balance(), 40)
