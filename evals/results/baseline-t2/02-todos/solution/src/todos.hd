use std.encoding.json.{decode, encode}
use std.encoding.{Deserialize, Serialize}

## A todo item. `done` is false when the JSON omits it.
@derive(Eq, Debug, Serialize, Deserialize)
pub struct Todo:
    pub id: i32
    pub title: string
    pub done: bool = false

@derive(Eq, Debug)
pub enum TodoError:
    BadJson(message: string)
    UnknownId(id: i32)

## Reads a JSON array of `{"id", "title", "done"}` objects.
pub fn load(json: string) -> Result[List[Todo], TodoError]:
    match decode::[List[Todo]](json):
        .Ok(todos) => .Ok(todos)
        .Err(error) => .Err(.BadJson("${error}"))

## Writes `todos` as a JSON array that `load` reads back unchanged.
pub fn dump(todos: List[Todo]) -> string:
    encode(todos)

## Marks the todo with `id` as done.
pub fn complete(todos: List[Todo], id: i32) -> Result[List[Todo], TodoError]:
    let mut result: List[Todo] = []
    let found = false
    for item in todos:
        if item.id == id:
            found = true
            result.push(Todo { ...item, done: true })
        else:
            result.push(item)
    if !found:
        return .Err(.UnknownId(id))
    .Ok(result)

## The titles of the todos that are not done, in order.
pub fn pending(todos: List[Todo]) -> List[string]:
    let mut titles: List[string] = []
    for item in todos:
        if !item.done:
            titles.push(item.title)
    titles

tests:
    it("loads a valid array"):
        result := load(
            "[{\"id\": 1, \"title\": \"milk\", \"done\": true}, {\"id\": 2, \"title\": \"eggs\", \"done\": false}]",
        )
        assert_equal(
            result,
            .Ok(
                [
                    Todo { id: 1, title: "milk", done: true },
                    Todo { id: 2, title: "eggs", done: false },
                ],
            ),
        )

    it("treats a missing done as false"):
        assert_equal(
            load("[{\"id\": 3, \"title\": \"tea\"}]"),
            .Ok([Todo { id: 3, title: "tea", done: false }]),
        )

    it("loads an empty array"):
        assert_equal(load("[]"), .Ok([]))

    it("rejects a non-array"):
        assert(load("{\"id\": 1, \"title\": \"x\"}").is_err())
        assert(load("\"hello\"").is_err())

    it("rejects malformed JSON"):
        assert(load("[{\"id\": 1, \"title\": \"x\"").is_err())
        assert(load("").is_err())

    it("rejects a missing or mistyped field"):
        assert(load("[{\"title\": \"x\"}]").is_err())
        assert(load("[{\"id\": 1}]").is_err())
        assert(load("[{\"id\": \"1\", \"title\": \"x\"}]").is_err())
        assert(load("[{\"id\": 1.5, \"title\": \"x\"}]").is_err())
        assert(load("[{\"id\": 1, \"title\": \"x\", \"done\": \"yes\"}]").is_err())

    it("reports bad JSON as BadJson"):
        match load("[1, 2]"):
            .Err(.BadJson(message)) => assert(message != "")
            _ => panic("expected BadJson")

    it("dump round-trips through load"):
        todos := [
            Todo { id: 1, title: "milk", done: true },
            Todo { id: 2, title: "say \"hi\"", done: false },
        ]
        assert_equal(load(dump(todos)), .Ok(todos))

    it("dump of an empty list reads back"):
        assert_equal(load(dump([])), .Ok([]))

    it("complete marks one todo done"):
        todos := [
            Todo { id: 1, title: "milk", done: false },
            Todo { id: 2, title: "eggs", done: false },
        ]
        assert_equal(
            complete(todos, 2),
            .Ok(
                [
                    Todo { id: 1, title: "milk", done: false },
                    Todo { id: 2, title: "eggs", done: true },
                ],
            ),
        )

    it("complete on an unknown id is an error"):
        todos := [Todo { id: 1, title: "milk", done: false }]
        assert_equal(complete(todos, 9), .Err(.UnknownId(9)))

    it("complete does not change the input"):
        todos := [Todo { id: 1, title: "milk", done: false }]
        _ := complete(todos, 1)
        assert_equal(todos[0].done, false)

    it("pending lists undone titles in order"):
        todos := [
            Todo { id: 1, title: "a", done: false },
            Todo { id: 2, title: "b", done: true },
            Todo { id: 3, title: "c" },
        ]
        assert_equal(pending(todos), ["a", "c"])

    it("pending of nothing is empty"):
        assert_equal(pending([]), [])
