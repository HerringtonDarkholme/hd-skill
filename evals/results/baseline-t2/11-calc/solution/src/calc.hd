## Errors from evaluating an expression.
@derive(Eq, Debug)
pub enum CalcError:
    DivideByZero
    # `at` is the byte offset where parsing failed.
    Unexpected(at: usize)

# One lexical token. `at` is its byte offset in the source.
enum Kind:
    Number(i64)
    Plus
    Minus
    Star
    Slash
    LParen
    RParen
    # a character or number the grammar can never accept
    Invalid
    End

struct Token:
    kind: Kind
    at: usize

enum BinOp:
    Add
    Sub
    Mul
    Div

# The syntax tree. A recursive variant holds its children boxed.
enum Expr:
    Num(i64)
    Neg(*Expr)
    Bin(BinOp, *Expr, *Expr)

fn operator(b: u8) -> Kind?:
    if b == 43:
        return .Some(.Plus)
    if b == 45:
        return .Some(.Minus)
    if b == 42:
        return .Some(.Star)
    if b == 47:
        return .Some(.Slash)
    if b == 40:
        return .Some(.LParen)
    if b == 41:
        return .Some(.RParen)
    .None

# `value * 10 + digit`, or `.None` when the result does not fit in i64.
fn push_digit(value: i64, digit: i64) -> i64?:
    value.checked_mul(10)?.checked_add(digit)

fn tokenize(src: string) -> List[Token]:
    let bytes = src.to_utf8()
    let mut tokens: List[Token] = []
    let at: usize = 0
    while at < bytes.len():
        b := bytes[at]
        if b == 32:
            at += 1
        else if b >= 48 && b <= 57:
            start := at
            let value: i64 = 0
            let overflow = false
            while at < bytes.len() && bytes[at] >= 48 && bytes[at] <= 57:
                match push_digit(value, i64(bytes[at] - 48)):
                    .Some(next) => value = next
                    .None => overflow = true
                at += 1
            if overflow:
                tokens.push(Token { kind: .Invalid, at: start })
            else:
                tokens.push(Token { kind: .Number(value), at: start })
        else:
            match operator(b):
                .Some(kind) => tokens.push(Token { kind: kind, at: at })
                .None => tokens.push(Token { kind: .Invalid, at: at })
            at += 1
    tokens.push(Token { kind: .End, at: bytes.len() })
    tokens

struct Parser:
    tokens: List[Token]
    at: usize

impl Parser:
    fn kind(&self) -> Kind:
        self.tokens[self.at].kind

    # The error for the current token: it cannot be accepted here.
    fn fail(&self) -> CalcError:
        .Unexpected(self.tokens[self.at].at)

    fn additive(&self) -> BinOp?:
        match self.kind():
            .Plus => .Some(.Add)
            .Minus => .Some(.Sub)
            _ => .None

    fn multiplicative(&self) -> BinOp?:
        match self.kind():
            .Star => .Some(.Mul)
            .Slash => .Some(.Div)
            _ => .None

    # expr := term (('+' | '-') term)*
    fn expr(&mut self) -> Result[Expr, CalcError]:
        let mut left = self.term()?
        while true:
            match self.additive():
                .Some(op) =>
                    self.at += 1
                    right := self.term()?
                    left = Expr.Bin(op, box(left), box(right))
                .None => break
        .Ok(left)

    # term := unary (('*' | '/') unary)*
    fn term(&mut self) -> Result[Expr, CalcError]:
        let mut left = self.unary()?
        while true:
            match self.multiplicative():
                .Some(op) =>
                    self.at += 1
                    right := self.unary()?
                    left = Expr.Bin(op, box(left), box(right))
                .None => break
        .Ok(left)

    # unary := '-' unary | primary
    fn unary(&mut self) -> Result[Expr, CalcError]:
        match self.kind():
            .Minus =>
                self.at += 1
                .Ok(Expr.Neg(box(self.unary()?)))
            _ => self.primary()

    # primary := NUMBER | '(' expr ')'
    fn primary(&mut self) -> Result[Expr, CalcError]:
        match self.kind():
            .Number(n) =>
                self.at += 1
                .Ok(Expr.Num(n))
            .LParen =>
                self.at += 1
                inner := self.expr()?
                match self.kind():
                    .RParen => self.at += 1
                    _ => return .Err(self.fail())
                .Ok(inner)
            _ => .Err(self.fail())

fn parse(tokens: List[Token]) -> Result[Expr, CalcError]:
    let mut parser = Parser { tokens: tokens, at: 0 }
    tree := parser.expr()?
    match parser.kind():
        .End => .Ok(tree)
        _ => .Err(parser.fail())

fn apply(op: BinOp, left: i64, right: i64) -> Result[i64, CalcError]:
    match op:
        .Add => .Ok(left.wrapping_add(right))
        .Sub => .Ok(left.wrapping_sub(right))
        .Mul => .Ok(left.wrapping_mul(right))
        .Div =>
            if right == 0:
                return .Err(.DivideByZero)
            # `checked_div` fails only for a zero divisor (handled above) or
            # i64::MIN / -1, whose wrapped result is i64::MIN, i.e. `left`.
            match left.checked_div(right):
                .Some(quotient) => .Ok(quotient)
                .None => .Ok(left)

fn evaluate(e: &Expr) -> Result[i64, CalcError]:
    match e:
        .Num(n) => .Ok(n)
        .Neg(inner) => apply(.Sub, 0, evaluate(inner)?)
        .Bin(op, l, r) =>
            a := evaluate(l)?
            b := evaluate(r)?
            apply(op, a, b)

## Evaluates an integer expression: decimal literals, `+ - * /`,
## parentheses and unary minus. Spaces may appear between tokens.
pub fn eval(src: string) -> Result[i64, CalcError]:
    tree := parse(tokenize(src))?
    evaluate(&tree)
