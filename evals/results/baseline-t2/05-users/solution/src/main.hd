use pkg.users.{User, UserError, UserStore, rename}

struct MemoryStore:
    users: Map[i64, User]

impl UserStore for MemoryStore:
    fn get!(&mut self, id: i64) -> User?:
        self.users.get(id)

    fn put!(&mut self, user: User) -> void:
        self.users[user.id] = user

fn message(error: UserError) -> string:
    match error:
        .NotFound(id) => "no user $id"
        .EmptyName => "name is empty"

pub fn main!() -> void $ Console:
    store := box(MemoryStore { users: { 1: User { id: 1, name: "ada" } } })
    $.with(UserStore=store):
        match rename!(1, "Ada Lovelace"):
            .Ok(user) => println("renamed ${user.id} to ${user.name}")
            .Err(error) => println("error: ${message(error)}")
        match rename!(2, "Grace"):
            .Ok(user) => println("renamed ${user.id} to ${user.name}")
            .Err(error) => println("error: ${message(error)}")

tests:
    use std.console.MemoryConsole

    it("prints the rename and the missing-user error"):
        console := MemoryConsole::new()
        $.with(Console=console):
            main!()
        assert_equal(console.output().join(""), "renamed 1 to Ada Lovelace\nerror: no user 2\n")
