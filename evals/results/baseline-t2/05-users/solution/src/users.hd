@derive(Eq, Debug)
pub struct User:
    pub id: i64
    pub name: string

@derive(Eq, Debug)
pub enum UserError:
    NotFound(id: i64)
    EmptyName

pub trait UserStore:
    fn get!(&mut self, id: i64) -> User?
    fn put!(&mut self, user: User) -> void

## Rename user `id` to the trimmed `name`, storing the change once.
pub fn rename!(id: i64, name: string) -> Result[User, UserError] $ UserStore:
    trimmed := name.trim()
    if trimmed == "":
        return .Err(.EmptyName)
    store := $.use(UserStore)
    let .Some(user) = store.get!(id) else:
        return .Err(.NotFound(id))
    renamed := User { id: user.id, name: trimmed }
    store.put!(renamed)
    .Ok(renamed)

tests:
    struct FakeStore:
        users: Map[i64, User]
        puts: i64 = 0

    impl UserStore for FakeStore:
        fn get!(&mut self, id: i64) -> User?:
            self.users.get(id)

        fn put!(&mut self, user: User) -> void:
            self.puts += 1
            self.users[user.id] = user

    it("renames a user, trimming the name, and stores it once"):
        store := box(FakeStore { users: { 1: User { id: 1, name: "ada" } } })
        $.with(UserStore=store):
            result := rename!(1, "  Ada Lovelace ")
            assert_equal(result, .Ok(User { id: 1, name: "Ada Lovelace" }))
        assert_equal(store.puts, 1, reason="one put")
        assert_equal(store.users.get(1), .Some(User { id: 1, name: "Ada Lovelace" }))

    it("refuses an empty name and stores nothing"):
        store := box(FakeStore { users: { 1: User { id: 1, name: "ada" } } })
        $.with(UserStore=store):
            assert_equal(rename!(1, "   "), .Err(.EmptyName))
        assert_equal(store.puts, 0, reason="no put on an empty name")
        assert_equal(store.users.get(1), .Some(User { id: 1, name: "ada" }))

    it("reports a missing user and stores nothing"):
        store := box(FakeStore { users: { 1: User { id: 1, name: "ada" } } })
        $.with(UserStore=store):
            assert_equal(rename!(2, "Grace"), .Err(.NotFound(2)))
        assert_equal(store.puts, 0, reason="no put for a missing user")
