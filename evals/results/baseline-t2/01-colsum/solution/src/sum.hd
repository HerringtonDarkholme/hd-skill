use std.cmp.max

## A line that cannot be summed. Line numbers start at 1.
@error
@derive(Eq, Debug)
pub enum SumError:
    @error("line $line: missing column")
    MissingColumn(line: usize)
    @error("line $line: not an integer: $text")
    NotANumber(line: usize, text: string)

## Sums the `value` column of each line, grouped by the `key` column.
## Columns are 1-based and split on commas; blank lines are ignored and
## keys and values are trimmed. The result is sorted by key.
pub fn summarize(text: string, key: usize, value: usize, skip_header: bool) -> Result[List[(string, i64)], SumError]:
    let mut totals: Map[string, i64] = {}
    let needed = max(key, value)
    for (index, line) in text.lines().iter().enumerate():
        number := index + 1
        if (skip_header && number == 1) || line.trim() == "":
            continue
        fields := line.split(",")
        # Column 0 does not exist, so every data line lacks it.
        if key == 0 || value == 0 || fields.len() < needed:
            return .Err(.MissingColumn(number))
        name := fields[key - 1].trim()
        raw := fields[value - 1].trim()
        amount := match raw.parse::[i64]():
            .Ok(amount) => amount
            .Err(_) => return .Err(.NotANumber(number, raw))
        *totals.get_or_insert(name, 0) += amount
    .Ok(totals.entries().sorted_by_key(fn(entry): entry._0))

tests:
    it("sums a column grouped by another, sorted by key"):
        assert_equal(summarize("b,1\na,2\nb,3\n", 1, 2, false), .Ok([("a", 2), ("b", 4)]))

    it("reads the columns it is asked for, in any order"):
        assert_equal(summarize("5,a,x\n7,a,y\n", 2, 1, false), .Ok([("a", 12)]))
        assert_equal(summarize("1,2,3,4\n", 4, 3, false), .Ok([("4", 3)]))

    it("trims spaces from keys and values"):
        assert_equal(summarize("  b , 1 \n a ,2\n", 1, 2, false), .Ok([("a", 2), ("b", 1)]))

    it("skips the header only when asked"):
        assert_equal(summarize("name,amount\na,1\n", 1, 2, true), .Ok([("a", 1)]))
        assert_equal(summarize("name,amount\na,1\n", 1, 2, false), .Err(.NotANumber(1, "amount")))

    it("ignores blank lines but counts them in line numbers"):
        assert_equal(summarize("a,1\n\n   \nb,x\n", 1, 2, false), .Err(.NotANumber(4, "x")))
        assert_equal(summarize("\na,1\n\n", 1, 2, false), .Ok([("a", 1)]))

    it("reports a line with too few columns"):
        assert_equal(summarize("a,1\nb\n", 1, 2, false), .Err(.MissingColumn(2)))
        assert_equal(summarize("a,1\n", 1, 3, false), .Err(.MissingColumn(1)))

    it("treats column 0 as missing"):
        assert_equal(summarize("a,1\n", 0, 2, false), .Err(.MissingColumn(1)))

    it("sums signed integers"):
        assert_equal(summarize("a,-5\na,2\n", 1, 2, false), .Ok([("a", -3)]))

    it("rejects a value that is not an integer, with its trimmed text"):
        assert_equal(summarize("a, 1.5 \n", 1, 2, false), .Err(.NotANumber(1, "1.5")))

    it("gives nothing for empty input"):
        assert_equal(summarize("", 1, 2, false), .Ok([]))
