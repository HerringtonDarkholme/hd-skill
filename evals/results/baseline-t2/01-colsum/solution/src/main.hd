use std.cli.{Args, Cli, ScriptedArgs}
use std.console.{ConsoleInput, MemoryConsole, ScriptedInput, eprintln, read_all}
use std.process.ExitCode
use pkg.sum.summarize

## Sum one CSV column, grouped by another, and print a `key,total` line per key.
@derive(Cli)
struct Options:
    ## the 1-based column to group by
    key: usize = 1
    ## the 1-based column to sum
    value: usize = 2
    ## ignore the first line
    skip_header: bool

pub fn main!() -> ExitCode $ Args + Console + ConsoleInput:
    options := match Options::parse_args():
        .Ok(options) => options
        .Err(error) => return error.exit()
    if options.key == 0 || options.value == 0:
        eprintln("colsum: columns are numbered from 1")
        return ExitCode(2)
    text := match read_all!():
        .Ok(text) => text
        .Err(error) =>
            eprintln("colsum: $error")
            return ExitCode(1)
    match summarize(text, options.key, options.value, options.skip_header):
        .Ok(totals) =>
            for (key, total) in totals:
                println("$key,$total")
            ExitCode(0)
        .Err(error) =>
            eprintln("colsum: $error")
            ExitCode(1)

tests:
    it("prints sorted totals from standard input"):
        arguments := box(ScriptedArgs::new("colsum", ["--skip-header"]))
        input := ScriptedInput::new(["name,amount", "b,2", "a,1", "b,3"])
        console := MemoryConsole::new()
        $.with(Args=arguments, ConsoleInput=input, Console=console):
            assert_equal(main!(), ExitCode(0))
        assert_equal(console.output().join(""), "a,1\nb,5\n")

    it("uses the given columns"):
        arguments := box(ScriptedArgs::new("colsum", ["--key", "2", "--value", "1"]))
        input := ScriptedInput::new(["5,x", "7,x"])
        console := MemoryConsole::new()
        $.with(Args=arguments, ConsoleInput=input, Console=console):
            assert_equal(main!(), ExitCode(0))
        assert_equal(console.output().join(""), "x,12\n")

    it("reports a bad line on standard error and prints nothing else"):
        arguments := box(ScriptedArgs::new("colsum", []))
        input := ScriptedInput::new(["a,1", "b,oops"])
        console := MemoryConsole::new()
        $.with(Args=arguments, ConsoleInput=input, Console=console):
            assert_equal(main!(), ExitCode(1))
        assert_equal(console.output().join(""), "")
        assert_equal(console.error_output().join(""), "colsum: line 2: not an integer: oops\n")
