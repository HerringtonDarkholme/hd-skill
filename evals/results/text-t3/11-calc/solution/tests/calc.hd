use pkg.{CalcError, eval}
use std.testing.assert_equal

it("evaluates through the public API"):
    assert_equal(eval("2 * (3 + 4) - 10 / 5"), .Ok(12))

it("reports the public error"):
    assert_equal(eval("8 / (2 - 2)"), .Err(CalcError.DivideByZero))
    assert_equal(eval("1 +"), .Err(CalcError.Unexpected(3)))
