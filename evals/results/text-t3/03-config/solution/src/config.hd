use std.encoding.Deserialize
use std.encoding.json.{JsonError, decode}
use std.fs.{FsError, FsRead, MemoryFs, read_text, write_text}
use std.host.{Env, HostError, ScriptedEnv, env_as}
use std.path.Path
use std.validate.{Validate, ValidationError, length, range}

# The settings a service runs with. `workers` defaults to 4 when the file omits it.
@derive(Deserialize, Validate, Eq, Debug)
pub struct Config:
    @length(1, 253)
    pub host: string
    @range(1024, 65535)
    pub port: i32
    @range(1, 64)
    pub workers: i32 = 4

# Why a configuration could not be loaded.
@error
pub enum ConfigError:
    @error("cannot read the config file: $error")
    Read(@from error: FsError)
    @error("the config file is not valid JSON: $error")
    Parse(@from error: JsonError)
    @error("$error")
    Environment(@from error: HostError)
    @error("$error")
    Invalid(@from error: ValidationError)

# Read the JSON file at `path`, let `APP_PORT` replace the port, then check the rules.
pub fn load_config!(path: string) -> Result[Config, ConfigError] $ FsRead + Env:
    text := read_text!(Path(path))?
    config := decode::[Config](text)?
    port := env_as::[i32]("APP_PORT")?
    overridden := match port:
        .Some(value) => Config { ...config, port: value }
        .None => config
    .Ok(overridden.validated()?)

# A memory file system holding `text` as config.json.
fn stored!(text: string) -> MemoryFs:
    fs := MemoryFs::new()
    $.with(FsWrite=fs):
        _ := write_text!(Path("config.json"), text)
    fs

# Load config.json from `text` with the given environment, and name the outcome:
# "ok", or the kind of the error.
fn outcome!(text: string, vars: Map[string, string]) -> string:
    fs := stored!(text)
    let mut failure: ConfigError? = .None
    $.with(FsRead=fs, Env=box(ScriptedEnv::new(vars))):
        failure = load_config!("config.json").err()
    match failure:
        .Some(problem) => kind(problem)
        .None => "ok"

fn kind(problem: ConfigError) -> string:
    match problem:
        .Read(_) => "read"
        .Parse(_) => "parse"
        .Environment(_) => "environment"
        .Invalid(_) => "invalid"

tests:
    it("reads the file and fills in the default workers"):
        fs := stored!("{\"host\": \"example.com\", \"port\": 8080}")
        $.with(FsRead=fs, Env=box(ScriptedEnv::new({}))):
            config := load_config!("config.json").ok().expect("a valid config")
            assert_equal(config, Config { host: "example.com", port: 8080, workers: 4 })

    it("lets APP_PORT replace the port"):
        fs := stored!("{\"host\": \"example.com\", \"port\": 8080, \"workers\": 2}")
        $.with(FsRead=fs, Env=box(ScriptedEnv::new({"APP_PORT": "9000"}))):
            config := load_config!("config.json").ok().expect("a valid config")
            assert_equal(config, Config { host: "example.com", port: 9000, workers: 2 })

    it("reports a missing file as Read"):
        $.with(FsRead=MemoryFs::new(), Env=box(ScriptedEnv::new({}))):
            error := load_config!("missing.json").err().expect("an error")
            assert_equal(kind(error), "read")

    it("reports a file that is not JSON as Parse"):
        assert_equal(outcome!("{not json", {}), "parse")

    it("reports a field of the wrong type as Parse"):
        assert_equal(outcome!("{\"host\": \"example.com\", \"port\": \"8080\"}", {}), "parse")

    it("reports a non-integer APP_PORT as Environment"):
        assert_equal(outcome!("{\"host\": \"example.com\", \"port\": 8080}", {"APP_PORT": "http"}), "environment")

    it("checks the port after APP_PORT replaces it"):
        assert_equal(outcome!("{\"host\": \"example.com\", \"port\": 8080}", {"APP_PORT": "80"}), "invalid")
        assert_equal(outcome!("{\"host\": \"example.com\", \"port\": 8080}", {"APP_PORT": "70000"}), "invalid")

    it("checks the port in the file"):
        assert_equal(outcome!("{\"host\": \"example.com\", \"port\": 80}", {}), "invalid")
        assert_equal(outcome!("{\"host\": \"example.com\", \"port\": 1023}", {}), "invalid")
        assert_equal(outcome!("{\"host\": \"example.com\", \"port\": 1024}", {}), "ok")
        assert_equal(outcome!("{\"host\": \"example.com\", \"port\": 65535}", {}), "ok")
        assert_equal(outcome!("{\"host\": \"example.com\", \"port\": 65536}", {}), "invalid")

    it("checks the host length, 1 to 253 characters"):
        assert_equal(outcome!("{\"host\": \"\", \"port\": 8080}", {}), "invalid")
        assert_equal(outcome!("{\"host\": \"h\", \"port\": 8080}", {}), "ok")

    it("checks workers, 1 to 64"):
        assert_equal(outcome!("{\"host\": \"h\", \"port\": 8080, \"workers\": 0}", {}), "invalid")
        assert_equal(outcome!("{\"host\": \"h\", \"port\": 8080, \"workers\": 1}", {}), "ok")
        assert_equal(outcome!("{\"host\": \"h\", \"port\": 8080, \"workers\": 64}", {}), "ok")
        assert_equal(outcome!("{\"host\": \"h\", \"port\": 8080, \"workers\": 65}", {}), "invalid")
