use std.cli.{Args, ScriptedArgs, args}
use std.console.{MemoryConsole, eprintln}
use std.fs.{FsError, FsRead, FsWrite, MemoryFs, create_dir_all, read_bytes, write_bytes}
use std.path.Path
use std.process.ExitCode

## The number of lines in `bytes`: one per newline, plus one for a final
## line that has no newline. Bytes are counted, so any file is readable.
pub fn count_lines(bytes: List[u8]) -> usize:
    let lines: usize = 0
    for byte in bytes:
        if byte == 10:
            lines += 1
    if !bytes.is_empty() && bytes[bytes.len() - 1] != 10:
        lines += 1
    lines

# The line count of one file, or the reason it could not be read.
fn count_file!(file: string) -> Result[usize, FsError] $ FsRead:
    bytes := read_bytes!(Path(file))?
    .Ok(count_lines(bytes))

pub fn main!() -> ExitCode $ Args + Console + FsRead:
    let total: usize = 0
    let failed = false
    for file in args():
        match count_file!(file):
            .Ok(lines) =>
                println("$lines $file")
                total += lines
            .Err(error) =>
                eprintln("linecount: $file: $error")
                failed = true
    println("$total total")
    if failed: ExitCode(1) else: ExitCode(0)

tests:
    it("counts newline bytes"):
        assert_equal(count_lines([104, 105, 10, 33, 10]), 2)

    it("counts a final line with no newline"):
        assert_equal(count_lines([97, 10, 98]), 2)

    it("an empty file has no lines"):
        assert_equal(count_lines([]), 0)

    it("a lone newline is one line"):
        assert_equal(count_lines([10]), 1)

    it("prints each count, then the total"):
        fs := MemoryFs::new()
        console := MemoryConsole::new()
        $.with(FsWrite=fs):
            _ := create_dir_all!(Path("data"))
            _ := write_bytes!(Path("data/a.txt"), [97, 10, 98, 10])
            _ := write_bytes!(Path("data/b.txt"), [99])
        arguments := box(ScriptedArgs::new("linecount", ["data/a.txt", "data/b.txt"]))
        $.with(Args=arguments, FsRead=fs, Console=console):
            assert_equal(main!(), ExitCode(0))
        assert_equal(console.output().join(""), "2 data/a.txt\n1 data/b.txt\n3 total\n")
        assert_equal(console.error_output().join(""), "")

    it("skips an unreadable file, reports it, and exits 1"):
        fs := MemoryFs::new()
        console := MemoryConsole::new()
        $.with(FsWrite=fs):
            _ := create_dir_all!(Path("data"))
            _ := write_bytes!(Path("data/a.txt"), [10, 10])
        arguments := box(ScriptedArgs::new("linecount", ["data/missing.txt", "data/a.txt"]))
        $.with(Args=arguments, FsRead=fs, Console=console):
            assert_equal(main!(), ExitCode(1))
        assert_equal(console.output().join(""), "2 data/a.txt\n2 total\n")
        assert_equal(
            console.error_output().join(""),
            "linecount: data/missing.txt: not found: data/missing.txt\n",
        )
