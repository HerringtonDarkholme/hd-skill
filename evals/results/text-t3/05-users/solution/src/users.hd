## A stored user: an id and a display name.
@derive(Eq, Debug)
pub struct User:
    pub id: i64
    pub name: string

@error
@derive(Eq, Debug)
pub enum UserError:
    @error("no user $id")
    NotFound(id: i64)
    @error("the name is empty")
    EmptyName

## Where users live. Callers provide an implementation with `$.with`.
pub trait UserStore:
    fn get!(&mut self, id: i64) -> User?
    fn put!(&mut self, user: User) -> void

## Rename user `id` to `name`, with surrounding spaces trimmed.
## Nothing is stored unless the name is non-empty and the user exists.
pub fn rename!(id: i64, name: string) -> Result[User, UserError] $ UserStore:
    trimmed := name.trim()
    if trimmed == "":
        return .Err(.EmptyName)
    store := $.use(UserStore)
    let .Some(user) = store.get!(id) else:
        return .Err(.NotFound(id))
    renamed := User { id: user.id, name: trimmed }
    store.put!(renamed)
    .Ok(renamed)

tests:
    struct RecordingStore:
        users: Map[i64, User]
        puts: i64

    impl UserStore for RecordingStore:
        fn get!(&mut self, id: i64) -> User?:
            self.users.get(id)

        fn put!(&mut self, user: User) -> void:
            self.puts += 1
            self.users[user.id] = user

    it("renames a user and stores it once"):
        store := box(RecordingStore { users: { 1: User { id: 1, name: "ada" } }, puts: 0 })
        $.with(UserStore=store):
            assert_equal(rename!(1, "  Ada Lovelace  "), .Ok(User { id: 1, name: "Ada Lovelace" }))
        assert_equal(store.puts, 1, reason="one put")
        assert_equal(store.users[1], User { id: 1, name: "Ada Lovelace" })

    it("refuses a blank name and stores nothing"):
        store := box(RecordingStore { users: { 1: User { id: 1, name: "ada" } }, puts: 0 })
        $.with(UserStore=store):
            assert_equal(rename!(1, "   "), .Err(.EmptyName))
        assert_equal(store.puts, 0, reason="no put")
        assert_equal(store.users[1], User { id: 1, name: "ada" })

    it("refuses a missing user and stores nothing"):
        store := box(RecordingStore { users: { 1: User { id: 1, name: "ada" } }, puts: 0 })
        $.with(UserStore=store):
            assert_equal(rename!(2, "Grace"), .Err(.NotFound(2)))
        assert_equal(store.puts, 0, reason="no put")
        assert_equal(store.users.len(), 1)
