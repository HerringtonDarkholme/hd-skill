## One entry of the cache, linked into the recency order.
##
## `prev` and `next` are slot numbers in `Lru.nodes`; -1 means none.
struct Node:
    key: string
    value: i64
    prev: i64
    next: i64

## A least-recently-used cache from string keys to i64 values.
##
## Entries live in `nodes`, a fixed pool of at most `capacity` slots, linked
## into a doubly linked list from `head` (most recent) to `tail` (least
## recent). `index` maps each key to its slot.
pub struct Lru:
    capacity: usize
    index: Map[string, i64]
    nodes: List[Node]
    head: i64
    tail: i64

## A cache that holds at most `capacity` entries. Capacity 0 stores nothing.
pub fn new_lru(capacity: usize) -> Lru:
    Lru { capacity, index: {}, nodes: [], head: -1, tail: -1 }

impl Lru:
    ## The value for `key`, or `.None`. A hit makes `key` the most recent entry.
    pub fn get(&mut self, key: string) -> i64?:
        match self.index.get(key):
            .Some(slot) =>
                self.touch(slot)
                .Some(self.nodes[usize(slot)].value)
            .None => .None

    ## Inserts or updates `key`, makes it the most recent entry, then evicts
    ## the least recent entry when the cache is over capacity.
    pub fn put(&mut self, key: string, value: i64) -> void:
        if self.capacity == 0:
            return
        match self.index.get(key):
            .Some(slot) =>
                self.nodes[usize(slot)].value = value
                self.touch(slot)
            .None => self.insert_new(key, value)

    ## The number of entries.
    pub fn len(self) -> usize:
        self.index.len()

    ## Moves `slot` to the front of the recency list.
    fn touch(&mut self, slot: i64) -> void:
        if self.head == slot:
            return
        self.unlink(slot)
        self.push_front(slot)

    ## Removes `slot` from the recency list, leaving its node in place.
    fn unlink(&mut self, slot: i64) -> void:
        let prev = self.nodes[usize(slot)].prev
        let next = self.nodes[usize(slot)].next
        if prev >= 0:
            self.nodes[usize(prev)].next = next
        else:
            self.head = next
        if next >= 0:
            self.nodes[usize(next)].prev = prev
        else:
            self.tail = prev

    ## Links `slot`, which is not in the list, in front of the current head.
    fn push_front(&mut self, slot: i64) -> void:
        self.nodes[usize(slot)].prev = -1
        self.nodes[usize(slot)].next = self.head
        if self.head >= 0:
            self.nodes[usize(self.head)].prev = slot
        else:
            self.tail = slot
        self.head = slot

    ## Adds a key that is not cached. Reuses the least recent slot when full.
    fn insert_new(&mut self, key: string, value: i64) -> void:
        if self.index.len() < self.capacity:
            slot := i64(self.nodes.len())
            self.nodes.push(Node { key, value, prev: -1, next: -1 })
            _ := self.index.insert(key, slot)
            self.push_front(slot)
        else:
            slot := self.tail
            self.unlink(slot)
            _ := self.index.remove(self.nodes[usize(slot)].key)
            self.nodes[usize(slot)] = Node { key, value, prev: -1, next: -1 }
            _ := self.index.insert(key, slot)
            self.push_front(slot)

tests:
    use std.testing.{Choices, commands, it_prop_with}

    it("a new cache is empty"):
        let mut cache = new_lru(2)
        assert_equal(cache.len(), 0)
        assert_equal(cache.get("a"), .None)

    it("stores and reads back a value"):
        let mut cache = new_lru(2)
        cache.put("a", 1)
        assert_equal(cache.get("a"), .Some(1))
        assert_equal(cache.len(), 1)

    it("updates a value in place"):
        let mut cache = new_lru(2)
        cache.put("a", 1)
        cache.put("a", 5)
        assert_equal(cache.get("a"), .Some(5))
        assert_equal(cache.len(), 1)

    it("evicts the least recently used key"):
        let mut cache = new_lru(2)
        cache.put("a", 1)
        cache.put("b", 2)
        cache.put("c", 3)
        assert_equal(cache.get("a"), .None)
        assert_equal(cache.get("b"), .Some(2))
        assert_equal(cache.get("c"), .Some(3))
        assert_equal(cache.len(), 2)

    it("a hit makes a key most recent before eviction"):
        let mut cache = new_lru(2)
        cache.put("a", 1)
        cache.put("b", 2)
        assert_equal(cache.get("a"), .Some(1))
        cache.put("c", 3)
        assert_equal(cache.get("b"), .None)
        assert_equal(cache.get("a"), .Some(1))

    it("an update makes a key most recent before eviction"):
        let mut cache = new_lru(2)
        cache.put("a", 1)
        cache.put("b", 2)
        cache.put("a", 9)
        cache.put("c", 3)
        assert_equal(cache.get("b"), .None)
        assert_equal(cache.get("a"), .Some(9))

    it("a missed get changes nothing"):
        let mut cache = new_lru(2)
        cache.put("a", 1)
        cache.put("b", 2)
        assert_equal(cache.get("zz"), .None)
        cache.put("c", 3)
        assert_equal(cache.get("a"), .None)
        assert_equal(cache.get("b"), .Some(2))

    it("capacity one keeps only the latest key"):
        let mut cache = new_lru(1)
        cache.put("a", 1)
        cache.put("b", 2)
        assert_equal(cache.get("a"), .None)
        assert_equal(cache.get("b"), .Some(2))
        assert_equal(cache.len(), 1)

    it("capacity zero stores nothing"):
        let mut cache = new_lru(0)
        cache.put("a", 1)
        assert_equal(cache.get("a"), .None)
        assert_equal(cache.len(), 0)

    it("evicts in recency order over a longer run"):
        let mut cache = new_lru(3)
        cache.put("a", 1)
        cache.put("b", 2)
        cache.put("c", 3)
        _ := cache.get("a")
        cache.put("d", 4)
        assert_equal(cache.get("b"), .None)
        cache.put("e", 5)
        assert_equal(cache.get("c"), .None)
        assert_equal(cache.get("a"), .Some(1))
        assert_equal(cache.get("d"), .Some(4))
        assert_equal(cache.get("e"), .Some(5))

    # The model: the entries as a list ordered from most to least recent,
    # capped at the same capacity. The real cache must agree with it on
    # every get and on its length.
    @derive(Debug)
    enum Op:
        Put(key: string, value: i64)
        Get(key: string)

    fn key_of(c: &mut Choices) -> string:
        c.choose(["a", "b", "c", "d", "e"])

    fn next_op(c: &mut Choices, model: &List[(string, i64)]) -> Op?:
        if c.bool(): .Some(.Get(key_of(c))) else: .Some(.Put(key_of(c), c.int(-5..=5)))

    fn advance_op(model: &List[(string, i64)], op: &Op) -> List[(string, i64)]:
        let mut entries = *model
        match op:
            .Put(key, value) =>
                entries = entries.filter(fn(e): e._0 != key)
                entries.insert(0, (key, value))
                if entries.len() > 3:
                    _ := entries.pop()
            .Get(key) =>
                match entries.find(fn(e): e._0 == key):
                    .Some(e) =>
                        entries = entries.filter(fn(x): x._0 != key)
                        entries.insert(0, e)
                    .None => pass
        entries

    fn history(c: &mut Choices) -> List[Op]:
        let empty: List[(string, i64)] = []
        commands(c, max=40, initial=empty, next=next_op, advance=advance_op)

    it_prop_with("the cache follows a model of recency order", gen=history, prop=fn!(ops: List[Op]):
        let mut cache = new_lru(3)
        let mut model: List[(string, i64)] = []
        for op in ops:
            match op:
                .Put(key, value) => cache.put(key, value)
                .Get(key) =>
                    let expected: i64? = match model.find(fn(e): e._0 == key):
                        .Some(e) => .Some(e._1)
                        .None => .None
                    assert_equal(cache.get(key), expected, reason="get ${debug(op)}")
            model = advance_op(&model, &op)
            assert_equal(cache.len(), model.len(), reason="len after ${debug(op)}")
    )
