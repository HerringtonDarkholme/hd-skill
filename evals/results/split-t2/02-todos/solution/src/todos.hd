use std.convert.TryFrom
use std.encoding.json.{Json, JsonObject, Number, parse, encode}
use std.testing.assert_equal

## One item of a todo list.
@derive(Eq, Debug)
pub struct Todo:
    pub id: i32
    pub title: string
    pub done: bool

@error
@derive(Eq, Debug)
pub enum TodoError:
    @error("bad todo JSON: $message")
    BadJson(message: string)
    @error("no todo with id $id")
    UnknownId(id: i32)

fn bad(message: string) -> TodoError:
    TodoError.BadJson(message)

## Reads an `id` that is an integer in the i32 range.
fn read_id(fields: JsonObject) -> Result[i32, TodoError]:
    let .Some(value) = fields.get("id") else:
        return .Err(bad("missing id"))
    let .Some(raw) = value.as_i64() else:
        return .Err(bad("id must be an integer"))
    let .Some(id) = i32::try_from(raw).ok() else:
        return .Err(bad("id is out of range"))
    .Ok(id)

## Reads a `title` that is a string.
fn read_title(fields: JsonObject) -> Result[string, TodoError]:
    let .Some(value) = fields.get("title") else:
        return .Err(bad("missing title"))
    let .Some(title) = value.as_text() else:
        return .Err(bad("title must be a string"))
    .Ok(title)

## Reads an optional `done` boolean; absent means false.
fn read_done(fields: JsonObject) -> Result[bool, TodoError]:
    let .Some(value) = fields.get("done") else:
        return .Ok(false)
    let .Some(done) = value.as_bool() else:
        return .Err(bad("done must be a boolean"))
    .Ok(done)

fn parse_todo(item: Json) -> Result[Todo, TodoError]:
    let .Object(fields) = item else:
        return .Err(bad("each todo must be an object"))
    id := read_id(fields)?
    title := read_title(fields)?
    done := read_done(fields)?
    .Ok(Todo { id, title, done })

## Reads a JSON array of {"id", "title", "done"} objects.
pub fn load(json: string) -> Result[List[Todo], TodoError]:
    root := parse(json).map_err(fn(e): bad("not JSON: ${debug(e)}"))?
    let .Array(items) = root else:
        return .Err(bad("top level must be an array"))
    let mut todos: List[Todo] = []
    for item in items:
        todos.push(parse_todo(item)?)
    .Ok(todos)

## Writes the todos as a JSON array that `load` reads back unchanged.
pub fn dump(todos: List[Todo]) -> string:
    let mut items: List[Json] = []
    for todo in todos:
        let mut fields = JsonObject.new()
        fields.set("id", Json.Number(Number.from_i64(i64(todo.id))))
        fields.set("title", Json.Text(todo.title))
        fields.set("done", Json.Bool(todo.done))
        items.push(Json.Object(fields))
    encode(Json.Array(items))

## Marks the todo with `id` as done.
pub fn complete(todos: List[Todo], id: i32) -> Result[List[Todo], TodoError]:
    if !todos.any(fn(t): t.id == id):
        return .Err(TodoError.UnknownId(id))
    let mut out: List[Todo] = []
    for todo in todos:
        if todo.id == id:
            out.push(Todo { ...todo, done: true })
        else:
            out.push(todo)
    .Ok(out)

## The titles of the todos that are not done, in order.
pub fn pending(todos: List[Todo]) -> List[string]:
    todos.filter(fn(t): !t.done).map(fn(t): t.title)

tests:
    it("loads objects and defaults done to false"):
        assert_equal(
            load(
                "[{\"id\": 1, \"title\": \"tea\"}, {\"id\": 2, \"title\": \"jam\", \"done\": true}]",
            ),
            .Ok(
                [
                    Todo { id: 1, title: "tea", done: false },
                    Todo { id: 2, title: "jam", done: true },
                ],
            ),
        )

    it("loads an empty array"):
        assert_equal(load("[]"), .Ok([]))

    it("rejects input that is not an array of todos"):
        assert_equal(load("{}").is_err(), true)
        assert_equal(load("\"x\"").is_err(), true)
        assert_equal(load("[1]").is_err(), true)
        assert_equal(load("[{\"title\": \"x\"}]").is_err(), true)
        assert_equal(load("[{\"id\": 1}]").is_err(), true)
        assert_equal(load("[{\"id\": 1.5, \"title\": \"x\"}]").is_err(), true)
        assert_equal(load("[{\"id\": 1, \"title\": 3}]").is_err(), true)
        assert_equal(load("[{\"id\": 1, \"title\": \"x\", \"done\": \"yes\"}]").is_err(), true)
        assert_equal(load("[{\"id\": 4294967296, \"title\": \"x\"}]").is_err(), true)
        assert_equal(load("[1,").is_err(), true)
        assert_equal(load("[{\"id\": 1, \"title\": \"x\"}").is_err(), true)

    it("reports BadJson for malformed input"):
        match load("[{\"id\": 1, \"title\": 3}]"):
            .Err(error) => assert_equal(error, TodoError.BadJson("title must be a string"))
            .Ok(_) => assert_equal(true, false, reason="expected an error")

    it("dump output loads back unchanged"):
        todos := [
            Todo { id: -7, title: "say \"hi\"\né", done: true },
            Todo { id: 2147483647, title: "", done: false },
        ]
        assert_equal(load(dump(todos)), .Ok(todos))
        assert_equal(load(dump([])), .Ok([]))

    it("complete marks one todo done"):
        todos := [Todo { id: 1, title: "a", done: false }, Todo { id: 2, title: "b", done: false }]
        assert_equal(
            complete(todos, 2),
            .Ok([Todo { id: 1, title: "a", done: false }, Todo { id: 2, title: "b", done: true }]),
        )

    it("complete reports an unknown id"):
        todos := [Todo { id: 1, title: "a", done: false }]
        assert_equal(complete(todos, 9), .Err(TodoError.UnknownId(9)))

    it("pending lists undone titles in order"):
        todos := [
            Todo { id: 1, title: "a", done: false },
            Todo { id: 2, title: "b", done: true },
            Todo { id: 3, title: "c", done: false },
        ]
        assert_equal(pending(todos), ["a", "c"])
        assert_equal(pending([]), [])
