use std.contract.require
use std.testing.assert_equal

## A line that cannot be summed. `line` counts from 1.
@error
@derive(Eq, Debug)
pub enum SumError:
    @error("line $line: missing column")
    MissingColumn(line: usize)
    @error("line $line: not a number: $text")
    NotANumber(line: usize, text: string)

# The trimmed text of 1-based column `column` on one line.
fn field(fields: List[string], column: usize, line: usize) -> Result[string, SumError]:
    match fields.get(column - 1):
        .Some(text) => .Ok(text.trim())
        .None => .Err(.MissingColumn(line))

## Sums the value column per key column, one (key, total) pair per key, sorted by key.
pub fn summarize(
    text: string,
    key: usize,
    value: usize,
    skip_header: bool,
) -> Result[List[(string, i64)], SumError]:
    require("columns are 1-based"):
        key >= 1 && value >= 1
    let mut totals: Map[string, i64] = {}
    for (index, line) in text.lines().iter().enumerate():
        number := index + 1
        if (skip_header && number == 1) || line.trim() == "":
            continue
        fields := line.split(",")
        key_text := field(fields, key, number)?
        value_text := field(fields, value, number)?
        amount := match value_text.parse::[i64]():
            .Ok(n) => n
            .Err(_) => return .Err(.NotANumber(number, value_text))
        *totals.get_or_insert(key_text, 0) += amount
    .Ok(totals.entries().sorted_by_key(fn(entry): entry._0))

tests:
    it("sums each key and sorts by key"):
        rows := summarize("b,2\na,1\nb,5\n", 1, 2, false)
        assert_equal(rows, .Ok([("a", 1), ("b", 7)]))

    it("trims keys and values"):
        rows := summarize(" tea , 3 \ntea,4\n", 1, 2, false)
        assert_equal(rows, .Ok([("tea", 7)]))

    it("skips the header only when asked"):
        text := "name,amount\nx,1\n"
        assert_equal(summarize(text, 1, 2, true), .Ok([("x", 1)]))
        assert_equal(summarize(text, 1, 2, false), .Err(.NotANumber(1, "amount")))

    it("ignores blank lines but counts them"):
        assert_equal(summarize("a,1\n\n   \na,2\n", 1, 2, false), .Ok([("a", 3)]))
        assert_equal(summarize("a,1\n\nb\n", 1, 2, false), .Err(.MissingColumn(3)))

    it("selects any columns, including the key after the value"):
        rows := summarize("9,x,a\n8,y,a\n", 3, 1, false)
        assert_equal(rows, .Ok([("a", 17)]))

    it("uses signed values"):
        assert_equal(summarize("a,-5\na,2\n", 1, 2, false), .Ok([("a", -3)]))

    it("reports a line with too few columns"):
        assert_equal(summarize("a,1\nonly\n", 1, 2, false), .Err(.MissingColumn(2)))

    it("reports a value that is not an integer, trimmed"):
        assert_equal(summarize("a,1\nb, 2.5 \n", 1, 2, false), .Err(.NotANumber(2, "2.5")))

    it("names the line in the message"):
        error := summarize("a,x\n", 1, 2, false).err().expect("an error")
        assert_equal(error.to_string(), "line 1: not a number: x")

    it("gives no rows for empty input"):
        assert_equal(summarize("", 1, 2, false), .Ok([]))
