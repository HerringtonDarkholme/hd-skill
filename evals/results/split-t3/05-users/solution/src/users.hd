## A user account, identified by its id.
@derive(Eq, Debug)
pub struct User:
    pub id: i64
    pub name: string

## Why a rename failed.
@error
@derive(Eq, Debug)
pub enum UserError:
    @error("no user $id")
    NotFound(id: i64)
    @error("name is empty")
    EmptyName

## Where users are kept. The caller provides the implementation.
pub trait UserStore:
    fn get!(&mut self, id: i64) -> User?
    fn put!(&mut self, user: User) -> void

## Renames user `id` to `name` (trimmed) and stores the result once.
## Nothing is stored on failure.
pub fn rename!(id: i64, name: string) -> Result[User, UserError] $ UserStore:
    trimmed := name.trim()
    if trimmed.is_empty():
        return .Err(.EmptyName)
    let .Some(current) = $.use(UserStore).get!(id) else:
        return .Err(.NotFound(id))
    renamed := User { id: current.id, name: trimmed }
    $.use(UserStore).put!(renamed)
    .Ok(renamed)

tests:
    use std.testing.{it_each, it_prop}

    struct FakeStore:
        users: Map[i64, User]
        puts: i64

    impl UserStore for FakeStore:
        fn get!(&mut self, id: i64) -> User?:
            self.users.get(id)
        fn put!(&mut self, user: User) -> void:
            self.puts += 1
            self.users[user.id] = user

    fn store_with_ada() -> *mut FakeStore:
        box(FakeStore { users: { 1: User { id: 1, name: "ada" } }, puts: 0 })

    fn assert_blank_rejected!(blank: string) -> void:
        store := store_with_ada()
        $.with(UserStore=store):
            assert_equal(rename!(1, blank), .Err(.EmptyName))
        assert_equal(store.puts, 0)

    it("renames a user and stores it once"):
        store := store_with_ada()
        $.with(UserStore=store):
            result := rename!(1, "Ada Lovelace")
            assert_equal(result, .Ok(User { id: 1, name: "Ada Lovelace" }))
        assert_equal(store.puts, 1)
        assert_equal(store.users.get(1), .Some(User { id: 1, name: "Ada Lovelace" }))

    it("trims the new name"):
        store := store_with_ada()
        $.with(UserStore=store):
            result := rename!(1, "  Grace  ")
            assert_equal(result, .Ok(User { id: 1, name: "Grace" }))

    it_each(
        "a blank name is EmptyName and stores nothing",
        ["", " ", "\t \n"],
        body=fn!(blank: string): assert_blank_rejected!(blank)
    )

    it("a missing user is NotFound and stores nothing"):
        store := store_with_ada()
        $.with(UserStore=store):
            assert_equal(rename!(2, "Grace"), .Err(.NotFound(2)))
        assert_equal(store.puts, 0)
        assert_equal(store.users.len(), 1)

    it("an empty name is reported before a missing user"):
        store := store_with_ada()
        $.with(UserStore=store):
            assert_equal(rename!(2, ""), .Err(.EmptyName))

    it("the error messages name the problem"):
        assert_equal("${UserError.NotFound(2)}", "no user 2")
        assert_equal("${UserError.EmptyName}", "name is empty")

    it_prop("a rename stores exactly the trimmed name", prop=fn!(name: string):
        store := store_with_ada()
        $.with(UserStore=store):
            result := rename!(1, name)
            if name.trim().is_empty():
                assert_equal(result, .Err(.EmptyName))
            else:
                assert_equal(result, .Ok(User { id: 1, name: name.trim() }))
        assert_equal(store.puts, if name.trim().is_empty(): 0 else: 1)
    )
