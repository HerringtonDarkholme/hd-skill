use std.contract.{ensure, require}
use std.testing.Choices

## A bank account holding a whole number of cents.
##
## Invariant: the balance is never negative. Calls that break a rule of the
## call (a negative opening balance, a non-positive amount, an overdraft)
## stop the program in debug and test builds; `require` costs nothing in
## release builds. `ensure` states what must hold afterwards.
pub struct Account:
    cents: i64

## Opens an account with `cents` already in it. The opening balance is not negative.
pub fn open(cents: i64) -> Account:
    require("an opening balance is not negative"):
        cents >= 0
    Account { cents: cents }

## Moves `cents` from `from` to `to`. The amount is positive and no more than
## the source balance. The total of the two balances is unchanged.
pub fn transfer(from: &mut Account, to: &mut Account, cents: i64) -> void:
    require("a transfer is positive"):
        cents > 0
    require("a transfer does not exceed the source balance"):
        cents <= from.balance()
    total := from.balance() + to.balance()
    from.withdraw(cents)
    to.deposit(cents)
    ensure("a transfer keeps the total"):
        from.balance() + to.balance() == total

impl Account:
    ## The current balance, in cents.
    pub fn balance(self) -> i64:
        self.cents

    ## Adds `cents`, which must be positive.
    pub fn deposit(&mut self, cents: i64) -> void:
        require("a deposit is positive"):
            cents > 0
        before := self.cents
        self.cents += cents
        ensure("a deposit raises the balance by the amount"):
            self.cents == before + cents
        ensure("the balance is never negative"):
            self.cents >= 0

    ## Removes `cents`, which must be positive and no more than the balance.
    pub fn withdraw(&mut self, cents: i64) -> void:
        require("a withdrawal is positive"):
            cents > 0
        require("a withdrawal does not exceed the balance"):
            cents <= self.cents
        before := self.cents
        self.cents -= cents
        ensure("a withdrawal lowers the balance by the amount"):
            self.cents == before - cents
        ensure("the balance is never negative"):
            self.cents >= 0

# Generates (source balance, target balance, amount) with amount <= source.
fn transfer_case(c: &mut Choices) -> (i64, i64, i64):
    source := c.int(0..=1_000_000)
    target := c.int(0..=1_000_000)
    amount := c.int(1..=1_000_000)
    c.assume(amount <= source)
    (source, target, amount)

tests:
    use std.testing.it_prop_with

    it("opens with the given balance"):
        assert_equal(open(250).balance(), 250)

    it("opens with zero"):
        assert_equal(open(0).balance(), 0)

    it("refuses a negative opening balance", expect_panic="explicit-panic"):
        _ := open(-1)

    it("deposit adds to the balance"):
        let mut account = open(100)
        account.deposit(50)
        assert_equal(account.balance(), 150)

    it("refuses a zero deposit", expect_panic="explicit-panic"):
        let mut account = open(100)
        account.deposit(0)

    it("refuses a negative deposit", expect_panic="explicit-panic"):
        let mut account = open(100)
        account.deposit(-5)

    it("withdraw takes from the balance"):
        let mut account = open(100)
        account.withdraw(30)
        assert_equal(account.balance(), 70)

    it("withdraw of the whole balance leaves zero"):
        let mut account = open(100)
        account.withdraw(100)
        assert_equal(account.balance(), 0)

    it("refuses an overdraft", expect_panic="explicit-panic"):
        let mut account = open(100)
        account.withdraw(101)

    it("refuses a zero withdrawal", expect_panic="explicit-panic"):
        let mut account = open(100)
        account.withdraw(0)

    it("transfer moves money between accounts"):
        let mut from = open(500)
        let mut to = open(20)
        transfer(&mut from, &mut to, 120)
        assert_equal(from.balance(), 380)
        assert_equal(to.balance(), 140)

    it("transfer may empty the source"):
        let mut from = open(75)
        let mut to = open(0)
        transfer(&mut from, &mut to, 75)
        assert_equal(from.balance(), 0)
        assert_equal(to.balance(), 75)

    it("refuses a transfer larger than the source balance", expect_panic="explicit-panic"):
        let mut from = open(10)
        let mut to = open(0)
        transfer(&mut from, &mut to, 11)

    it("refuses a non-positive transfer", expect_panic="explicit-panic"):
        let mut from = open(10)
        let mut to = open(0)
        transfer(&mut from, &mut to, 0)

    it_prop_with("a transfer keeps the total and never overdraws", gen=transfer_case, prop=fn!(
        input: (i64, i64, i64),
    ):
        let mut from = open(input._0)
        let mut to = open(input._1)
        transfer(&mut from, &mut to, input._2)
        assert_equal(from.balance() + to.balance(), input._0 + input._1)
        assert(from.balance() >= 0)
    )
