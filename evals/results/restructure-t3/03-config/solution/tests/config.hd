use pkg.{Config, load_config}
use std.fs.{FsRead, FsWrite, MemoryFs, write_text}
use std.host.{Env, ScriptedEnv}
use std.path.Path

it("loads a file through the package's public interface"):
    fs := MemoryFs::new()
    $.with(FsWrite=fs):
        _ := write_text!(
            Path("service.json"),
            "{\"host\": \"example.com\", \"port\": 8443, \"workers\": 8}",
        )
    $.with(FsRead=fs, Env=box(ScriptedEnv::new({ "APP_PORT": "9001" }))):
        loaded := load_config!("service.json")
        assert_equal(loaded.ok(), .Some(Config { host: "example.com", port: 9001, workers: 8 }))
