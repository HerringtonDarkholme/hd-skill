use pkg.{eval, CalcError}
use std.testing.assert_equal

it("evaluates through the public API"):
    assert_equal(eval("2 * (3 + 4) - 1"), .Ok(13i64), reason="precedence and parentheses")
    assert_equal(eval("1 / 0"), .Err(CalcError.DivideByZero), reason="division by zero")
    assert_equal(eval("1 +"), .Err(CalcError.Unexpected(3)), reason="input ends early")
