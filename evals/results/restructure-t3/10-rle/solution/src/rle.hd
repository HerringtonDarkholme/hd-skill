use std.testing.Choices

## One run: `value` repeated `count` times.
@derive(Eq, Debug)
pub struct Run:
    pub value: i32
    pub count: usize

## Encodes `xs` as its maximal runs: no run is empty and neighbours differ.
pub fn encode(xs: List[i32]) -> List[Run]:
    let mut runs: List[Run] = []
    let value: i32 = 0
    let count: usize = 0
    for x in xs:
        if count > 0 && x == value:
            count += 1
        else:
            if count > 0:
                runs.push(Run { value, count })
            value = x
            count = 1
    if count > 0:
        runs.push(Run { value, count })
    runs

## Decodes runs back into the list they stand for.
pub fn decode(runs: List[Run]) -> List[i32]:
    let mut xs: List[i32] = []
    for run in runs:
        for _ in 0..run.count:
            xs.push(run.value)
    xs

fn is_maximal(runs: List[Run]) -> bool:
    for i in 0..runs.len():
        if runs[i].count == 0:
            return false
        if i > 0 && runs[i - 1].value == runs[i].value:
            return false
    true

fn total(runs: List[Run]) -> usize:
    let sum: usize = 0
    for run in runs:
        sum += run.count
    sum

fn matches_both_ways(xs: List[i32], runs: List[Run]) -> bool:
    encode(xs) == runs && decode(runs) == xs

fn small_int(c: &mut Choices) -> i32:
    c.int(-3..=3)

fn small_list(c: &mut Choices) -> List[i32]:
    c.list(200, small_int)

fn some_run(c: &mut Choices) -> Run:
    Run { value: c.int(-2..=2), count: c.int(1..=8) }

fn run_list(c: &mut Choices) -> List[Run]:
    c.list(20, some_run)

tests:
    use std.testing.{it_each, it_prop, it_prop_with}

    it("empty list has no runs"):
        assert_equal(encode([]), [])
        assert_equal(decode([]), [])

    it("one value is one run"):
        assert_equal(encode([5]), [Run { value: 5, count: 1 }])

    it("equal values merge into one run"):
        assert_equal(encode([7, 7, 7]), [Run { value: 7, count: 3 }])

    it("neighbours that differ start a new run"):
        assert_equal(encode([2, 1]), [Run { value: 2, count: 1 }, Run { value: 1, count: 1 }])

    it("a value that returns after a run is its own run"):
        assert_equal(
            encode([1, 2, 1]),
            [Run { value: 1, count: 1 }, Run { value: 2, count: 1 }, Run { value: 1, count: 1 }],
        )

    it("handles negatives and mixed runs"):
        assert_equal(
            encode([-1, -1, 4, 4, 4, 0]),
            [Run { value: -1, count: 2 }, Run { value: 4, count: 3 }, Run { value: 0, count: 1 }],
        )

    it("keeps a long run in one count"):
        xs := [for _ in 0..1000 => 9]
        assert_equal(encode(xs), [Run { value: 9, count: 1000 }])

    it("decodes a run with count 0 to nothing"):
        assert_equal(decode([Run { value: 3, count: 0 }, Run { value: 4, count: 2 }]), [4, 4])

    it("runs compare and print"):
        a := Run { value: 1, count: 2 }
        assert(a == Run { value: 1, count: 2 })
        assert(a != Run { value: 1, count: 3 })
        assert(debug(a).contains("count"))

    it_each(
        "encodes and decodes a fixed example",
        [
            (
                [1, 1, 2, 2, 2, 3, 1],
                [
                    Run { value: 1, count: 2 },
                    Run { value: 2, count: 3 },
                    Run { value: 3, count: 1 },
                    Run { value: 1, count: 1 },
                ],
            ),
            ([0, 0, 0, 0], [Run { value: 0, count: 4 }]),
            (
                [9, 8, 7],
                [
                    Run { value: 9, count: 1 },
                    Run { value: 8, count: 1 },
                    Run { value: 7, count: 1 },
                ],
            ),
        ],
        body=fn!(row: (List[i32], List[Run])): assert(matches_both_ways(row._0, row._1))
    )

    it_prop("decode undoes encode", prop=fn!(xs: List[i32]): assert_equal(decode(encode(xs)), xs))

    it_prop_with(
        "decode undoes encode on lists with long runs",
        gen=small_list,
        prop=fn!(xs: List[i32]): assert_equal(decode(encode(xs)), xs)
    )

    it_prop("encode gives maximal runs that cover the input", prop=fn!(xs: List[i32]):
        runs := encode(xs)
        assert(is_maximal(runs), reason="no empty run, neighbours differ")
        assert_equal(total(runs), xs.len())
    )

    it_prop_with("encode of repetitive lists is maximal", gen=small_list, prop=fn!(xs: List[i32]):
        runs := encode(xs)
        assert(is_maximal(runs), reason="no empty run, neighbours differ")
        assert_equal(total(runs), xs.len())
        assert_equal(decode(runs), xs)
    )

    it_prop_with("re-encoding decoded runs is canonical", gen=run_list, prop=fn!(runs: List[Run]):
        back := encode(decode(runs))
        assert(is_maximal(back), reason="encode output is maximal")
        assert_equal(decode(back), decode(runs))
        if is_maximal(runs):
            assert_equal(back, runs, reason="maximal runs are a fixed point")
    )
