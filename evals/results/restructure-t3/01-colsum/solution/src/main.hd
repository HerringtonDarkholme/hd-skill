use std.cli.{Args, Cli, ScriptedArgs}
use std.console.{ConsoleInput, MemoryConsole, ScriptedInput, eprintln, read_all}
use std.process.ExitCode
use pkg.sum.{SumError, summarize}

## Sum one column of CSV from standard input, grouped by another column
@derive(Cli)
struct Options:
    ## the 1-based column to group by
    key: usize = 1
    ## the 1-based column to sum
    value: usize = 2
    ## ignore the first line
    skip_header: bool

pub fn main!() -> ExitCode $ Args + Console + ConsoleInput:
    options := match Options::parse_args():
        .Ok(options) => options
        .Err(error) => return error.exit() # usage error: status 2; --help: status 0
    if options.key == 0 || options.value == 0:
        eprintln("colsum: columns start at 1")
        return ExitCode(2)
    text := match read_all!():
        .Ok(text) => text
        .Err(error) =>
            eprintln("colsum: $error")
            return ExitCode(1)
    match summarize(text, options.key, options.value, options.skip_header):
        .Ok(totals) =>
            for (key, total) in totals:
                println("$key,$total")
            ExitCode(0)
        .Err(error) =>
            eprintln("colsum: $error")
            ExitCode(1)

tests:
    it("prints one key,total line per key"):
        arguments := box(ScriptedArgs::new("colsum", []))
        input := ScriptedInput::new(["b,2", "a,1", "b,3"])
        console := MemoryConsole::new()
        $.with(Args=arguments, ConsoleInput=input, Console=console):
            assert_equal(main!(), ExitCode(0))
        assert_equal(console.output().join(""), "a,1\nb,5\n")
        assert_equal(console.error_output().join(""), "")

    it("honours --key, --value and --skip-header"):
        arguments := box(
            ScriptedArgs::new("colsum", ["--key", "2", "--value", "3", "--skip-header"]),
        )
        input := ScriptedInput::new(["h,k,v", "x,b,2", "y,b,5"])
        console := MemoryConsole::new()
        $.with(Args=arguments, ConsoleInput=input, Console=console):
            assert_equal(main!(), ExitCode(0))
        assert_equal(console.output().join(""), "b,7\n")

    it("prints nothing to standard output on error"):
        arguments := box(ScriptedArgs::new("colsum", []))
        input := ScriptedInput::new(["a,1", "b,x"])
        console := MemoryConsole::new()
        $.with(Args=arguments, ConsoleInput=input, Console=console):
            assert_equal(main!(), ExitCode(1))
        assert_equal(console.output().join(""), "")
        assert_equal(console.error_output().join(""), "colsum: line 2: not an integer: x\n")

    it("reports a short line with its number"):
        arguments := box(ScriptedArgs::new("colsum", []))
        input := ScriptedInput::new(["a,1", "lonely"])
        console := MemoryConsole::new()
        $.with(Args=arguments, ConsoleInput=input, Console=console):
            assert_equal(main!(), ExitCode(1))
        assert_equal(console.error_output().join(""), "colsum: line 2: missing column\n")

    it("refuses column 0"):
        arguments := box(ScriptedArgs::new("colsum", ["--key", "0"]))
        input := ScriptedInput::new([])
        console := MemoryConsole::new()
        $.with(Args=arguments, ConsoleInput=input, Console=console):
            assert_equal(main!(), ExitCode(2))
        assert_equal(console.output().join(""), "")
