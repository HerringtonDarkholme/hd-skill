use pkg.users.{User, UserStore, rename}

# An in-memory store for this program: the users live in a list.
struct MemoryUsers:
    users: List[User]

impl UserStore for MemoryUsers:
    fn get!(&mut self, id: i64) -> User?:
        for user in self.users:
            if user.id == id:
                return .Some(user)
        .None

    fn put!(&mut self, user: User) -> void:
        for i in 0..self.users.len():
            if self.users[i].id == user.id:
                self.users[i] = user
                return
        self.users.push(user)

pub fn main!() -> void $ Console:
    store := box(MemoryUsers { users: [User { id: 1, name: "ada" }] })
    $.with(UserStore=store):
        match rename!(1, "Ada Lovelace"):
            .Ok(user) => println("renamed ${user.id} to ${user.name}")
            .Err(failure) => println("error: $failure")
        match rename!(2, "Grace"):
            .Ok(user) => println("renamed ${user.id} to ${user.name}")
            .Err(failure) => println("error: $failure")
