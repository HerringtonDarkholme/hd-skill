use std.encoding.{Deserialize, Serialize}
use std.encoding.json.{decode, encode}
use std.testing.{Arbitrary, it_prop}

## One todo: its id, its title, and whether it is done.
@derive(Eq, Debug, Serialize, Deserialize, Arbitrary)
pub struct Todo:
    pub id: i32
    pub title: string
    pub done: bool = false

@derive(Eq, Debug)
@error
pub enum TodoError:
    @error("bad todo JSON: $message")
    BadJson(message: string)
    @error("no todo with id $id")
    UnknownId(id: i32)

## Reads a JSON array of {"id", "title", "done"} objects; `done` may be absent.
pub fn load(json: string) -> Result[List[Todo], TodoError]:
    match decode::[List[Todo]](json):
        .Ok(todos) => .Ok(todos)
        .Err(error) => .Err(TodoError.BadJson(debug(error)))

## The JSON text of `todos`, which `load` reads back unchanged.
pub fn dump(todos: List[Todo]) -> string:
    encode(todos)

## Marks the todo with `id` done; an id with no todo is `UnknownId`.
pub fn complete(todos: List[Todo], id: i32) -> Result[List[Todo], TodoError]:
    let mut out: List[Todo] = []
    let found = false
    for todo in todos:
        if todo.id == id:
            found = true
            out.push(Todo { ...todo, done: true })
        else:
            out.push(todo)
    if !found:
        return .Err(TodoError.UnknownId(id))
    .Ok(out)

## The titles of the todos that are not done, in order.
pub fn pending(todos: List[Todo]) -> List[string]:
    let mut titles: List[string] = []
    for todo in todos:
        if !todo.done:
            titles.push(todo.title)
    titles

tests:
    it("loads a todo array"):
        todos := load(
            "[{\"id\": 1, \"title\": \"milk\", \"done\": true}, {\"id\": 2, \"title\": \"eggs\", \"done\": false}]",
        )
            .expect("valid JSON")
        assert_equal(
            todos,
            [Todo { id: 1, title: "milk", done: true }, Todo { id: 2, title: "eggs", done: false }],
        )

    it("treats an absent done as false"):
        todos := load("[{\"id\": 7, \"title\": \"tea\"}]").expect("valid JSON")
        assert_equal(todos, [Todo { id: 7, title: "tea", done: false }])

    it("accepts an empty array"):
        assert_equal(load("[]"), .Ok([]))

    it("ignores extra fields"):
        todos := load("[{\"id\": 1, \"title\": \"a\", \"done\": false, \"note\": 3}]")
            .expect("valid JSON")
        assert_equal(todos, [Todo { id: 1, title: "a", done: false }])

    it("rejects input that is not a todo array"):
        assert_equal(load("{}").is_err(), true, reason="an object is not an array")
        assert_equal(load("[1]").is_err(), true, reason="an element must be an object")
        assert_equal(
            load("[{\"id\": 1, \"title\": \"a\", \"done\": 1}]").is_err(),
            true,
            reason="done must be a bool",
        )
        assert_equal(
            load("[{\"id\": 1.5, \"title\": \"a\"}]").is_err(),
            true,
            reason="id must be an integer",
        )
        assert_equal(load("[{\"title\": \"a\"}]").is_err(), true, reason="id is required")
        assert_equal(load("[{\"id\": 1}]").is_err(), true, reason="title is required")
        assert_equal(load("[{\"id\": 1, \"title\": \"a\"}").is_err(), true, reason="truncated JSON")
        assert_equal(load("").is_err(), true, reason="empty input")

    it("reports BadJson as the error kind"):
        match load("nope"):
            .Ok(_) => assert_equal(true, false, reason="garbage must not load")
            .Err(error) =>
                match error:
                    .BadJson(_) => assert_equal(true, true)
                    _ => assert_equal(true, false, reason="expected BadJson")

    it("marks one todo done and keeps the others"):
        todos := [Todo { id: 1, title: "a" }, Todo { id: 2, title: "b" }]
        assert_equal(
            complete(todos, 2),
            .Ok([Todo { id: 1, title: "a" }, Todo { id: 2, title: "b", done: true }]),
        )

    it("reports an unknown id"):
        todos := [Todo { id: 1, title: "a" }]
        assert_equal(complete(todos, 99), .Err(TodoError.UnknownId(99)))

    it("completes from an empty list only with an error"):
        assert_equal(complete([], 1), .Err(TodoError.UnknownId(1)))

    it("lists pending titles in order"):
        todos := [
            Todo { id: 1, title: "a" },
            Todo { id: 2, title: "b", done: true },
            Todo { id: 3, title: "c" },
        ]
        assert_equal(pending(todos), ["a", "c"])
        assert_equal(pending([]), [])

    it("dumps the todo array"):
        assert_equal(
            dump([Todo { id: 1, title: "say \"hi\"", done: true }]),
            "[{\"id\":1,\"title\":\"say \\\"hi\\\"\",\"done\":true}]",
        )

    it_prop(
        "dump then load gives the same todos",
        prop=fn!(todos: List[Todo]): assert_equal(load(dump(todos)), .Ok(todos))
    )
