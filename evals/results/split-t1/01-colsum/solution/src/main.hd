use std.cli.{Args, Cli, ScriptedArgs}
use std.console.{Console, ConsoleInput, MemoryConsole, ScriptedInput, eprintln, println, read_all}
use std.process.ExitCode
use pkg.sum.{SumError, summarize}

## Sum one column of CSV read from standard input, grouped by another
@derive(Cli)
struct Options:
    ## the 1-based column to group by
    key: usize = 1
    ## the 1-based column to sum, as a signed integer
    value: usize = 2
    ## ignore the first line
    skip_header: bool

pub fn main!() -> ExitCode $ Args + Console + ConsoleInput:
    options := match Options::parse_args():
        .Ok(options) => options
        .Err(error) => return error.exit()
    text := match read_all!():
        .Ok(text) => text
        .Err(error) =>
            eprintln("colsum: ${debug(error)}")
            return ExitCode(1)
    totals := match summarize(text, options.key, options.value, options.skip_header):
        .Ok(totals) => totals
        .Err(error) =>
            eprintln("colsum: $error")
            return ExitCode(1)
    for (key, total) in totals:
        println("$key,$total")
    ExitCode(0)

tests:
    it("prints one total per key, sorted"):
        input := ScriptedInput::new(["tea, 3", "cake, 1", "tea, 4"])
        arguments := box(ScriptedArgs::new("colsum", []))
        console := MemoryConsole::new()
        $.with(Args=arguments, Console=console, ConsoleInput=input):
            assert_equal(main!(), ExitCode(0))
        assert_equal(console.output().join(""), "cake,1\ntea,7\n")
        assert_equal(console.error_output().join(""), "")

    it("uses the column options and skips a header"):
        input := ScriptedInput::new(["id,amount,region", "1,5,north", "2,-2,north", "3,9,south"])
        arguments := box(
            ScriptedArgs::new("colsum", ["--key", "3", "--value", "2", "--skip-header"]),
        )
        console := MemoryConsole::new()
        $.with(Args=arguments, Console=console, ConsoleInput=input):
            assert_equal(main!(), ExitCode(0))
        assert_equal(console.output().join(""), "north,3\nsouth,9\n")

    it("writes the error to standard error and exits 1"):
        input := ScriptedInput::new(["tea,1", "tea,x"])
        arguments := box(ScriptedArgs::new("colsum", []))
        console := MemoryConsole::new()
        $.with(Args=arguments, Console=console, ConsoleInput=input):
            assert_equal(main!(), ExitCode(1))
        assert_equal(console.output().join(""), "")
        assert_equal(console.error_output().join(""), "colsum: line 2: not a number: x\n")

    it("reports a short line on standard error"):
        input := ScriptedInput::new(["tea,1", "cake"])
        arguments := box(ScriptedArgs::new("colsum", []))
        console := MemoryConsole::new()
        $.with(Args=arguments, Console=console, ConsoleInput=input):
            assert_equal(main!(), ExitCode(1))
        assert_equal(console.output().join(""), "")
        assert_equal(console.error_output().join(""), "colsum: line 2: missing column\n")
