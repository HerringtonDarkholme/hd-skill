use std.contract.{ensure, require}
use std.testing.Choices

## A bank account holding a whole number of cents.
##
## Invariants that hold after every call: the balance is never negative,
## and a transfer keeps the total of the two accounts.
pub struct Account:
    cents: i64

## Opens an account with `cents`, which must not be negative.
pub fn open(cents: i64) -> Account:
    require("an opening balance is not negative"):
        cents >= 0
    Account { cents: cents }

## Moves `cents` from `from` to `to`. The amount must be positive and no
## larger than the balance of `from`.
pub fn transfer(from: &mut Account, to: &mut Account, cents: i64) -> void:
    require("a transfer is positive"):
        cents > 0
    require("a transfer is not larger than the balance"):
        cents <= from.cents
    total := from.cents + to.cents
    from.withdraw(cents)
    to.deposit(cents)
    ensure("a transfer keeps the total"):
        from.cents + to.cents == total

impl Account:
    ## The current balance in cents.
    pub fn balance(self) -> i64:
        self.cents

    ## Adds `cents`, which must be positive.
    pub fn deposit(&mut self, cents: i64) -> void:
        require("a deposit is positive"):
            cents > 0
        before := self.cents
        self.cents += cents
        ensure("a deposit adds exactly the amount"):
            self.cents == before + cents
        ensure("the balance is never negative"):
            self.cents >= 0

    ## Removes `cents`, which must be positive and no larger than the balance.
    pub fn withdraw(&mut self, cents: i64) -> void:
        require("a withdrawal is positive"):
            cents > 0
        require("a withdrawal is not larger than the balance"):
            cents <= self.cents
        self.cents -= cents
        ensure("the balance is never negative"):
            self.cents >= 0

fn positive_cents(c: &mut Choices) -> i64:
    c.int(1..=1_000_000)

tests:
    use std.testing.it_prop_with

    it("opens with the given balance"):
        assert_equal(open(250).balance(), 250)

    it("opens empty"):
        assert_equal(open(0).balance(), 0)

    it("refuses a negative opening balance", expect_panic="explicit-panic"):
        _ := open(-1)

    it("deposit adds to the balance"):
        let mut a = open(100)
        a.deposit(50)
        assert_equal(a.balance(), 150)

    it("withdraw removes from the balance"):
        let mut a = open(100)
        a.withdraw(40)
        assert_equal(a.balance(), 60)

    it("withdrawing the whole balance leaves zero"):
        let mut a = open(100)
        a.withdraw(100)
        assert_equal(a.balance(), 0)

    it("refuses a zero deposit", expect_panic="explicit-panic"):
        let mut a = open(100)
        a.deposit(0)

    it("refuses a negative deposit", expect_panic="explicit-panic"):
        let mut a = open(100)
        a.deposit(-5)

    it("refuses a zero withdrawal", expect_panic="explicit-panic"):
        let mut a = open(100)
        a.withdraw(0)

    it("refuses a withdrawal larger than the balance", expect_panic="explicit-panic"):
        let mut a = open(100)
        a.withdraw(101)

    it("transfer moves money and keeps the total"):
        let mut from = open(300)
        let mut to = open(20)
        transfer(&mut from, &mut to, 120)
        assert_equal(from.balance(), 180)
        assert_equal(to.balance(), 140)
        assert_equal(from.balance() + to.balance(), 320)

    it("transfer of the whole balance empties the source"):
        let mut from = open(75)
        let mut to = open(0)
        transfer(&mut from, &mut to, 75)
        assert_equal(from.balance(), 0)
        assert_equal(to.balance(), 75)

    it("refuses a transfer larger than the balance", expect_panic="explicit-panic"):
        let mut from = open(10)
        let mut to = open(0)
        transfer(&mut from, &mut to, 11)

    it("refuses a non-positive transfer", expect_panic="explicit-panic"):
        let mut from = open(10)
        let mut to = open(0)
        transfer(&mut from, &mut to, 0)

    it_prop_with("deposit then withdraw of the same amount restores the balance", gen=positive_cents, prop=fn!(
        amount: i64,
    ):
        let mut a = open(1000)
        a.deposit(amount)
        a.withdraw(amount)
        assert_equal(a.balance(), 1000)
    )
