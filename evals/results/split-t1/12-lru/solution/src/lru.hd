use std.testing.{Choices, commands}

## A least-recently-used cache from string keys to i64 values.
##
## `get` on a hit and `put` both make their key the most recent. When a
## `put` leaves more than `capacity` keys, the least recent one is dropped.
pub struct Lru:
    capacity: usize
    values: Map[string, i64]
    order: List[string] # least recent first; the keys of `values`, in order

## An empty cache that holds at most `capacity` entries.
pub fn new_lru(capacity: usize) -> Lru:
    Lru { capacity, values: {}, order: [] }

impl Lru:
    ## The value for `key`, which becomes the most recent key. A miss changes nothing.
    pub fn get(&mut self, key: string) -> i64?:
        let .Some(value) = self.values.get(key) else:
            return .None
        self.touch(key)
        .Some(value)

    ## Inserts or updates `key`, makes it the most recent, then evicts the least recent if over capacity.
    pub fn put(&mut self, key: string, value: i64) -> void:
        if self.values.contains_key(key):
            self.touch(key)
        else:
            self.order.push(key)
        _ := self.values.insert(key, value)
        if self.values.len() > self.capacity:
            oldest := self.order.remove(0)
            _ := self.values.remove(oldest)

    pub fn len(self) -> usize:
        self.values.len()

    fn touch(&mut self, key: string) -> void:
        let .Some(at) = self.order.index_of(key) else:
            return
        _ := self.order.remove(at)
        self.order.push(key)

# ---- Test support: a plain model and command generators. Private, used only by `tests:`. ----

# The model: the entries as a list, least recent first, with the same rules.
struct Model:
    cap: usize
    entries: List[(string, i64)]

impl Model:
    fn position(&self, key: string) -> usize?:
        for i in 0..self.entries.len():
            if self.entries[i]._0 == key:
                return .Some(i)
        .None

    fn get(&mut self, key: string) -> i64?:
        let .Some(at) = self.position(key) else:
            return .None
        let (k, v) = self.entries.remove(at)
        self.entries.push((k, v))
        .Some(v)

    fn put(&mut self, key: string, value: i64) -> void:
        let .Some(at) = self.position(key) else:
            self.add(key, value)
            return
        _ := self.entries.remove(at)
        self.add(key, value)

    fn add(&mut self, key: string, value: i64) -> void:
        self.entries.push((key, value))
        if self.entries.len() > self.cap:
            _ := self.entries.remove(0)

@derive(Debug)
enum Cmd:
    Get(string)
    Put(string, i64)

KEYS := ["a", "b", "c", "d"]

fn next_cmd(c: &mut Choices, _model: &Model) -> Cmd?:
    key := c.choose(KEYS)
    if c.bool():
        .Some(.Get(key))
    else:
        let value: i64 = c.int(-9..=9)
        .Some(.Put(key, value))

fn advance_cmd(model: &Model, cmd: &Cmd) -> Model:
    let mut next = *model
    match cmd:
        .Get(key) => _ := next.get(key)
        .Put(key, value) => next.put(key, value)
    next

fn history(c: &mut Choices) -> (usize, List[Cmd]):
    let cap: usize = c.int(0..=4)
    cmds := commands(
        c,
        max=60,
        initial=Model { cap, entries: [] },
        next=next_cmd,
        advance=advance_cmd,
    )
    (cap, cmds)

tests:
    use std.testing.it_prop_with

    it("a new cache is empty and misses"):
        let mut cache = new_lru(2)
        assert_equal(cache.len(), 0)
        assert_equal(cache.get("a"), .None)

    it("returns what was put"):
        let mut cache = new_lru(2)
        cache.put("a", 1)
        cache.put("b", -7)
        assert_equal(cache.get("a"), .Some(1))
        assert_equal(cache.get("b"), .Some(-7))
        assert_equal(cache.len(), 2)

    it("evicts the least recently put key"):
        let mut cache = new_lru(2)
        cache.put("a", 1)
        cache.put("b", 2)
        cache.put("c", 3)
        assert_equal(cache.get("a"), .None)
        assert_equal(cache.get("b"), .Some(2))
        assert_equal(cache.get("c"), .Some(3))

    it("a hit makes the key most recent"):
        let mut cache = new_lru(2)
        cache.put("a", 1)
        cache.put("b", 2)
        assert_equal(cache.get("a"), .Some(1))
        cache.put("c", 3)
        assert_equal(cache.get("b"), .None)
        assert_equal(cache.get("a"), .Some(1))

    it("a miss changes nothing"):
        let mut cache = new_lru(2)
        cache.put("a", 1)
        cache.put("b", 2)
        assert_equal(cache.get("zz"), .None)
        assert_equal(cache.len(), 2)
        cache.put("c", 3)
        assert_equal(cache.get("a"), .None)
        assert_equal(cache.get("b"), .Some(2))

    it("updating a key replaces its value without evicting"):
        let mut cache = new_lru(2)
        cache.put("a", 1)
        cache.put("b", 2)
        cache.put("a", 10)
        assert_equal(cache.len(), 2)
        assert_equal(cache.get("a"), .Some(10))
        cache.put("c", 3)
        assert_equal(cache.get("b"), .None)

    it("a put of an existing key makes it most recent"):
        let mut cache = new_lru(2)
        cache.put("a", 1)
        cache.put("b", 2)
        cache.put("a", 1)
        cache.put("c", 3)
        assert_equal(cache.get("b"), .None)
        assert_equal(cache.get("a"), .Some(1))

    it("capacity one keeps only the last key"):
        let mut cache = new_lru(1)
        cache.put("a", 1)
        cache.put("b", 2)
        assert_equal(cache.len(), 1)
        assert_equal(cache.get("a"), .None)
        assert_equal(cache.get("b"), .Some(2))

    it("capacity zero stores nothing"):
        let mut cache = new_lru(0)
        cache.put("a", 1)
        assert_equal(cache.len(), 0)
        assert_equal(cache.get("a"), .None)

    it("keys are case sensitive"):
        let mut cache = new_lru(2)
        cache.put("a", 1)
        assert_equal(cache.get("A"), .None)

    it_prop_with("the cache agrees with the model on any history", gen=history, prop=fn!(
        input: (usize, List[Cmd]),
    ):
        let (cap, cmds) = input
        let mut cache = new_lru(cap)
        let mut model = Model { cap, entries: [] }
        for cmd in cmds:
            match cmd:
                .Get(key) => assert_equal(cache.get(key), model.get(key), reason="get $key")
                .Put(key, value) =>
                    cache.put(key, value)
                    model.put(key, value)
            assert_equal(cache.len(), model.entries.len(), reason="len after ${debug(cmd)}")
    )
