## One maximal run of equal integers: `count` copies of `value`.
@derive(Eq, Debug)
pub struct Run:
    pub value: i32
    pub count: usize

## Encodes `xs` as maximal runs: no run is empty and neighbouring runs differ.
pub fn encode(xs: List[i32]) -> List[Run]:
    let mut runs: List[Run] = []
    for x in xs:
        n := runs.len()
        if n > 0 && runs[n - 1].value == x:
            runs[n - 1].count += 1
        else:
            runs.push(Run { value: x, count: 1 })
    runs

## Expands `runs` back into the list they encode.
pub fn decode(runs: List[Run]) -> List[i32]:
    let mut xs: List[i32] = []
    for run in runs:
        for _ in 0..run.count:
            xs.push(run.value)
    xs

tests:
    use std.testing.{Arbitrary, Choices, it_each, it_prop, it_prop_with}

    fn small_int(c: &mut Choices) -> i32:
        c.int(-2..=2)

    # Lists over a tiny alphabet, so that runs of every length appear.
    fn small_list(c: &mut Choices) -> List[i32]:
        c.list(60, small_int)

    # Run lists that already satisfy the invariant: counts >= 1, neighbours differ.
    fn valid_runs(c: &mut Choices) -> List[Run]:
        let mut runs: List[Run] = []
        for _ in 0..c.int(0..=12):
            value := c.int(-2..=2)
            count := c.int(1..=6)
            n := runs.len()
            if n == 0 || runs[n - 1].value != value:
                runs.push(Run { value, count })
        runs

    fn total_count(runs: List[Run]) -> usize:
        let mut sum: usize = 0
        for run in runs:
            sum += run.count
        sum

    it_each(
        "encodes an example",
        [
            ([], []),
            ([5], [Run { value: 5, count: 1 }]),
            (
                [1, 2, 1],
                [
                    Run { value: 1, count: 1 },
                    Run { value: 2, count: 1 },
                    Run { value: 1, count: 1 },
                ],
            ),
            (
                [3, 3, 4, 4, 4, 0],
                [
                    Run { value: 3, count: 2 },
                    Run { value: 4, count: 3 },
                    Run { value: 0, count: 1 },
                ],
            ),
            ([-1, -1], [Run { value: -1, count: 2 }]),
            (
                [7, 7, 8, 7],
                [
                    Run { value: 7, count: 2 },
                    Run { value: 8, count: 1 },
                    Run { value: 7, count: 1 },
                ],
            ),
        ],
        body=fn!(row: (List[i32], List[Run])): assert_equal(encode(row._0), row._1)
    )

    it("a long run is one run"):
        let mut xs: List[i32] = []
        for _ in 0..1000:
            xs.push(7)
        assert_equal(encode(xs), [Run { value: 7, count: 1000 }])

    it("decodes runs"):
        assert_equal(decode([]), [])
        assert_equal(decode([Run { value: 2, count: 3 }, Run { value: 9, count: 1 }]), [2, 2, 2, 9])
        assert_equal(decode([Run { value: 4, count: 0 }]), [])

    it("prints a run with its fields"):
        assert(debug(Run { value: 1, count: 2 }).contains("value"), reason="debug shows fields")

    it_prop("decode undoes encode", prop=fn!(xs: List[i32]): assert_equal(decode(encode(xs)), xs))

    it_prop_with(
        "decode undoes encode over repeated values",
        gen=small_list,
        prop=fn!(xs: List[i32]): assert_equal(decode(encode(xs)), xs)
    )

    it_prop_with("encoded runs are maximal", gen=small_list, prop=fn!(xs: List[i32]):
        runs := encode(xs)
        assert_equal(total_count(runs), xs.len(), reason="counts add up to the length")
        for run in runs:
            assert(run.count >= 1, reason="no empty run")
        for i in 0..runs.len():
            if i > 0:
                assert(runs[i - 1].value != runs[i].value, reason="neighbours differ")
    )

    it_prop_with(
        "encode undoes decode on valid runs",
        gen=valid_runs,
        prop=fn!(runs: List[Run]): assert_equal(encode(decode(runs)), runs)
    )
