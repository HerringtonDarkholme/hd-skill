## A run of `count` copies of `value` in a run-length encoded list.
@derive(Eq, Debug)
pub struct Run:
    pub value: i32
    pub count: usize

## Encodes `xs` as its maximal runs: no run is empty, and neighbouring runs hold different values.
pub fn encode(xs: List[i32]) -> List[Run]:
    let mut runs: List[Run] = []
    let current: i32 = 0
    let count: usize = 0
    for x in xs:
        if count > 0 && x == current:
            count += 1
        else:
            if count > 0:
                runs.push(Run { value: current, count })
            current = x
            count = 1
    if count > 0:
        runs.push(Run { value: current, count })
    runs

## Expands runs back into the list they encode.
pub fn decode(runs: List[Run]) -> List[i32]:
    let mut out: List[i32] = []
    for run in runs:
        for _ in 0..run.count:
            out.push(run.value)
    out

tests:
    use std.testing.{Choices, it_each, it_prop, it_prop_with}

    # Small values, so that neighbouring equal values, and long runs, are common.
    fn small(c: &mut Choices) -> i32:
        c.int(-2..=2)

    fn runny(c: &mut Choices) -> List[i32]:
        c.list(60, small)

    it("empty list has no runs"):
        assert_equal(encode([]), [])
        assert_equal(decode([]), [])

    it_each(
        "encode gives the maximal runs",
        [
            ([7], [Run { value: 7, count: 1 }]),
            ([3, 3, 3, 3], [Run { value: 3, count: 4 }]),
            (
                [1, 1, 2, 1, 1, 1],
                [
                    Run { value: 1, count: 2 },
                    Run { value: 2, count: 1 },
                    Run { value: 1, count: 3 },
                ],
            ),
            (
                [1, 2, 3],
                [
                    Run { value: 1, count: 1 },
                    Run { value: 2, count: 1 },
                    Run { value: 3, count: 1 },
                ],
            ),
            ([0, 0, -1, -1], [Run { value: 0, count: 2 }, Run { value: -1, count: 2 }]),
            (
                [2147483647, 2147483647, -2147483648],
                [Run { value: 2147483647, count: 2 }, Run { value: -2147483648, count: 1 }],
            ),
        ],
        body=fn!(row: (List[i32], List[Run])): assert_equal(encode(row._0), row._1)
    )

    it_each(
        "decode expands each run",
        [
            ([Run { value: 4, count: 2 }, Run { value: 9, count: 1 }], [4, 4, 9]),
            ([Run { value: 5, count: 3 }], [5, 5, 5]),
            ([Run { value: 1, count: 1 }, Run { value: 1, count: 1 }], [1, 1]),
        ],
        body=fn!(row: (List[Run], List[i32])): assert_equal(decode(row._0), row._1)
    )

    it("debug shows both fields"):
        assert_equal(debug(Run { value: -1, count: 2 }), "Run { value: -1, count: 2 }")

    it("Run compares by both fields"):
        assert(Run { value: 1, count: 2 } == Run { value: 1, count: 2 })
        assert(Run { value: 1, count: 2 } != Run { value: 1, count: 3 })
        assert(Run { value: 1, count: 2 } != Run { value: 2, count: 2 })

    it_prop(
        "decode undoes encode on any list",
        prop=fn!(xs: List[i32]): assert_equal(decode(encode(xs)), xs)
    )

    it_prop_with(
        "decode undoes encode on run-heavy lists",
        gen=runny,
        prop=fn!(xs: List[i32]): assert_equal(decode(encode(xs)), xs)
    )

    it_prop_with("encode gives maximal, non-empty runs covering the input", gen=runny, prop=fn!(
        xs: List[i32],
    ):
        runs := encode(xs)
        for i in 0..runs.len():
            assert(runs[i].count > 0, reason="run $i is empty")
            if i > 0:
                assert(runs[i].value != runs[i - 1].value, reason="runs $i-1 and $i should merge")
        assert_equal(runs.map(fn(r): r.count).sum(), xs.len(), reason="runs cover the input")
    )
