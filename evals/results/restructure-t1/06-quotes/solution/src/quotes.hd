use std.task.{Backoff, apply, map_join, retry}
use std.time.{Clock, ms}

## A failed quote: the service is busy, or does not know the sku.
@derive(Eq, Debug)
@error
pub enum QuoteError:
    @error("busy")
    Busy
    @error("unknown sku $sku")
    Unknown(sku: string)

## The quote service that the caller provides.
pub trait Quotes:
    fn quote!(&mut self, sku: string) -> Result[i64, QuoteError]

## Quotes one sku: up to three attempts, about 10 ms apart.
fn quote_one!(sku: string) -> Result[i64, QuoteError] $ Quotes + Clock:
    apply!(retry(Backoff { attempts: 3, initial: 10ms, factor: 1, max: 10ms })):
        $.use(Quotes).quote!(sku)

## The sum of the prices of `skus`, at most four quoted at once.
## The first failing sku in list order decides an error; an empty order is 0.
pub fn order_total!(skus: List[string]) -> Result[i64, QuoteError] $ Quotes + Clock:
    results := map_join!(skus, 4, quote_one)
    let total: i64 = 0
    for result in results:
        match result:
            .Ok(price) => total += price
            .Err(error) => return .Err(error)
    .Ok(total)

tests:
    use std.time.{ManualClock, Timestamp, now}

    struct Scripted:
        prices: Map[string, i64]
        busy: Map[string, i32] # how many more calls answer Busy
        calls: List[string]

    impl Quotes for Scripted:
        fn quote!(&mut self, sku: string) -> Result[i64, QuoteError]:
            self.calls.push(sku)
            left := self.busy.get(sku).unwrap_or(0)
            if left > 0:
                self.busy[sku] = left - 1
                return .Err(.Busy)
            match self.prices.get(sku):
                .Some(price) => .Ok(price)
                .None => .Err(.Unknown(sku))

    fn scripted(prices: Map[string, i64], busy: Map[string, i32]) -> *mut Scripted:
        box(Scripted { prices, busy, calls: [] })

    fn clock() -> *mut ManualClock:
        ManualClock::new(Timestamp::from_unix_milliseconds(0))

    it("an empty order totals zero"):
        $.with(Quotes=scripted({}, {}), Clock=clock()):
            assert_equal(order_total!([]), .Ok(0))

    it("sums the prices, repeats included"):
        $.with(Quotes=scripted({ "tea": 300, "jam": 450 }, {}), Clock=clock()):
            assert_equal(order_total!(["tea", "jam", "tea"]), .Ok(1050))

    it("retries a busy sku twice, about 10 ms apart"):
        quotes := scripted({ "tea": 300 }, { "tea": 2 })
        clk := clock()
        $.with(Quotes=quotes, Clock=clk):
            assert_equal(order_total!(["tea"]), .Ok(300))
            assert_equal(now().unix_milliseconds(), 20)
        assert_equal(quotes.calls.len(), 3, reason="three attempts in all")

    it("gives up after three attempts with the last error"):
        quotes := scripted({ "tea": 300 }, { "tea": 3 })
        clk := clock()
        $.with(Quotes=quotes, Clock=clk):
            assert_equal(order_total!(["tea"]), .Err(.Busy))
            assert_equal(now().unix_milliseconds(), 20)
        assert_equal(quotes.calls.len(), 3)

    it("an unknown sku is retried too, then reported"):
        quotes := scripted({}, {})
        $.with(Quotes=quotes, Clock=clock()):
            assert_equal(order_total!(["nut"]), .Err(.Unknown("nut")))
        assert_equal(quotes.calls.len(), 3)

    it("reports the first failing sku in list order"):
        first := scripted({ "tea": 300 }, { "jam": 5 })
        $.with(Quotes=first, Clock=clock()):
            assert_equal(order_total!(["nut", "tea", "jam"]), .Err(.Unknown("nut")))
        assert_equal(first.calls.len(), 3 + 1 + 3, reason="every sku gets its attempts")
        second := scripted({ "tea": 300 }, { "jam": 5 })
        $.with(Quotes=second, Clock=clock()):
            assert_equal(order_total!(["jam", "nut"]), .Err(.Busy))
        assert_equal(second.calls.len(), 3 + 3)

    it("quotes at most four skus at once"):
        # Each sku answers Busy twice, so it needs two 10 ms waits. Four at a time:
        # eight skus take two rounds (40 ms), five skus take two rounds (40 ms), and
        # an unlimited pool would take one (20 ms).
        let prices: Map[string, i64] = {
            "a": 1,
            "b": 1,
            "c": 1,
            "d": 1,
            "e": 1,
            "f": 1,
            "g": 1,
            "h": 1,
        }
        let busy: Map[string, i32] = {
            "a": 2,
            "b": 2,
            "c": 2,
            "d": 2,
            "e": 2,
            "f": 2,
            "g": 2,
            "h": 2,
        }
        eight := ["a", "b", "c", "d", "e", "f", "g", "h"]
        five := ["a", "b", "c", "d", "e"]
        clk := clock()
        $.with(Quotes=scripted(prices, busy), Clock=clk):
            assert_equal(order_total!(eight), .Ok(8))
            assert_equal(now().unix_milliseconds(), 40)
        clk2 := clock()
        $.with(Quotes=scripted(prices, busy), Clock=clk2):
            assert_equal(order_total!(five), .Ok(5))
            assert_equal(now().unix_milliseconds(), 40)
