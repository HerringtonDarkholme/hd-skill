use std.testing.{Arbitrary, assert_equal}

## A least-recently-used cache from string keys to i64 values.
##
## `order` lists the keys from least to most recently used, and holds
## exactly the keys of `values`.
pub struct Lru:
    capacity: usize
    values: Map[string, i64]
    order: List[string]

## An empty cache that holds at most `capacity` entries.
pub fn new_lru(capacity: usize) -> Lru:
    Lru { capacity: capacity, values: {}, order: [] }

impl Lru:
    ## The value under `key`. A hit makes `key` the most recently used; a
    ## miss changes nothing.
    pub fn get(&mut self, key: string) -> i64?:
        if self.values.contains_key(key):
            self.forget(key)
            self.order.push(key)
        self.values.get(key)

    ## Inserts or updates `key`, makes it the most recently used, then evicts
    ## the least recently used entry while the cache is over capacity.
    pub fn put(&mut self, key: string, value: i64) -> void:
        self.forget(key)
        self.values[key] = value
        self.order.push(key)
        while self.values.len() > self.capacity:
            oldest := self.order.remove(0)
            _ := self.values.remove(oldest)

    ## The number of entries currently held.
    pub fn len(self) -> usize:
        self.values.len()

    ## Removes `key` from the recency order, if present.
    fn forget(&mut self, key: string):
        self.order.retain(fn(other): other != key)

## A plain model of the cache: a list ordered from least to most recent.
@derive(Debug)
struct Entry:
    key: string
    value: i64

struct Model:
    capacity: usize
    entries: List[Entry]

impl Model:
    fn get(&mut self, key: string) -> i64?:
        match self.entries.find(fn(entry): entry.key == key):
            .Some(entry) =>
                self.drop_key(key)
                self.entries.push(entry)
                .Some(entry.value)
            .None => .None

    fn put(&mut self, key: string, value: i64):
        self.drop_key(key)
        self.entries.push(Entry { key: key, value: value })
        while self.entries.len() > self.capacity:
            self.entries.remove(0)

    fn len(self) -> usize:
        self.entries.len()

    fn drop_key(&mut self, key: string):
        self.entries.retain(fn(entry): entry.key != key)

## One step of a generated run. Keys are drawn from a small pool so that
## hits, updates and evictions all happen often.
@derive(Arbitrary, Debug)
enum Op:
    Get(key: u8)
    Put(key: u8, value: i64)

@derive(Arbitrary, Debug)
struct Run:
    capacity: u8
    ops: List[Op]

fn key_of(n: u8) -> string:
    "k${n % 4}"

fn capacity_of(run: Run) -> usize:
    usize(run.capacity % 5)

## Replays `run` on the cache and on the model, checking every answer.
fn check_run(run: Run):
    let mut cache = new_lru(capacity_of(run))
    let mut model = Model { capacity: capacity_of(run), entries: [] }
    for op in run.ops:
        match op:
            .Get(key) => assert_equal(cache.get(key_of(key)), model.get(key_of(key)))
            .Put(key, value) =>
                cache.put(key_of(key), value)
                model.put(key_of(key), value)
        assert_equal(cache.len(), model.len())
    for n in [0, 1, 2, 3]:
        assert_equal(cache.get(key_of(n)), model.get(key_of(n)))

tests:
    use std.testing.it_prop

    it("starts empty"):
        let mut cache = new_lru(3)
        assert_equal(cache.len(), 0)
        assert_equal(cache.get("a"), .None)

    it("stores and reads back a value"):
        let mut cache = new_lru(3)
        cache.put("a", 1)
        assert_equal(cache.get("a"), .Some(1))
        assert_equal(cache.len(), 1)

    it("updates an existing key without growing"):
        let mut cache = new_lru(3)
        cache.put("a", 1)
        cache.put("a", 2)
        assert_equal(cache.get("a"), .Some(2))
        assert_equal(cache.len(), 1)

    it("evicts the least recently inserted key"):
        let mut cache = new_lru(2)
        cache.put("a", 1)
        cache.put("b", 2)
        cache.put("c", 3)
        assert_equal(cache.get("a"), .None, reason="a was the oldest")
        assert_equal(cache.get("b"), .Some(2))
        assert_equal(cache.get("c"), .Some(3))
        assert_equal(cache.len(), 2)

    it("a hit makes the key most recent"):
        let mut cache = new_lru(2)
        cache.put("a", 1)
        cache.put("b", 2)
        assert_equal(cache.get("a"), .Some(1))
        cache.put("c", 3)
        assert_equal(cache.get("b"), .None, reason="b became the oldest")
        assert_equal(cache.get("a"), .Some(1))

    it("an update makes the key most recent"):
        let mut cache = new_lru(2)
        cache.put("a", 1)
        cache.put("b", 2)
        cache.put("a", 10)
        cache.put("c", 3)
        assert_equal(cache.get("b"), .None, reason="b became the oldest")
        assert_equal(cache.get("a"), .Some(10))

    it("a miss changes nothing"):
        let mut cache = new_lru(2)
        cache.put("a", 1)
        cache.put("b", 2)
        assert_equal(cache.get("z"), .None)
        assert_equal(cache.len(), 2)
        cache.put("c", 3)
        assert_equal(cache.get("a"), .None, reason="the miss must not refresh a")

    it("capacity one keeps only the last key"):
        let mut cache = new_lru(1)
        cache.put("a", 1)
        cache.put("b", 2)
        assert_equal(cache.get("a"), .None)
        assert_equal(cache.get("b"), .Some(2))
        assert_equal(cache.len(), 1)

    it("capacity zero holds nothing"):
        let mut cache = new_lru(0)
        cache.put("a", 1)
        assert_equal(cache.get("a"), .None)
        assert_equal(cache.len(), 0)

    it_prop("generated runs agree with the model", prop=fn!(run: Run): check_run(run))
