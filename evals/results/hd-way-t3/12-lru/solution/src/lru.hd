## A least-recently-used cache from string keys to i64 values.
##
## `get` and `put` make their key the most recently used. When `put` leaves
## more keys than the capacity, the least recently used key is evicted.
pub struct Lru:
    capacity: usize
    values: Map[string, i64]
    order: List[string] # keys, least recently used first; the keys of `values`

## An empty cache that holds at most `capacity` keys.
pub fn new_lru(capacity: usize) -> Lru:
    Lru { capacity: capacity, values: {}, order: [] }

impl Lru:
    ## The value stored under `key`; a hit makes `key` the most recently used.
    ## A miss changes nothing.
    pub fn get(&mut self, key: string) -> i64?:
        match self.values.get(key):
            .Some(value) =>
                self.touch(key)
                .Some(value)
            .None => .None

    ## Stores `value` under `key` and makes `key` the most recently used, then
    ## evicts the least recently used key if the cache is over capacity.
    pub fn put(&mut self, key: string, value: i64) -> void:
        if self.values.contains_key(key):
            self.touch(key)
        else:
            self.order.push(key)
        _ := self.values.insert(key, value)
        if self.values.len() > self.capacity:
            oldest := self.order.remove(0)
            _ := self.values.remove(oldest)

    pub fn len(self) -> usize:
        self.values.len()

    ## Moves `key`, which must be stored, to the most recently used end.
    fn touch(&mut self, key: string) -> void:
        index := self.order.index_of(key).expect("a stored key is in the order")
        _ := self.order.remove(index)
        self.order.push(key)

tests:
    use std.testing.{Choices, it_prop_with}

    @derive(Eq, Debug)
    enum Op:
        Get(key: string)
        Put(key: string, value: i64)

    @derive(Debug)
    struct Scenario:
        capacity: usize
        ops: List[Op]

    ## The model: (key, value) pairs, least recently used first.
    fn model_lookup(entries: List[(string, i64)], key: string) -> i64?:
        match entries.find(fn(pair): pair._0 == key):
            .Some(pair) => .Some(pair._1)
            .None => .None

    fn model_get(entries: List[(string, i64)], key: string) -> (List[(string, i64)], i64?):
        match entries.find(fn(pair): pair._0 == key):
            .Some(pair) =>
                let mut next = entries.filter(fn(p): p._0 != key)
                next.push((key, pair._1))
                (next, .Some(pair._1))
            .None => (entries, .None)

    fn model_put(
        entries: List[(string, i64)],
        capacity: usize,
        key: string,
        value: i64,
    ) -> List[(string, i64)]:
        let mut next = entries.filter(fn(p): p._0 != key)
        next.push((key, value))
        if next.len() > capacity:
            next = next.slice(1, next.len())
        next

    fn check_contents(lru: Lru, model: List[(string, i64)]) -> void:
        for key in ["a", "b", "c", "d"]:
            let mut probe = lru # a copy, so probing does not change `lru`
            assert_equal(probe.get(key), model_lookup(model, key), reason="contents of $key")

    fn run_scenario(scenario: Scenario) -> void:
        let mut lru = new_lru(scenario.capacity)
        let mut model: List[(string, i64)] = []
        for op in scenario.ops:
            match op:
                .Get(key) =>
                    result := model_get(model, key)
                    model = result._0
                    assert_equal(lru.get(key), result._1, reason="get $key")
                .Put(key, value) =>
                    model = model_put(model, scenario.capacity, key, value)
                    lru.put(key, value)
            assert_equal(lru.len(), model.len(), reason="len")
            check_contents(lru, model)

    fn gen_op(c: &mut Choices) -> Op:
        key := c.choose(["a", "b", "c", "d"])
        if c.bool(): .Get(key) else: .Put(key, c.choose([1, 2, 3]))

    fn gen_scenario(c: &mut Choices) -> Scenario:
        Scenario { capacity: c.choose([0, 1, 2, 3]), ops: c.list(40, gen_op) }

    it("a new cache has no keys"):
        let mut lru = new_lru(3)
        assert_equal(lru.len(), 0)
        assert_equal(lru.get("a"), .None)

    it("stores and reads back a value"):
        let mut lru = new_lru(3)
        lru.put("a", 10)
        assert_equal(lru.get("a"), .Some(10))
        assert_equal(lru.len(), 1)

    it("a put on an existing key replaces its value and does not grow"):
        let mut lru = new_lru(3)
        lru.put("a", 10)
        lru.put("a", 20)
        assert_equal(lru.get("a"), .Some(20))
        assert_equal(lru.len(), 1)

    it("evicts the least recently put key when over capacity"):
        let mut lru = new_lru(2)
        lru.put("a", 1)
        lru.put("b", 2)
        lru.put("c", 3)
        assert_equal(lru.get("a"), .None)
        assert_equal(lru.get("b"), .Some(2))
        assert_equal(lru.get("c"), .Some(3))
        assert_equal(lru.len(), 2)

    it("a hit makes its key the most recently used"):
        let mut lru = new_lru(2)
        lru.put("a", 1)
        lru.put("b", 2)
        assert_equal(lru.get("a"), .Some(1))
        lru.put("c", 3)
        assert_equal(lru.get("b"), .None, reason="b was the least recent")
        assert_equal(lru.get("a"), .Some(1))

    it("a put on an existing key makes it the most recently used"):
        let mut lru = new_lru(2)
        lru.put("a", 1)
        lru.put("b", 2)
        lru.put("a", 5)
        lru.put("c", 3)
        assert_equal(lru.get("b"), .None, reason="b was the least recent")
        assert_equal(lru.get("a"), .Some(5))

    it("a missed get changes nothing"):
        let mut lru = new_lru(2)
        lru.put("a", 1)
        lru.put("b", 2)
        assert_equal(lru.get("z"), .None)
        lru.put("c", 3)
        assert_equal(lru.get("a"), .None, reason="a stayed the least recent")
        assert_equal(lru.len(), 2)

    it("capacity zero keeps nothing"):
        let mut lru = new_lru(0)
        lru.put("a", 1)
        assert_equal(lru.len(), 0)
        assert_equal(lru.get("a"), .None)

    it("capacity one keeps only the last key put"):
        let mut lru = new_lru(1)
        lru.put("a", 1)
        lru.put("b", 2)
        assert_equal(lru.get("a"), .None)
        assert_equal(lru.get("b"), .Some(2))

    it_prop_with(
        "matches the model over generated operation sequences",
        gen=gen_scenario,
        cases=500,
        prop=fn!(scenario: Scenario): run_scenario(scenario)
    )
