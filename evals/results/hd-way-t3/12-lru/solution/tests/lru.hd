use pkg.{Lru, new_lru}
use std.testing.assert_equal

it("reads back through the package interface"):
    let mut cache: Lru = new_lru(2)
    cache.put("a", 1)
    assert_equal(cache.get("a"), .Some(1))
    assert_equal(cache.len(), 1)

it("evicts through the package interface"):
    let mut cache = new_lru(1)
    cache.put("a", 1)
    cache.put("b", 2)
    assert_equal(cache.get("a"), .None)
    assert_equal(cache.get("b"), .Some(2))
