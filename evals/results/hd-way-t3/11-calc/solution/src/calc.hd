# An integer expression evaluator. `eval` tokenizes the source, parses it
# into an `Expr` tree, then evaluates the tree. Parsing finishes before any
# arithmetic, so a syntax error wins over a division by zero later on.

@error
@derive(Eq, Debug)
pub enum CalcError:
    @error("division by zero")
    DivideByZero
    @error("unexpected input at byte $at")
    Unexpected(at: usize)

# The syntax tree. A recursive variant holds its children through `*Expr`.
enum Expr:
    Num(i64)
    Neg(*Expr)
    Add(*Expr, *Expr)
    Sub(*Expr, *Expr)
    Mul(*Expr, *Expr)
    Div(*Expr, *Expr)

@derive(Eq, Debug)
enum Token:
    Num(i64)
    Plus
    Minus
    Star
    Slash
    LParen
    RParen
    End # the end of the input; its offset is `src.len()`
    Invalid # a byte the grammar has no token for, or a number too large for i64

struct Lexeme:
    token: Token
    at: usize # byte offset where the token starts

pub fn eval(src: string) -> Result[i64, CalcError]:
    let mut parser = Parser { tokens: tokenize(src), at: 0 }
    tree := parser.expr()?
    if parser.current() != Token.End:
        return .Err(parser.unexpected())
    evaluate(&tree)

fn is_digit(b: u8) -> bool:
    b >= 48 && b <= 57 # '0'..'9'

fn is_space(b: u8) -> bool:
    b == 32 || b == 9 || b == 10 || b == 13

fn punct(b: u8) -> Token:
    if b == 43:
        return .Plus # '+'
    if b == 45:
        return .Minus # '-'
    if b == 42:
        return .Star # '*'
    if b == 47:
        return .Slash # '/'
    if b == 40:
        return .LParen # '('
    if b == 41:
        return .RParen # ')'
    .Invalid

fn tokenize(src: string) -> List[Lexeme]:
    let bytes = src.to_utf8()
    let mut tokens: List[Lexeme] = []
    let i: usize = 0
    while i < bytes.len():
        b := bytes[i]
        if is_space(b):
            i += 1
        else if is_digit(b):
            start := i
            while i < bytes.len() && is_digit(bytes[i]):
                i += 1
            token := match src.slice(start, i).parse::[i64]():
                .Ok(n) => Token.Num(n)
                .Err(_) => Token.Invalid
            tokens.push(Lexeme { token: token, at: start })
        else:
            tokens.push(Lexeme { token: punct(b), at: i })
            i += 1
    tokens.push(Lexeme { token: Token.End, at: bytes.len() })
    tokens

# Recursive descent, one function per precedence level:
#   expr    := term (('+' | '-') term)*
#   term    := unary (('*' | '/') unary)*
#   unary   := '-' unary | primary
#   primary := NUM | '(' expr ')'
struct Parser:
    tokens: List[Lexeme]
    at: usize

impl Parser:
    fn current(&self) -> Token:
        self.tokens[self.at].token

    # The error for the token the grammar cannot accept here.
    fn unexpected(&self) -> CalcError:
        CalcError.Unexpected(self.tokens[self.at].at)

    fn expr(&mut self) -> Result[Expr, CalcError]:
        let mut left = self.term()?
        while true:
            match self.current():
                .Plus =>
                    self.at += 1
                    right := self.term()?
                    left = Expr.Add(box(left), box(right))
                .Minus =>
                    self.at += 1
                    right := self.term()?
                    left = Expr.Sub(box(left), box(right))
                _ => break
        .Ok(left)

    fn term(&mut self) -> Result[Expr, CalcError]:
        let mut left = self.unary()?
        while true:
            match self.current():
                .Star =>
                    self.at += 1
                    right := self.unary()?
                    left = Expr.Mul(box(left), box(right))
                .Slash =>
                    self.at += 1
                    right := self.unary()?
                    left = Expr.Div(box(left), box(right))
                _ => break
        .Ok(left)

    fn unary(&mut self) -> Result[Expr, CalcError]:
        if self.current() == Token.Minus:
            self.at += 1
            inner := self.unary()?
            return .Ok(Expr.Neg(box(inner)))
        self.primary()

    fn primary(&mut self) -> Result[Expr, CalcError]:
        match self.current():
            .Num(n) =>
                self.at += 1
                .Ok(Expr.Num(n))
            .LParen =>
                self.at += 1
                inner := self.expr()?
                if self.current() != Token.RParen:
                    return .Err(self.unexpected())
                self.at += 1
                .Ok(inner)
            _ => .Err(self.unexpected())

fn evaluate(e: &Expr) -> Result[i64, CalcError]:
    match e:
        .Num(n) => .Ok(n)
        .Neg(inner) => .Ok(-evaluate(inner)?)
        .Add(l, r) => .Ok(evaluate(l)? + evaluate(r)?)
        .Sub(l, r) => .Ok(evaluate(l)? - evaluate(r)?)
        .Mul(l, r) => .Ok(evaluate(l)? * evaluate(r)?)
        .Div(l, r) =>
            let dividend = evaluate(l)?
            let divisor = evaluate(r)?
            if divisor == 0:
                return .Err(.DivideByZero)
            .Ok(dividend / divisor) # truncates toward zero

tests:
    use std.testing.{it_each}

    it_each(
        "evaluates well-formed expressions",
        [
            ("42", 42),
            ("1 + 2 * 3", 7),
            ("2 * 3 + 4", 10),
            ("10 - 4 - 3", 3),
            ("8 / 4 / 2", 1),
            ("(1 + 2) * 3", 9),
            ("2 * (3 + 4) * 5", 70),
            ("-(2 + 3)", -5),
            ("- -4", 4),
            ("2 * -3", -6),
            ("7 / 2", 3),
            ("-7 / 2", -3),
            ("7 / -2", -3),
            ("  1 +\t2\n", 3),
            ("1+2*3-4/2", 5),
            ("((((9))))", 9),
        ],
        body=fn!(row: (string, i64)): assert_equal(eval(row._0), .Ok(row._1), reason=row._0)
    )

    it_each(
        "reports the byte offset of a syntax error",
        [
            ("1 +", 3),
            ("1 2", 2),
            ("", 0),
            ("1 $ 2", 2),
            ("(1", 2),
            ("()", 1),
            ("1 )", 2),
            ("*2", 0),
            ("1 + x", 4),
            ("1 / 0 +", 7),
            ("1 / 0 2", 6),
            ("99999999999999999999", 0),
        ],
        body=fn!(row: (string, usize)):
            assert_equal(eval(row._0), .Err(CalcError.Unexpected(row._1)), reason=row._0)
    )

    it_each(
        "dividing by zero is DivideByZero",
        ["1 / 0", "1 / (2 - 2)", "-5 / 0"],
        body=fn!(src: string): assert_equal(eval(src), .Err(CalcError.DivideByZero), reason=src)
    )

    it("an error message names the offset"):
        assert_equal(CalcError.Unexpected(3).to_string(), "unexpected input at byte 3")
