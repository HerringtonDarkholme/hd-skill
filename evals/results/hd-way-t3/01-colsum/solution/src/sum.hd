## Why an error: a line that cannot give the key or the value.
@error
@derive(Eq, Debug)
pub enum SumError:
    @error("line $line: fewer columns than needed")
    MissingColumn(line: usize)
    @error("line $line: not an integer: $text")
    NotANumber(line: usize, text: string)

# The trimmed cell in 1-based column `column`. Column 0 never exists, so it
# is missing like any column past the end of the line.
fn cell(cells: List[string], column: usize) -> string?:
    if column == 0 || column > cells.len():
        return .None
    .Some(cells[column - 1].trim())

## Sum column `value` of CSV `text`, grouped by column `key`, sorted by key.
## Blank lines are ignored; `skip_header` ignores the first line.
pub fn summarize(
    text: string,
    key: usize,
    value: usize,
    skip_header: bool,
) -> Result[List[(string, i64)], SumError]:
    let mut totals: Map[string, i64] = {}
    let number: usize = 0
    for line in text.lines():
        number += 1
        if (skip_header && number == 1) || line.trim() == "":
            continue
        cells := line.split(",")
        name := match cell(cells, key):
            .Some(name) => name
            .None => return .Err(.MissingColumn(number))
        raw := match cell(cells, value):
            .Some(raw) => raw
            .None => return .Err(.MissingColumn(number))
        amount := match raw.parse::[i64]():
            .Ok(amount) => amount
            .Err(_) => return .Err(.NotANumber(number, raw))
        *totals.get_or_insert(name, 0) += amount
    let mut names: List[string] = totals.keys().collect()
    names.sort()
    .Ok([for name in names => (name, totals[name])])

tests:
    it("sums the value column per key, sorted by key"):
        result := summarize("b,2\na,1\nb,3\n", 1, 2, false)
        assert_equal(result, .Ok([("a", 1), ("b", 5)]))

    it("groups by any column and sums any column"):
        result := summarize("x,a,1\ny,b,2\nz,a,10", 2, 3, false)
        assert_equal(result, .Ok([("a", 11), ("b", 2)]))

    it("trims spaces around keys and values"):
        result := summarize(" a , 4 \n  a,  -1 ", 1, 2, false)
        assert_equal(result, .Ok([("a", 3)]))

    it("accepts signed values"):
        result := summarize("a,-3\na,+1", 1, 2, false)
        assert_equal(result, .Ok([("a", -2)]))

    it("ignores blank lines but counts them as lines"):
        assert_equal(summarize("a,1\n\n   \nb,2", 1, 2, false), .Ok([("a", 1), ("b", 2)]))
        assert_equal(summarize("a,1\n\nb,x", 1, 2, false), .Err(.NotANumber(3, "x")))

    it("skips the header when asked, counting it as line 1"):
        assert_equal(summarize("name,amount\na,1", 1, 2, true), .Ok([("a", 1)]))
        assert_equal(summarize("name,amount\na,1", 1, 2, false), .Err(.NotANumber(1, "amount")))

    it("reports a line with too few columns"):
        assert_equal(summarize("a,1\nb", 1, 2, false), .Err(.MissingColumn(2)))

    it("reports a missing key column too"):
        assert_equal(summarize("a,1\n,\n", 3, 2, false), .Err(.MissingColumn(1)))

    it("reports a value that is not an integer, with the trimmed text"):
        assert_equal(summarize("a, 1.5 ", 1, 2, false), .Err(.NotANumber(1, "1.5")))

    it("treats column 0 as missing rather than panicking"):
        assert_equal(summarize("a,1", 0, 2, false), .Err(.MissingColumn(1)))

    it("gives empty output for empty input"):
        assert_equal(summarize("", 1, 2, false), .Ok([]))

    it("formats each error with its line number"):
        assert_equal("${SumError.MissingColumn(4)}", "line 4: fewer columns than needed")
        assert_equal("${SumError.NotANumber(2, "x")}", "line 2: not an integer: x")
