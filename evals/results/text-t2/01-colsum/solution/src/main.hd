use std.cli.{Args, Cli, ScriptedArgs}
use std.console.{Console, ConsoleInput, MemoryConsole, ScriptedInput, eprintln, read_all}
use std.process.ExitCode
use pkg.sum.{summarize}

## Sum one CSV column grouped by another, read from standard input
@derive(Cli)
struct Options:
    ## the 1-based column to group by
    key: usize = 1
    ## the 1-based column to sum
    value: usize = 2
    ## ignore the first line
    skip_header: bool

pub fn main!() -> ExitCode $ Args + Console + ConsoleInput:
    options := match Options::parse_args():
        .Ok(options) => options
        .Err(error) => return error.exit() # usage error: status 2; --help: status 0
    text := match read_all!():
        .Ok(text) => text
        .Err(error) =>
            eprintln("colsum: $error")
            return ExitCode(1)
    totals := match summarize(text, options.key, options.value, options.skip_header):
        .Ok(totals) => totals
        .Err(error) =>
            eprintln("colsum: $error")
            return ExitCode(1)
    for (key, total) in totals:
        println("$key,$total")
    ExitCode(0)

tests:
    it("parses the defaults"):
        options := Options::parse([]).expect("valid arguments")
        assert_equal(options.key, 1)
        assert_equal(options.value, 2)
        assert(!options.skip_header)

    it("parses the options"):
        options := Options::parse(["--key", "3", "--value", "4", "--skip-header"])
            .expect("valid arguments")
        assert_equal(options.key, 3)
        assert_equal(options.value, 4)
        assert(options.skip_header)

    it("sums standard input"):
        input := ScriptedInput::new(["region,sales", "west, 5", "east,2", "west,-1", ""])
        arguments := box(ScriptedArgs::new("colsum", ["--skip-header"]))
        console := MemoryConsole::new()
        $.with(Args=arguments, ConsoleInput=input, Console=console):
            assert_equal(main!(), ExitCode(0))
        assert_equal(console.output().join(""), "east,2\nwest,4\n")
        assert_equal(console.error_output().join(""), "")

    it("reports a bad row on standard error and prints nothing else"):
        input := ScriptedInput::new(["a,1", "b,x"])
        arguments := box(ScriptedArgs::new("colsum", []))
        console := MemoryConsole::new()
        $.with(Args=arguments, ConsoleInput=input, Console=console):
            assert_equal(main!(), ExitCode(1))
        assert_equal(console.output().join(""), "")
        assert_equal(console.error_output().join(""), "colsum: line 2: not an integer: x\n")
