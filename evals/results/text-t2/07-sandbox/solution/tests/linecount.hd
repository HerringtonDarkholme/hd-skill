use std.process.Command
use std.testing.{assert_equal, hd_run}

it("counts each file and the total"):
    let out = hd_run!(*Command::new("linecount").args(["data/three.txt"]))
    assert_equal(out.stdout, "3 data/three.txt\n3 total\n", reason="gamma has no newline")
    assert_equal(out.stderr, "", reason="nothing to report")
    assert_equal(out.status, 0, reason="every file read")

it("reports a missing file and exits 1"):
    let out = hd_run!(*Command::new("linecount").args(["data/three.txt", "data/nope.txt"]))
    assert_equal(out.stdout, "3 data/three.txt\n3 total\n")
    assert_equal(out.stderr, "linecount: data/nope.txt: no such file\n")
    assert_equal(out.status, 1)

it("refuses a path outside data/"):
    let out = hd_run!(*Command::new("linecount").args(["../hd.toml"]))
    assert_equal(out.stdout, "0 total\n")
    assert_equal(out.stderr, "linecount: ../hd.toml: not allowed: files must be under data/\n")
    assert_equal(out.status, 1)
