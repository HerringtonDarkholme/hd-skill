use std.cli.{Args, args}
use std.console.eprintln
use std.fs.{FsError, FsRead, read_bytes}
use std.path.Path
use std.process.ExitCode

## The number of lines in `bytes`: each `\n` ends one line, and a last
## line without a newline still counts.
fn count_lines(bytes: List[u8]) -> usize:
    let lines: usize = 0
    for byte in bytes:
        if byte == 10:
            lines += 1
    if !bytes.is_empty() && bytes[bytes.len() - 1] != 10:
        lines += 1
    lines

## Why a file could not be read, as a short phrase for the message.
fn reason(error: FsError) -> string:
    match error:
        .NotGranted(_) => "not allowed: files must be under data/"
        .NotFound(_) => "no such file"
        .IsADirectory(_) => "is a directory"
        .PermissionDenied(_) => "permission denied"
        _ => "$error"

fn count_file!(file: string) -> Result[usize, FsError] $ FsRead:
    bytes := read_bytes!(Path(file))?
    .Ok(count_lines(bytes))

## Prints each file's line count and the total. A file that cannot be read
## is reported on standard error and skipped; the status is 1 if any failed.
fn run!(files: List[string]) -> ExitCode $ Console + FsRead:
    let total: usize = 0
    let failed = false
    for file in files:
        match count_file!(file):
            .Ok(lines) =>
                println("$lines $file")
                total += lines
            .Err(error) =>
                eprintln("linecount: $file: ${reason(error)}")
                failed = true
    println("$total total")
    if failed: ExitCode(1) else: ExitCode(0)

pub fn main!() -> ExitCode $ Args + Console + FsRead:
    run!(args())

tests:
    use std.console.MemoryConsole
    use std.fs.{FsWrite, MemoryFs, create_dir_all, write_bytes}

    fn bytes_of(text: string) -> List[u8]:
        text.bytes().collect()

    it("counts newlines"):
        assert_equal(count_lines(bytes_of("a\nb\n")), 2)

    it("counts a final line without a newline"):
        assert_equal(count_lines(bytes_of("a\nb")), 2)
        assert_equal(count_lines(bytes_of("only")), 1)

    it("counts an empty file as zero lines"):
        assert_equal(count_lines([]), 0)

    it("counts a lone newline and blank lines"):
        assert_equal(count_lines(bytes_of("\n")), 1)
        assert_equal(count_lines(bytes_of("\n\n\n")), 3)

    it("prints each count and the total, in argument order"):
        fs := MemoryFs::new()
        console := MemoryConsole::new()
        $.with(FsWrite=fs):
            _ := create_dir_all!(Path("data"))
            _ := write_bytes!(Path("data/two.txt"), bytes_of("a\nb\n"))
            _ := write_bytes!(Path("data/one.txt"), bytes_of("x"))
        $.with(FsRead=fs, Console=console):
            assert_equal(run!(["data/two.txt", "data/one.txt"]), ExitCode(0))
        assert_equal(console.output().join(""), "2 data/two.txt\n1 data/one.txt\n3 total\n")

    it("skips an unreadable file, reports it, and exits 1"):
        fs := MemoryFs::new()
        console := MemoryConsole::new()
        $.with(FsWrite=fs):
            _ := create_dir_all!(Path("data"))
            _ := write_bytes!(Path("data/a.txt"), bytes_of("a\nb\nc"))
        $.with(FsRead=fs, Console=console):
            assert_equal(run!(["data/a.txt", "data/missing.txt"]), ExitCode(1))
        assert_equal(console.output().join(""), "3 data/a.txt\n3 total\n")
        assert_equal(console.error_output().join(""), "linecount: data/missing.txt: no such file\n")

    it("with no files prints a zero total"):
        console := MemoryConsole::new()
        $.with(FsRead=MemoryFs::new(), Console=console):
            assert_equal(run!([]), ExitCode(0))
        assert_equal(console.output().join(""), "0 total\n")
