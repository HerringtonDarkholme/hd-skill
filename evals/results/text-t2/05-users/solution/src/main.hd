use pkg.users.{User, UserError, UserStore, rename}

struct MemStore:
    users: Map[i64, User]

impl UserStore for MemStore:
    fn get!(&mut self, id: i64) -> User?:
        self.users.get(id)
    fn put!(&mut self, user: User) -> void:
        self.users[user.id] = user

fn report(result: Result[User, UserError]) -> void $ Console:
    match result:
        .Ok(user) => println("renamed ${user.id} to ${user.name}")
        .Err(error) => println("error: $error")

pub fn main!() -> void $ Console:
    store := box(MemStore { users: { 1: User { id: 1, name: "ada" } } })
    $.with(UserStore=store):
        report(rename!(1, "Ada Lovelace"))
        report(rename!(2, "Grace"))
