use std.encoding.Deserialize
use std.encoding.json.{JsonError, decode}
use std.fs.{FsError, FsRead, read_text}
use std.host.{Env, HostError, env_decode}
use std.path.Path
use std.validate.{Validate, ValidationError, length, range}

@derive(Deserialize, Validate, Eq, Debug)
pub struct Config:
    @length(1, 253)
    pub host: string
    @range(1024, 65535)
    pub port: i32
    @range(1, 64)
    pub workers: i32 = 4

@derive(Deserialize)
struct Overrides:
    port: i32?

@error
pub enum ConfigError:
    @error("cannot read the config file")
    Read(@from error: FsError)
    @error("the config file is not valid: $error")
    Parse(@from error: JsonError)
    @error("$error")
    Environment(@from error: HostError)
    @error("$error")
    Invalid(@from error: ValidationError)

## Reads the JSON file at `path`; `APP_PORT` overrides its port; then checks the rules.
pub fn load_config!(path: string) -> Result[Config, ConfigError] $ FsRead + Env:
    config := decode::[Config](read_text!(Path(path))?)?
    overrides := env_decode::[Overrides](prefix="APP_")?
    merged := Config { ...config, port: overrides.port.unwrap_or(config.port) }
    .Ok(merged.validated()?)

tests:
    use std.fs.{FsWrite, MemoryFs, write_text}
    use std.host.ScriptedEnv

    fn load_with!(text: string, env: Map[string, string]) -> Result[Config, ConfigError]:
        fs := MemoryFs::new()
        $.with(FsWrite=fs):
            _ := write_text!(Path("app.json"), text)
        $.with(FsRead=fs, Env=box(ScriptedEnv::new(env))):
            load_config!("app.json")

    it("fills the default workers"):
        assert_equal(load_with!("{\"host\": \"db\", \"port\": 5432}", {}).ok(), .Some(Config { host: "db", port: +5432, workers: +4 }))

    it("lets APP_PORT override the file, then checks it"):
        assert(load_with!("{\"host\": \"db\", \"port\": 5432}", {"APP_PORT": "80"}).is_err())
