use pkg.config.{Config, ConfigError, load_config}
use std.fs.{FsRead, FsWrite, MemoryFs, write_text}
use std.host.{Env, ScriptedEnv}
use std.testing.it_each
use std.path.Path

fn fs_with!(text: string) -> *mut MemoryFs:
    fs := MemoryFs::new()
    $.with(FsWrite=fs):
        _ := write_text!(Path("app.json"), text)
    fs

fn load!(text: string, env: Map[string, string]) -> Result[Config, ConfigError]:
    fs := fs_with!(text)
    $.with(FsRead=fs, Env=box(ScriptedEnv::new(env))):
        load_config!("app.json")

it("hidden: reads the file with the default workers"):
    assert_equal(load!("{\"host\": \"db\", \"port\": 5432}", {}).ok(), .Some(Config { host: "db", port: +5432, workers: +4 }))

it("hidden: APP_PORT overrides the file"):
    assert_equal(load!("{\"host\": \"db\", \"port\": 5432, \"workers\": 8}", {"APP_PORT": "6000"}).ok(), .Some(Config { host: "db", port: +6000, workers: +8 }))

it("hidden: a missing file is Read"):
    $.with(FsRead=MemoryFs::new(), Env=box(ScriptedEnv::new({}))):
        match load_config!("app.json"):
            .Err(.Read(_)) => pass
            _ => assert(false, reason="expected Read")

it("hidden: malformed JSON is Parse"):
    match load!("{\"host\": ", {}):
        .Err(.Parse(_)) => pass
        _ => assert(false, reason="expected Parse")

it("hidden: a bad APP_PORT is Environment"):
    match load!("{\"host\": \"db\", \"port\": 5432}", {"APP_PORT": "high"}):
        .Err(.Environment(_)) => pass
        _ => assert(false, reason="expected Environment")

it_each("hidden: rule violations are Invalid", [
    "{\"host\": \"\", \"port\": 5432}",
    "{\"host\": \"db\", \"port\": 80}",
    "{\"host\": \"db\", \"port\": 70000}",
    "{\"host\": \"db\", \"port\": 5432, \"workers\": 0}",
    "{\"host\": \"db\", \"port\": 5432, \"workers\": 65}",
], body=fn!(text: string):
    match load!(text, {}):
        .Err(.Invalid(_)) => pass
        _ => assert(false, reason=text)
)

it("hidden: APP_PORT is checked too"):
    match load!("{\"host\": \"db\", \"port\": 5432}", {"APP_PORT": "99"}):
        .Err(.Invalid(_)) => pass
        _ => assert(false, reason="expected Invalid")
