use pkg.rle.{Run, decode, encode}
use std.testing.it_prop

it("hidden: empty"):
    assert_equal(encode([]), [])
    assert_equal(decode([]), [])

it("hidden: runs are maximal"):
    assert_equal(encode([+5, +5, +5, -1, +5]), [Run { value: +5, count: 3 }, Run { value: -1, count: 1 }, Run { value: +5, count: 1 }])

it("hidden: decode expands"):
    assert_equal(decode([Run { value: +7, count: 2 }, Run { value: +0, count: 3 }]), [+7, +7, +0, +0, +0])

fn round_trip!(xs: List[i32]) -> void:
    assert_equal(decode(encode(xs)), xs)

fn well_formed!(xs: List[i32]) -> void:
    runs := encode(xs)
    for i in 0..runs.len():
        assert(runs[i].count > 0, reason="no empty run")
        if i > 0:
            assert(runs[i].value != runs[i - 1].value, reason="neighbours differ")

it_prop("hidden: decode undoes encode", prop=round_trip)
it_prop("hidden: runs are non-empty and neighbours differ", prop=well_formed)
