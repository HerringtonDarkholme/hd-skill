use pkg.fields.FieldNames

@derive(FieldNames)
struct User:
    id: i64
    name: string
    email: string?
    tags: List[string]

@derive(FieldNames)
struct Empty:
    pass

it("hidden: four fields in declaration order"):
    user := User { id: 1, name: "a", email: .None, tags: [] }
    assert_equal(user.field_names(), ["id", "name", "email", "tags"])

it("hidden: a struct with no fields"):
    assert_equal(Empty {}.field_names(), [])
