use pkg.users.{User, UserError, UserStore, rename}

struct Recording:
    users: Map[i64, User]
    puts: usize

impl UserStore for Recording:
    fn get!(&mut self, id: i64) -> User?:
        self.users.get(id)
    fn put!(&mut self, user: User) -> void:
        self.puts += 1
        self.users[user.id] = user

fn store() -> *mut Recording:
    box(Recording { users: {7: User { id: 7, name: "old" }}, puts: 0 })

it("hidden: renames and stores the trimmed name"):
    fake := store()
    $.with(UserStore=fake):
        assert_equal(rename!(7, "  Grace Hopper "), .Ok(User { id: 7, name: "Grace Hopper" }))
    assert_equal(fake.users.get(7), .Some(User { id: 7, name: "Grace Hopper" }))
    assert_equal(fake.puts, 1)

it("hidden: a missing user is NotFound and nothing is stored"):
    fake := store()
    $.with(UserStore=fake):
        assert_equal(rename!(8, "x"), .Err(.NotFound(8)))
    assert_equal(fake.puts, 0)

it("hidden: a blank name is EmptyName"):
    fake := store()
    $.with(UserStore=fake):
        assert_equal(rename!(7, "   "), .Err(.EmptyName))
    assert_equal(fake.users.get(7), .Some(User { id: 7, name: "old" }))
