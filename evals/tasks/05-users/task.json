{
  "package": "users",
  "scenario": "service with a user-defined effect",
  "selling_points": [
    "own effect trait",
    "$.use",
    "$.with providers",
    "fakes"
  ],
  "files": {},
  "runs": [
    {
      "args": [],
      "stdin": "",
      "stdout": "renamed 1 to Ada Lovelace\nerror: no user 2\n",
      "status": 0
    }
  ],
  "idiom": [
    {
      "id": "use-effect",
      "desc": "logic reaches the store with $.use(UserStore)",
      "scope": "src",
      "pattern": "\\$\\.use\\(UserStore\\)",
      "expect": true
    },
    {
      "id": "provide-in-main",
      "desc": "main provides a store with $.with",
      "scope": "src",
      "pattern": "\\$\\.with\\(UserStore\\s*=",
      "expect": true
    },
    {
      "id": "fake-store",
      "desc": "tests define their own UserStore fake",
      "scope": "all",
      "pattern": "impl UserStore for",
      "expect": true
    },
    {
      "id": "error-enum",
      "desc": "UserError declared with @error",
      "scope": "all",
      "pattern": "@error\\s*\\n(@derive[^\\n]*\\n)?\\s*pub enum UserError",
      "expect": true
    },
    {
      "id": "own-tests",
      "desc": "writes at least 2 test cases of its own",
      "kind": "min_tests",
      "n": 2
    }
  ],
  "expected_hidden": 3
}
