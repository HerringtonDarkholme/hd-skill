{
  "package": "todos",
  "scenario": "JSON in and out",
  "selling_points": [
    "derive Serialize/Deserialize",
    "field defaults",
    "property tests"
  ],
  "files": {},
  "runs": [],
  "idiom": [
    {
      "id": "derive-serde",
      "desc": "JSON through @derive(Serialize, Deserialize)",
      "scope": "all",
      "pattern": "@derive\\([^)]*\\bDeserialize\\b",
      "expect": true
    },
    {
      "id": "field-default",
      "desc": "done defaults with a field default",
      "scope": "all",
      "pattern": "done:\\s*bool\\s*=\\s*false",
      "expect": true
    },
    {
      "id": "prop-test",
      "desc": "round trip checked with a property test",
      "scope": "all",
      "pattern": "\\bit_prop(_with)?\\(",
      "expect": true
    },
    {
      "id": "own-tests",
      "desc": "writes at least 2 test cases of its own",
      "kind": "min_tests",
      "n": 2
    }
  ],
  "expected_hidden": 5
}
