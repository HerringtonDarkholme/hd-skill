use pkg.sum.{SumError, summarize}

it("hidden: groups, sums and sorts by key"):
    assert_equal(summarize("pear,3\napple,2\npear,-1\n", 1, 2, false), .Ok([("apple", 2i64), ("pear", 2i64)]))

it("hidden: other columns and a header"):
    text := "date,who,cents\n2026-01-01,bo,100\n2026-01-02,al,50\n2026-01-03,bo,25\n"
    assert_equal(summarize(text, 2, 3, true), .Ok([("al", 50i64), ("bo", 125i64)]))

it("hidden: blank lines are skipped"):
    assert_equal(summarize("a,1\n\n  \na,2\n", 1, 2, false), .Ok([("a", 3i64)]))

it("hidden: a bad number names its line"):
    assert_equal(summarize("a,1\nb,x\n", 1, 2, false), .Err(.NotANumber(2, "x")))

it("hidden: a short line is a missing column"):
    assert_equal(summarize("a,1\nb\n", 1, 2, false), .Err(.MissingColumn(2)))
