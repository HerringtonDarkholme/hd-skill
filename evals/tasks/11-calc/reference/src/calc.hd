@error
@derive(Eq, Debug)
pub enum CalcError:
    @error("division by zero")
    DivideByZero
    @error("unexpected input at byte $at")
    Unexpected(at: usize)

enum Expr:
    Num(value: i64)
    Neg(inner: *Expr)
    Bin(op: string, left: *Expr, right: *Expr)

struct Parser:
    src: string
    pos: usize

impl Parser:
    fn skip_spaces(&mut self) -> void:
        while self.pos < self.src.len() && self.src.slice(self.pos, self.pos + 1) == " ":
            self.pos += 1

    fn peek(&mut self) -> string:
        self.skip_spaces()
        if self.pos < self.src.len(): self.src.slice(self.pos, self.pos + 1) else: ""

    fn expr(&mut self) -> Result[Expr, CalcError]:
        let left = self.term()?
        while true:
            op := self.peek()
            if op != "+" && op != "-":
                break
            self.pos += 1
            right := self.term()?
            left = .Bin(op, box(left), box(right))
        .Ok(left)

    fn term(&mut self) -> Result[Expr, CalcError]:
        let left = self.factor()?
        while true:
            op := self.peek()
            if op != "*" && op != "/":
                break
            self.pos += 1
            right := self.factor()?
            left = .Bin(op, box(left), box(right))
        .Ok(left)

    fn factor(&mut self) -> Result[Expr, CalcError]:
        c := self.peek()
        if c == "-":
            self.pos += 1
            return .Ok(.Neg(box(self.factor()?)))
        if c == "(":
            self.pos += 1
            inner := self.expr()?
            if self.peek() != ")":
                return .Err(.Unexpected(self.pos))
            self.pos += 1
            return .Ok(inner)
        start := self.pos
        while self.pos < self.src.len() && "0123456789".contains(self.src.slice(self.pos, self.pos + 1)):
            self.pos += 1
        if self.pos == start:
            return .Err(.Unexpected(start))
        .Ok(.Num(self.src.slice(start, self.pos).parse::[i64]().expect("digits")))

fn value(e: Expr) -> Result[i64, CalcError]:
    match e:
        .Num(n) => .Ok(n)
        .Neg(inner) => .Ok(-value(*inner)?)
        .Bin(op, left, right) =>
            a := value(*left)?
            b := value(*right)?
            match op:
                "+" => .Ok(a + b)
                "-" => .Ok(a - b)
                "*" => .Ok(a * b)
                _ => if b == 0: .Err(.DivideByZero) else: .Ok(a / b)

## Evaluates an integer expression with + - * /, parentheses and unary minus.
pub fn eval(src: string) -> Result[i64, CalcError]:
    let mut parser = Parser { src: src, pos: 0 }
    e := parser.expr()?
    parser.skip_spaces()
    if parser.pos != src.len():
        return .Err(.Unexpected(parser.pos))
    value(e)

tests:
    it("respects precedence"):
        assert_equal(eval("1 + 2 * 3"), .Ok(7))

    use std.testing.it_each

    it_each("reports where parsing failed", [("1 +", 3), ("1 2", 2), ("", 0)], body=fn!(row: (string, usize)):
        assert_equal(eval(row._0), .Err(.Unexpected(row._1)))
    )
