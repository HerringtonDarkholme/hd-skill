use pkg.calc.{CalcError, eval}
use std.testing.it_each

it_each("hidden: values", [
    ("42", 42i64),
    ("1 + 2 * 3", 7i64),
    ("(1 + 2) * 3", 9i64),
    ("10 - 4 - 3", 3i64),
    ("100 / 10 / 5", 2i64),
    ("7 / 2", 3i64),
    ("-7 / 2", -3i64),
    ("-(2 + 3)", -5i64),
    ("2 * -3", -6i64),
    ("--4", 4i64),
    ("  ( ( 8 ) )  ", 8i64),
    ("2*3+4*5", 26i64),
], body=fn!(row: (string, i64)):
    assert_equal(eval(row._0), .Ok(row._1), reason=row._0)
)

it_each("hidden: errors", [
    ("1 / 0", CalcError.DivideByZero),
    ("1 / (2 - 2)", CalcError.DivideByZero),
    ("", CalcError.Unexpected(0)),
    ("1 +", CalcError.Unexpected(3)),
    ("1 2", CalcError.Unexpected(2)),
    ("(1", CalcError.Unexpected(2)),
    ("1 $ 2", CalcError.Unexpected(2)),
    (")", CalcError.Unexpected(0)),
], body=fn!(row: (string, CalcError)):
    assert_equal(eval(row._0), .Err(row._1), reason=row._0)
)
