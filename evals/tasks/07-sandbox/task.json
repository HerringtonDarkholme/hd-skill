{
  "package": "linecount",
  "scenario": "sandboxed program",
  "selling_points": [
    "scoped capability grants",
    "minimal capabilities"
  ],
  "files": {
    "data/a.txt": "a\nb\nc\n",
    "data/b.txt": "one"
  },
  "runs": [
    {
      "args": [
        "data/a.txt",
        "data/b.txt"
      ],
      "stdin": "",
      "stdout": "3 data/a.txt\n1 data/b.txt\n4 total\n",
      "status": 0
    },
    {
      "args": [
        "data/a.txt",
        "hd.toml"
      ],
      "stdin": "",
      "stdout": "3 data/a.txt\n3 total\n",
      "status": 1,
      "stderr_contains": "hd.toml"
    },
    {
      "args": [
        "data/nope.txt"
      ],
      "stdin": "",
      "stdout": "0 total\n",
      "status": 1,
      "stderr_contains": "linecount: data/nope.txt"
    }
  ],
  "idiom": [
    {
      "id": "minimal-caps",
      "desc": "[capabilities] grants only Console, Args and FsRead",
      "kind": "capabilities_only",
      "allow": [
        "Console",
        "Args",
        "FsRead"
      ]
    },
    {
      "id": "scoped-fsread",
      "desc": "FsRead scoped to data/",
      "scope": "hd.toml",
      "pattern": "FsRead\\s*=\\s*\\[\\s*\\\"data/?\\\"\\s*\\]",
      "expect": true
    }
  ]
}
