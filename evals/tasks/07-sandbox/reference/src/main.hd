use std.cli.{Args, args}
use std.console.eprintln
use std.fs.{FsRead, read_text}
use std.path.Path
use std.process.ExitCode

pub fn main!() -> ExitCode $ Args + Console + FsRead:
    let total: usize = 0
    let status: u8 = 0
    for name in args():
        match read_text!(Path(name)):
            .Ok(text) =>
                count := text.lines().len()
                total += count
                println("$count $name")
            .Err(error) =>
                eprintln("linecount: $name: $error")
                status = 1
    println("$total total")
    ExitCode(status)
