## A least-recently-used cache from string keys to i64 values.
pub struct Lru:
    capacity: usize
    values: Map[string, i64] = {}
    order: List[string] = []           # least recently used first

pub fn new_lru(capacity: usize) -> Lru:
    Lru { capacity: capacity }

impl Lru:
    pub fn len(self) -> usize:
        self.values.len()

    fn touch(&mut self, key: string) -> void:
        self.order = [for k in self.order if k != key => k]
        self.order.push(key)

    pub fn get(&mut self, key: string) -> i64?:
        value := self.values.get(key)?
        self.touch(key)
        .Some(value)

    pub fn put(&mut self, key: string, value: i64) -> void:
        if self.capacity == 0:
            return
        self.values[key] = value
        self.touch(key)
        if self.values.len() > self.capacity:
            oldest := self.order[0]
            self.order = self.order.slice(1, self.order.len())
            _ := self.values.remove(oldest)

tests:
    it("evicts the least recently used key"):
        let mut cache = new_lru(2)
        cache.put("a", 1)
        cache.put("b", 2)
        _ := cache.get("a")
        cache.put("c", 3)
        assert_equal(cache.get("b"), .None)
        assert_equal(cache.get("a"), .Some(1))

    use std.testing.{Choices, it_prop_with}

    # One operation on the cache: a get, or a put of a value.
    @derive(Debug)
    enum Op:
        Get(key: string)
        Put(key: string, value: i64)

    fn ops(c: &mut Choices) -> List[Op]:
        c.list(30, fn(c: &mut Choices) -> Op:
            key := c.choose(["a", "b", "c", "d"])
            if c.bool(): .Get(key) else: .Put(key, c.int(0..100i64))
        )

    # The model: keys from least to most recent, with their values.
    fn model_get(model: &mut List[(string, i64)], key: string) -> i64?:
        for i in 0..model.len():
            if model[i]._0 == key:
                entry := model[i]
                model.remove(i)
                model.push(entry)
                return .Some(entry._1)
        .None

    fn model_put(model: &mut List[(string, i64)], key: string, value: i64, capacity: usize) -> void:
        _ := model_get(model, key)
        model.retain(fn(e: &(string, i64)) -> bool: e._0 != key)
        model.push((key, value))
        if model.len() > capacity:
            model.remove(0)

    it_prop_with("agrees with a list model", gen=ops, prop=fn!(history: List[Op]):
        let mut cache = new_lru(2)
        let mut model: List[(string, i64)] = []
        for op in history:
            match op:
                .Get(key) => assert_equal(cache.get(key), model_get(&mut model, key))
                .Put(key, value) =>
                    cache.put(key, value)
                    model_put(&mut model, key, value, 2)
            assert_equal(cache.len(), model.len())
    )
