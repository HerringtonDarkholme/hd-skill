use std.task.{Backoff, apply, map_join, retry}
use std.time.{Clock, ms}

@error
@derive(Eq, Debug)
pub enum QuoteError:
    @error("the quote service is busy")
    Busy
    @error("unknown sku $sku")
    Unknown(sku: string)

## The price service, provided by the caller.
pub trait Quotes:
    fn quote!(&mut self, sku: string) -> Result[i64, QuoteError]

fn quote!(sku: string) -> Result[i64, QuoteError] $ Quotes + Clock:
    policy := retry(Backoff { attempts: 3, initial: 10ms })
    apply!(policy):
        $.use(Quotes).quote!(sku)

## The sum of every sku's price, quoting at most 4 at a time.
pub fn order_total!(skus: List[string]) -> Result[i64, QuoteError] $ Quotes + Clock:
    let total: i64 = 0
    for result in map_join!(skus, 4, quote):
        total += result?
    .Ok(total)

tests:
    use std.time.{ManualClock, Timestamp}

    struct Fake:
        busy_left: usize

    impl Quotes for Fake:
        fn quote!(&mut self, sku: string) -> Result[i64, QuoteError]:
            if sku == "ghost":
                return .Err(.Unknown(sku))
            if self.busy_left > 0:
                self.busy_left -= 1
                return .Err(.Busy)
            .Ok(100)

    it("retries a busy service"):
        fake := box(Fake { busy_left: 2 })
        clock := ManualClock::new(Timestamp::from_unix_milliseconds(0))
        $.with(Quotes=fake, Clock=clock):
            assert_equal(order_total!(["a", "b"]), .Ok(200))

    it("an unknown sku fails the order"):
        fake := box(Fake { busy_left: 0 })
        clock := ManualClock::new(Timestamp::from_unix_milliseconds(0))
        $.with(Quotes=fake, Clock=clock):
            assert_equal(order_total!(["a", "ghost"]), .Err(.Unknown("ghost")))
