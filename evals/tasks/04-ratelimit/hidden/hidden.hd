use pkg.limiter.{Limiter, new_limiter}
use std.time.{Clock, ManualClock, Timestamp, ms, s, sleep}

fn clock() -> *mut ManualClock:
    ManualClock::new(Timestamp::from_unix_milliseconds(0))

it("hidden: allows up to max, then refuses"):
    let mut limiter = new_limiter(3, 1s)
    $.with(Clock=clock()):
        assert_equal([limiter.allow("k"), limiter.allow("k"), limiter.allow("k"), limiter.allow("k")], [true, true, true, false])

it("hidden: keys are independent"):
    let mut limiter = new_limiter(1, 1s)
    $.with(Clock=clock()):
        assert(limiter.allow("a"))
        assert(limiter.allow("b"))
        assert(!limiter.allow("a"))

it("hidden: the window slides"):
    let mut limiter = new_limiter(2, 1000ms)
    $.with(Clock=clock()):
        assert(limiter.allow("k"))          # t = 0
        sleep!(600ms)
        assert(limiter.allow("k"))          # t = 600
        assert(!limiter.allow("k"))         # t = 600, two in window
        sleep!(400ms)
        assert(limiter.allow("k"))          # t = 1000, the t = 0 event left
        assert(!limiter.allow("k"))         # t = 1000, events at 600 and 1000
        sleep!(600ms)
        assert(limiter.allow("k"))          # t = 1600, the 600 event left

it("hidden: a refused event does not extend the wait"):
    let mut limiter = new_limiter(1, 1s)
    $.with(Clock=clock()):
        assert(limiter.allow("k"))
        sleep!(900ms)
        assert(!limiter.allow("k"))
        sleep!(100ms)
        assert(limiter.allow("k"))
