use std.contract.{ensure, require}

pub struct Account:
    cents: i64

pub fn open(cents: i64) -> Account:
    require("an opening balance cannot be negative"):
        cents >= 0
    Account { cents: cents }

impl Account:
    pub fn balance(self) -> i64:
        self.cents

    pub fn deposit(&mut self, cents: i64) -> void:
        require("a deposit must be positive"):
            cents > 0
        self.cents += cents

    pub fn withdraw(&mut self, cents: i64) -> void:
        require("a withdrawal must be positive"):
            cents > 0
        require("a withdrawal cannot exceed the balance"):
            cents <= self.cents
        self.cents -= cents
        ensure("the balance stays non-negative"):
            self.cents >= 0

pub fn transfer(from: &mut Account, to: &mut Account, cents: i64) -> void:
    before := from.balance() + to.balance()
    from.withdraw(cents)
    to.deposit(cents)
    ensure("a transfer keeps the total"):
        from.balance() + to.balance() == before

tests:
    it("moves money between accounts"):
        let mut a = open(100)
        let mut b = open(0)
        transfer(&mut a, &mut b, 40)
        assert_equal((a.balance(), b.balance()), (60, 40))

    it("withdraws the whole balance"):
        let mut a = open(10)
        a.withdraw(10)
        assert_equal(a.balance(), 0)
