# expect: check type-mismatch
trait Mailer:
    fn send(&mut self, to: string) -> void

struct Fake:
    sent: List[string]

impl Mailer for Fake:
    fn send(&mut self, to: string) -> void:
        self.sent.push(to)

fn remind() -> void $ Mailer:
    $.use(Mailer).send("a")

fn run() -> void:
    fake := Fake { sent: [] }
    $.with(Mailer=fake):
        remind()
